<?php

/**
 * @file
 * Hidden helper module for AI test coverage.
 */

/**
 * Implements hook_autoload_info().
 */
function ai_agent_test_autoload_info() {
  return [
    'AITestSupportAdapter' => 'includes/AITestSupportAdapter.php',
  ];
}

/**
 * Implements hook_ai_chat_messages_alter().
 */
function ai_agent_test_ai_chat_messages_alter(array &$messages, array &$context) {
  if (empty($context['test_prepend_system_message'])) {
    return;
  }

  array_unshift($messages, [
    'role' => 'system',
    'content' => 'Injected by ai_agent_test.',
  ]);
}

/**
 * Implements hook_ai_chat_response_alter().
 */
function ai_agent_test_ai_chat_response_alter(&$response, array &$context) {
  if (empty($context['test_suffix_response']) || !is_string($response)) {
    return;
  }

  $response .= ' [post-altered]';
}

/**
 * Implements hook_ai_provider_info().
 */
function ai_agent_test_ai_provider_info() {
  return [
    'agent_test' => [
      'label' => t('Agent Test Provider'),
      'description' => t('Deterministic fake provider for AI suite tests.'),
      'class' => 'AITestSupportAdapter',
    ],
  ];
}

