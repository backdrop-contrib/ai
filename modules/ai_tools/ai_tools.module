<?php

/**
 * @file
 * AI Tools registry module.
 *
 * Provides ai_tools_get_tools() and ai_tools_dispatch() as the
 * canonical API for tool-calling workflows. Built-in tools are organised
 * in includes/ by domain. Any module may extend the registry via
 * hook_ai_tools() and hook_ai_tools_alter().
 *
 * Each tool entry shape:
 * @code
 * 'tool_key' => [
 *   'definition' => [...tool-calling schema...],
 *   'execute'    => 'callback_function_name',
 *   'module'     => 'mymodule',   // informational
 *   'category'   => 'node',       // for grouping in UIs
 * ]
 * @endcode
 */

// -----------------------------------------------------------------------
// Public API
// -----------------------------------------------------------------------

/**
 * Returns all registered tools, merged and altered.
 *
 * @return array
 *   Keyed by tool name.
 */
function ai_tools_get_tools() {
  $tools = module_invoke_all('ai_tools');
  backdrop_alter('ai_tools', $tools);

  $filtered = [];
  foreach ($tools as $key => $tool) {
    $prepared = ai_tools_prepare_tool($key, $tool);
    if (!empty($prepared)) {
      $filtered[$key] = $prepared;
    }
  }

  return $filtered;
}

/**
 * Normalizes and filters a tool definition for the current user.
 */
function ai_tools_prepare_tool($tool_key, array $tool) {
  if (empty($tool['definition']['function']['name'])) {
    return [];
  }

  $tool['definition'] = ai_tools_normalize_definition_schema($tool['definition']);

  // Fail closed: a tool that does not say it only reads is treated as a
  // write, so agents ask for approval before running it. Otherwise a new
  // tool that forgets 'operation' would run unattended, which is exactly
  // what a prompt-injected model would exploit.
  if (empty($tool['operation'])) {
    $warned = &backdrop_static(__FUNCTION__, []);
    if (empty($warned[$tool_key])) {
      $warned[$tool_key] = TRUE;
      watchdog('ai_tools', 'Tool %tool (module %module) does not declare an operation; treating it as a write that requires approval. Declare \'operation\' => \'read\' if it only reads.', [
        '%tool' => $tool_key,
        '%module' => $tool['module'] ?? 'unknown',
      ], WATCHDOG_WARNING);
    }
    $tool['operation'] = 'write';
  }

  $tool += [
    'destructive' => FALSE,
    'permission' => '',
    'requirements' => NULL,
  ];

  if (!ai_tools_requirements_met($tool['requirements'])) {
    return [];
  }

  if (!empty($tool['permission']) && !user_access($tool['permission'])) {
    return [];
  }

  return $tool;
}

/**
 * Normalizes tool JSON schema fragments before sending them to providers.
 */
function ai_tools_normalize_definition_schema(array $definition) {
  if (isset($definition['function']['parameters']) && is_array($definition['function']['parameters'])) {
    $definition['function']['parameters'] = ai_tools_normalize_json_schema($definition['function']['parameters']);
  }

  return $definition;
}

/**
 * Keeps empty JSON Schema object maps encoded as JSON objects, not arrays.
 */
function ai_tools_normalize_json_schema(array $schema) {
  if (isset($schema['properties']) && is_array($schema['properties']) && empty($schema['properties'])) {
    $schema['properties'] = new stdClass();
  }

  foreach ($schema as $key => $value) {
    if ($value instanceof stdClass) {
      continue;
    }
    if (is_array($value)) {
      $schema[$key] = ai_tools_normalize_json_schema($value);
    }
  }

  return $schema;
}

/**
 * Checks whether tool requirements are met.
 */
function ai_tools_requirements_met($requirements) {
  if (empty($requirements)) {
    return TRUE;
  }

  if (is_string($requirements) && function_exists($requirements)) {
    return (bool) call_user_func($requirements);
  }

  if (is_callable($requirements)) {
    return (bool) call_user_func($requirements);
  }

  return FALSE;
}

/**
 * Dispatches a tool call by name and returns a JSON-encoded result string.
 *
 * @param string $name
 *   Tool name matching the 'name' key in its function definition.
 * @param array $arguments
 *   Decoded arguments from the model.
 *
 * @return string
 *   JSON-encoded result suitable for returning as a tool message.
 */
function ai_tools_dispatch($name, array $arguments) {
  $tools = ai_tools_get_tools();
  if (!isset($tools[$name])) {
    return json_encode(['error' => "Unknown tool: $name"]);
  }
  $tool = $tools[$name];
  $callback = $tool['execute'];
  if (!function_exists($callback)) {
    return json_encode(['error' => "Executor not found for tool: $name"]);
  }
  // Check the arguments against the tool's declared JSON schema, so a wrong
  // type is reported to the caller instead of being cast or reaching PHP.
  $schema = $tool['definition']['function']['parameters'] ?? [];
  $error = ai_tools_validate_arguments($arguments, is_array($schema) ? $schema : []);
  if ($error !== NULL) {
    return json_encode(['error' => $error]);
  }
  // Merge any static args declared in the tool definition before calling.
  if (!empty($tool['execute_args']) && is_array($tool['execute_args'])) {
    foreach ($tool['execute_args'] as $key => $value) {
      $arguments['_' . $key] = $value;
    }
  }
  try {
    $result = $callback($arguments);
    return is_string($result) ? $result : json_encode($result);
  }
  catch (\Throwable $e) {
    watchdog('ai_tools', 'Error executing tool @name: @msg', [
      '@name' => $name,
      '@msg' => $e->getMessage(),
    ], WATCHDOG_ERROR);
    // The message goes to the log only: it can contain PHP internals.
    return json_encode(['error' => 'Tool execution error. See the site log for details.']);
  }
}

/**
 * Validates tool arguments against the tool's JSON schema.
 *
 * Checks the top-level properties for 'required', 'type' and 'enum'.
 * Conversions that lose nothing are applied in place (for example "5" to 5,
 * or 3 to "3"), because models often send numbers as strings. Anything else
 * is rejected. Properties the schema does not declare are left alone.
 *
 * @param array $arguments
 *   Decoded arguments. Converted values are written back.
 * @param array $schema
 *   The tool's 'parameters' JSON schema.
 *
 * @return string|null
 *   An error message for the caller, or NULL when the arguments are valid.
 */
function ai_tools_validate_arguments(array &$arguments, array $schema) {
  $properties = isset($schema['properties']) ? (array) $schema['properties'] : [];
  $required = isset($schema['required']) && is_array($schema['required']) ? $schema['required'] : [];

  foreach ($properties as $name => $property) {
    if (!array_key_exists($name, $arguments)) {
      continue;
    }
    // Models often send null for an optional argument they mean to omit.
    if ($arguments[$name] === NULL) {
      unset($arguments[$name]);
      continue;
    }
    $property = (array) $property;
    if (!empty($property['type'])) {
      $value = ai_tools_coerce_argument($arguments[$name], (array) $property['type'], $ok);
      if (!$ok) {
        $types = implode(' or ', (array) $property['type']);
        return "$name: expected $types, got " . ai_tools_json_type($arguments[$name]) . '.';
      }
      $arguments[$name] = $value;
    }
    if (isset($property['enum']) && is_array($property['enum']) && !in_array($arguments[$name], $property['enum'], TRUE)) {
      return "$name: must be one of " . implode(', ', array_map('json_encode', $property['enum'])) . '.';
    }
  }

  foreach ($required as $name) {
    if (!isset($arguments[$name])) {
      return "$name: required.";
    }
  }

  return NULL;
}

/**
 * Converts a value to one of the given JSON schema types without loss.
 *
 * @param mixed $value
 *   The value to convert.
 * @param array $types
 *   Allowed JSON schema type names.
 * @param bool $ok
 *   Set to TRUE when the value matches or converts to one of the types.
 *
 * @return mixed
 *   The converted value, or the original value when $ok is FALSE.
 */
function ai_tools_coerce_argument($value, array $types, &$ok) {
  $ok = TRUE;
  foreach ($types as $type) {
    switch ($type) {
      case 'integer':
        if (is_int($value)) {
          return $value;
        }
        if (is_float($value) && floor($value) == $value && abs($value) <= PHP_INT_MAX) {
          return (int) $value;
        }
        if (is_string($value) && preg_match('/^-?\d+$/', trim($value))) {
          return (int) trim($value);
        }
        break;

      case 'number':
        if (is_int($value) || is_float($value)) {
          return $value;
        }
        if (is_string($value) && is_numeric(trim($value))) {
          return trim($value) + 0;
        }
        break;

      case 'string':
        if (is_string($value)) {
          return $value;
        }
        if (is_int($value) || is_float($value)) {
          return (string) $value;
        }
        break;

      case 'boolean':
        if (is_bool($value)) {
          return $value;
        }
        if ($value === 'true' || $value === 1) {
          return TRUE;
        }
        if ($value === 'false' || $value === 0) {
          return FALSE;
        }
        break;

      case 'array':
        if (is_array($value) && ai_tools_is_list($value)) {
          return $value;
        }
        break;

      case 'object':
        if (is_array($value) && ($value === [] || !ai_tools_is_list($value))) {
          return $value;
        }
        break;

      default:
        // Unknown type keyword: do not block the call.
        return $value;
    }
  }
  $ok = FALSE;
  return $value;
}

/**
 * Returns the JSON type name of a decoded value, for error messages.
 */
function ai_tools_json_type($value) {
  if (is_bool($value)) {
    return 'boolean';
  }
  if (is_int($value)) {
    return 'integer';
  }
  if (is_float($value)) {
    return 'number';
  }
  if (is_string($value)) {
    return 'string';
  }
  if (is_array($value)) {
    return ai_tools_is_list($value) ? 'array' : 'object';
  }
  return 'null';
}

/**
 * Returns TRUE for an array with keys 0..n-1 in order (a JSON array).
 */
function ai_tools_is_list(array $value) {
  return $value === [] || array_keys($value) === range(0, count($value) - 1);
}

/**
 * Implements hook_permission().
 */
function ai_tools_permission() {
  return [
    'use ai image to text tool' => [
      'title' => t('Use the AI image to text tool'),
      'description' => t('Run the ai_image_to_text tool. Each call is a paid request to the site\'s AI provider.'),
    ],
  ];
}

// -----------------------------------------------------------------------
// Explorer UI
// -----------------------------------------------------------------------

/**
 * Implements hook_menu().
 */
function ai_tools_menu() {
  $items['admin/config/ai/ai-explorer/tool-explorer'] = [
    'title'            => 'Tool Explorer',
    'description'      => 'Interactively test tool/function calling against any configured provider and model.',
    'page callback'    => 'backdrop_get_form',
    'page arguments'   => ['ai_tools_explorer_form'],
    'access arguments' => ['administer site configuration'],
    'file'             => 'includes/explorer.inc',
    'type'             => MENU_NORMAL_ITEM,
    'weight'           => -1,
  ];
  // Backward-compatible route alias for documentation and test suites.
  $items['admin/config/ai/tool-explorer'] = [
    'title'            => 'Tool Explorer',
    'page callback'    => 'backdrop_get_form',
    'page arguments'   => ['ai_tools_explorer_form'],
    'access arguments' => ['administer site configuration'],
    'file'             => 'includes/explorer.inc',
    'type'             => MENU_CALLBACK,
  ];
  return $items;
}

// -----------------------------------------------------------------------
// Built-in tools via hook_ai_tools()
// -----------------------------------------------------------------------

/**
 * Implements hook_ai_tools().
 */
function ai_tools_ai_tools() {
  $tools = [];

  module_load_include('inc', 'ai_tools', 'includes/node.tools');
  $tools += ai_tools_node_definitions();

  module_load_include('inc', 'ai_tools', 'includes/site.tools');
  $tools += ai_tools_site_definitions();

  module_load_include('inc', 'ai_tools', 'includes/bee.tools');
  $tools += ai_tools_bee_definitions();

  module_load_include('inc', 'ai_tools', 'includes/taxonomy.tools');
  $tools += ai_tools_taxonomy_definitions();

  module_load_include('inc', 'ai_tools', 'includes/user.tools');
  $tools += ai_tools_user_definitions();

  module_load_include('inc', 'ai_tools', 'includes/content_type.tools');
  $tools += ai_tools_content_type_definitions();

  module_load_include('inc', 'ai_tools', 'includes/field.tools');
  $tools += ai_tools_field_definitions();

  module_load_include('inc', 'ai_tools', 'includes/entity.tools');
  $tools += ai_tools_entity_definitions();

  module_load_include('inc', 'ai_tools', 'includes/media.tools');
  $tools += ai_tools_media_definitions();

  module_load_include('inc', 'ai_tools', 'includes/config.tools');
  $tools += ai_tools_config_definitions();

  module_load_include('inc', 'ai_tools', 'includes/layout.tools');
  $tools += ai_tools_layout_definitions();

  if (module_exists('menu')) {
    module_load_include('inc', 'ai_tools', 'includes/menu.tools');
    $tools += ai_tools_menu_definitions();
  }

  if (module_exists('views')) {
    module_load_include('inc', 'ai_tools', 'includes/views.tools');
    $tools += ai_tools_views_definitions();
  }

  return $tools;
}

/**
 * Implements hook_ai_explorer_explorers_alter().
 *
 * Adds the Tool Explorer to the AI Explorer overview page if user has access.
 */
function ai_tools_ai_explorer_explorers_alter(&$explorers) {
  $tool_item = menu_get_item('admin/config/ai/ai-explorer/tool-explorer');
  if (!empty($tool_item['access'])) {
    $explorers[] = [
      'title' => t('Tool Explorer'),
      'path' => 'admin/config/ai/ai-explorer/tool-explorer',
      'description' => t('Interactively test tool/function calling against configured providers.'),
    ];
  }
}
