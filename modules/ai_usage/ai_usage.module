<?php

/**
 * @file
 * Optional usage ledger for the AI module.
 */

/**
 * Implements hook_config_info().
 */
function ai_usage_config_info() {
  return [
    'ai_usage.settings' => [
      'label' => t('AI Usage settings'),
      'group' => t('AI'),
    ],
  ];
}

/**
 * Implements hook_permission().
 */
function ai_usage_permission() {
  return [
    'view ai usage' => [
      'title' => t('View AI usage reports'),
      'description' => t('View normalized AI operation usage records and summaries.'),
    ],
    'administer ai usage' => [
      'title' => t('Administer AI usage'),
      'description' => t('Configure AI usage recording and retention.'),
      'restrict access' => TRUE,
    ],
  ];
}

/**
 * Return normalized usage budget configuration.
 */
function ai_usage_get_budget_config() {
  $config = config('ai_usage.settings');
  $action = (string) ($config->get('budget_action') ?: 'report');
  return [
    'enabled' => (bool) $config->get('budget_enabled'),
    'action' => in_array($action, ['report', 'block'], TRUE) ? $action : 'report',
    'user_token_limit' => max(0, (int) $config->get('user_token_limit')),
    'user_cost_limit_usd' => max(0, (float) $config->get('user_cost_limit_usd')),
    'anonymous_token_limit' => max(0, (int) $config->get('anonymous_token_limit')),
    'anonymous_cost_limit_usd' => max(0, (float) $config->get('anonymous_cost_limit_usd')),
    'alert_threshold_percent' => min(100, max(1, (int) ($config->get('alert_threshold_percent') ?: 80))),
    'admin_bypass' => $config->get('admin_bypass') !== FALSE,
  ];
}

/**
 * Implements hook_menu().
 */
function ai_usage_menu() {
  $items['admin/config/ai/ai-usage'] = [
    'title' => 'AI Usage',
    'description' => 'Configure AI usage recording and retention.',
    'page callback' => 'backdrop_get_form',
    'page arguments' => ['ai_usage_settings_form'],
    'access arguments' => ['administer ai usage'],
    'type' => MENU_NORMAL_ITEM,
  ];
  $items['admin/reports/ai-usage'] = [
    'title' => 'AI Usage',
    'description' => 'Review normalized AI operation usage.',
    'page callback' => 'ai_usage_report_page',
    'access arguments' => ['view ai usage'],
    'file' => 'ai_usage.pages.inc',
    'type' => MENU_NORMAL_ITEM,
  ];
  $items['admin/reports/ai-usage/records'] = [
    'title' => 'Usage',
    'type' => MENU_DEFAULT_LOCAL_TASK,
    'weight' => -10,
  ];
  $items['admin/reports/ai-usage/pricing'] = [
    'title' => 'Model prices',
    'page callback' => 'ai_usage_pricing_page',
    'access arguments' => ['view ai usage'],
    'file' => 'ai_usage.pages.inc',
    'type' => MENU_LOCAL_TASK,
  ];
  $items['admin/reports/ai-usage/export'] = [
    'title' => 'Export AI Usage',
    'page callback' => 'ai_usage_export_page',
    'access arguments' => ['view ai usage'],
    'file' => 'ai_usage.pages.inc',
    'type' => MENU_CALLBACK,
  ];
  return $items;
}

/**
 * Build the AI Usage settings form.
 */
function ai_usage_settings_form($form, &$form_state) {
  $config = config('ai_usage.settings');
  $form['enabled'] = [
    '#type' => 'checkbox',
    '#title' => t('Record AI usage'),
    '#default_value' => (bool) $config->get('enabled'),
    '#description' => t('Record one normalized row for each provider operation routed through the AI API.'),
  ];
  $form['retention_days'] = [
    '#type' => 'number',
    '#title' => t('Raw record retention'),
    '#default_value' => (int) ($config->get('retention_days') ?: 0),
    '#min' => 0,
    '#field_suffix' => t('days (0 = keep forever)'),
    '#description' => t('Raw records contain operational metadata, not prompts or responses. Reports, alerts, and budgets use this ledger.'),
  ];
  $form['pricing'] = [
    '#type' => 'textarea',
    '#title' => t('Manual model pricing'),
    '#default_value' => ai_usage_pricing_to_text(config_get('ai_usage.settings', 'pricing') ?: []),
    '#rows' => 8,
    '#description' => t('One model per line: provider/model|input USD per token|output USD per token. Example: openai/gpt-4o-mini|0.00000015|0.00000060. Manual rows override prices from the <a href="@catalog">AI model catalog</a>. Values are estimates, not provider invoices.', ['@catalog' => url('admin/config/ai/settings/catalog')]),
  ];

  $form['economy'] = [
    '#type' => 'fieldset',
    '#title' => t('Cheaper model switching'),
    '#collapsible' => TRUE,
    '#collapsed' => !$config->get('economy_default') && !$config->get('economy_modules'),
    '#description' => t('Chat, tool-calling, and decision calls can run on the cheapest priced model from the same provider that has every capability the call needs (text, tools, vision). The requested model must itself be priced, and the cheaper model must be in the same catalog family or a smaller tier of it (gpt to gpt-mini), and not deprecated. A failed call on the cheaper model is retried on the requested model. Restrict which models qualify with the provider capability overrides at <a href="@url">AI capabilities</a>.', ['@url' => url('admin/config/ai/settings/capabilities')]),
  ];
  $form['economy']['economy_default'] = [
    '#type' => 'checkbox',
    '#title' => t('Switch to cheaper models by default'),
    '#default_value' => (bool) $config->get('economy_default'),
  ];
  $module_settings = $config->get('economy_modules') ?: [];
  $form['economy']['economy_modules'] = ['#tree' => TRUE];
  foreach (ai_usage_economy_module_options() as $module => $label) {
    $form['economy']['economy_modules'][$module] = [
      '#type' => 'select',
      '#title' => check_plain($label),
      '#options' => [
        '' => t('Use the default'),
        'on' => t('Switch to cheaper models'),
        'off' => t('Always use the requested model'),
      ],
      '#default_value' => $module_settings[$module] ?? '',
    ];
  }

  $budget = ai_usage_get_budget_config();
  $form['budget'] = [
    '#type' => 'fieldset',
    '#title' => t('Usage budgets and alerts'),
    '#collapsible' => TRUE,
    '#collapsed' => !$budget['enabled'],
    '#description' => t('Budgets use the current ledger period. Token totals may be provider-reported or estimated; cost totals include only records with configured pricing. Hard blocking stops calls after the configured limit has already been reached.'),
  ];
  $form['budget']['budget_enabled'] = [
    '#type' => 'checkbox',
    '#title' => t('Enable usage budgets'),
    '#default_value' => $budget['enabled'],
  ];
  $form['budget']['budget_action'] = [
    '#type' => 'select',
    '#title' => t('Limit behavior'),
    '#options' => [
      'report' => t('Report and alert only'),
      'block' => t('Block calls after the limit is reached'),
    ],
    '#default_value' => $budget['action'],
  ];
  $form['budget']['user_token_limit'] = [
    '#type' => 'number',
    '#title' => t('Authenticated-user token limit'),
    '#default_value' => $budget['user_token_limit'],
    '#min' => 0,
    '#field_suffix' => t('tokens/month (0 = disabled)'),
  ];
  $form['budget']['user_cost_limit_usd'] = [
    '#type' => 'number',
    '#title' => t('Authenticated-user cost limit'),
    '#default_value' => $budget['user_cost_limit_usd'],
    '#min' => 0,
    '#step' => '0.01',
    '#field_suffix' => t('USD/month (0 = disabled)'),
  ];
  $form['budget']['anonymous_token_limit'] = [
    '#type' => 'number',
    '#title' => t('Anonymous token limit'),
    '#default_value' => $budget['anonymous_token_limit'],
    '#min' => 0,
    '#field_suffix' => t('tokens/month (0 = disabled)'),
  ];
  $form['budget']['anonymous_cost_limit_usd'] = [
    '#type' => 'number',
    '#title' => t('Anonymous cost limit'),
    '#default_value' => $budget['anonymous_cost_limit_usd'],
    '#min' => 0,
    '#step' => '0.01',
    '#field_suffix' => t('USD/month (0 = disabled)'),
  ];
  $form['budget']['alert_threshold_percent'] = [
    '#type' => 'number',
    '#title' => t('Alert threshold'),
    '#default_value' => $budget['alert_threshold_percent'],
    '#min' => 1,
    '#max' => 100,
    '#field_suffix' => t('% of any configured limit'),
  ];
  $form['budget']['admin_bypass'] = [
    '#type' => 'checkbox',
    '#title' => t('Allow AI Usage administrators to bypass hard budgets'),
    '#default_value' => $budget['admin_bypass'],
  ];
  $form['actions'] = ['#type' => 'actions'];
  $form['actions']['submit'] = [
    '#type' => 'submit',
    '#value' => t('Save configuration'),
  ];
  return $form;
}

/**
 * Submit handler for ai_usage_settings_form().
 */
function ai_usage_settings_form_submit($form, &$form_state) {
  $pricing = ai_usage_parse_pricing($form_state['values']['pricing']);
  if (!empty($pricing['errors'])) {
    form_set_error('pricing', implode(' ', $pricing['errors']));
    return;
  }
  $config = config('ai_usage.settings');
  $config->set('enabled', !empty($form_state['values']['enabled']));
  $config->set('retention_days', max(0, (int) $form_state['values']['retention_days']));
  $config->set('pricing', $pricing['values']);
  $config->set('economy_default', !empty($form_state['values']['economy_default']));
  $config->set('economy_modules', array_filter((array) ($form_state['values']['economy_modules'] ?? []), function ($value) {
    return in_array($value, ['on', 'off'], TRUE);
  }));
  $config->set('budget_enabled', !empty($form_state['values']['budget_enabled']));
  $config->set('budget_action', $form_state['values']['budget_action'] === 'block' ? 'block' : 'report');
  $config->set('user_token_limit', max(0, (int) $form_state['values']['user_token_limit']));
  $config->set('user_cost_limit_usd', max(0, (float) $form_state['values']['user_cost_limit_usd']));
  $config->set('anonymous_token_limit', max(0, (int) $form_state['values']['anonymous_token_limit']));
  $config->set('anonymous_cost_limit_usd', max(0, (float) $form_state['values']['anonymous_cost_limit_usd']));
  $config->set('alert_threshold_percent', min(100, max(1, (int) $form_state['values']['alert_threshold_percent'])));
  $config->set('admin_bypass', !empty($form_state['values']['admin_bypass']));
  $config->save();
  backdrop_set_message(t('AI Usage settings saved.'));
}

/**
 * Implements hook_cron().
 */
function ai_usage_cron() {
  $retention_days = (int) config_get('ai_usage.settings', 'retention_days');
  if ($retention_days <= 0 || !db_table_exists('ai_usage_records')) {
    return;
  }

  db_delete('ai_usage_records')
    ->condition('timestamp', time() - ($retention_days * 86400), '<')
    ->execute();
}

/**
 * Enabled modules that build on the AI module, keyed by machine name.
 */
function ai_usage_economy_module_options() {
  $options = [];
  foreach (system_get_info('module') as $module => $info) {
    if ($module === 'ai_usage' || strpos($module, 'ai_provider_') === 0) {
      continue;
    }
    $dependencies = array_map(function ($dependency) {
      return strtok(trim($dependency), ' (');
    }, $info['dependencies'] ?? []);
    if ($module === 'ai' || in_array('ai', $dependencies, TRUE)) {
      $options[$module] = $info['name'] ?? $module;
    }
  }
  natcasesort($options);
  return $options;
}

/**
 * Whether cheaper model switching applies to calls from a module.
 *
 * A per-module setting overrides the site default.
 */
function ai_usage_economy_applies($module) {
  $config = config('ai_usage.settings');
  $modules = $config->get('economy_modules') ?: [];
  if (isset($modules[$module]) && in_array($modules[$module], ['on', 'off'], TRUE)) {
    return $modules[$module] === 'on';
  }
  return (bool) $config->get('economy_default');
}

/**
 * Implements hook_ai_operation_model_alter().
 */
function ai_usage_ai_operation_model_alter(&$model, array $info) {
  if (!ai_usage_economy_applies($info['module']) || empty($info['provider'])) {
    return;
  }
  $requested = ai_usage_get_pricing($info['provider'], $model);
  if (!$requested) {
    return;
  }
  $entry = ai_model_catalog_entry($info['provider'], $model);
  if (!$entry || $entry['family'] === '') {
    return;
  }
  $cheaper = ai_usage_cheapest_model($info['provider'], $info['capabilities'], $requested['input'] + $requested['output'], $entry['family']);
  if ($cheaper !== NULL) {
    $model = $cheaper;
  }
}

/**
 * Find the cheapest priced provider model that has every capability.
 *
 * Models are ranked by input plus output price per token. Deprecated models
 * never qualify, and a model qualifies only in the requested family or a
 * smaller tier of it (gpt to gpt-mini, gemini-flash to gemini-flash-lite).
 *
 * @param string $provider
 *   AI provider ID.
 * @param array $capabilities
 *   Capabilities the model must support: text, tool_calling, vision.
 * @param float $below
 *   Only models cheaper than this combined rate qualify.
 * @param string $family
 *   Catalog family of the requested model.
 *
 * @return string|null
 *   Model ID, or NULL when no priced model is cheaper.
 */
function ai_usage_cheapest_model($provider, array $capabilities, $below, $family) {
  $methods = [
    'text' => 'getChatModels',
    'tool_calling' => 'getToolCallingModels',
    'vision' => 'getVisionModels',
  ];
  $candidates = NULL;
  foreach ($capabilities as $capability) {
    if (!isset($methods[$capability])) {
      return NULL;
    }
    $ids = array_keys(ai_get_provider_models_for_method($provider, $methods[$capability]));
    $candidates = $candidates === NULL ? $ids : array_intersect($candidates, $ids);
  }

  $prices = ai_usage_get_provider_pricing($provider);
  $catalog = ai_model_catalog_provider($provider);
  $best = NULL;
  foreach ($candidates ?: [] as $candidate) {
    $pricing = $prices[$candidate] ?? NULL;
    $entry = $catalog[$candidate] ?? NULL;
    if (!$pricing || !$entry || $entry['status'] === 'deprecated') {
      continue;
    }
    if ($entry['family'] !== $family && strpos($entry['family'], $family . '-') !== 0) {
      continue;
    }
    if ($pricing['input'] + $pricing['output'] < $below) {
      $below = $pricing['input'] + $pricing['output'];
      $best = (string) $candidate;
    }
  }
  return $best;
}

/**
 * Return the beginning of the current monthly budget period.
 */
function ai_usage_budget_period_start($timestamp = NULL) {
  $timestamp = $timestamp ?: time();
  return strtotime(date('Y-m-01 00:00:00', $timestamp));
}

/**
 * Return the beginning of the next monthly budget period.
 */
function ai_usage_budget_period_end($timestamp = NULL) {
  $timestamp = $timestamp ?: time();
  return strtotime(date('Y-m-01 00:00:00', strtotime('+1 month', $timestamp)));
}

/**
 * Return the configured token/cost limits for a user.
 */
function ai_usage_get_budget_limits($uid = NULL) {
  global $user;
  $uid = $uid === NULL ? (!empty($user->uid) ? (int) $user->uid : 0) : max(0, (int) $uid);
  $config = ai_usage_get_budget_config();
  if ($uid > 0) {
    return [
      'uid' => $uid,
      'token_limit' => $config['user_token_limit'],
      'cost_limit_usd' => $config['user_cost_limit_usd'],
      'scope' => 'user',
    ];
  }
  return [
    'uid' => 0,
    'token_limit' => $config['anonymous_token_limit'],
    'cost_limit_usd' => $config['anonymous_cost_limit_usd'],
    'scope' => 'anonymous',
  ];
}

/**
 * Return current period totals and budget state for a user.
 */
function ai_usage_get_budget_status($uid = NULL) {
  $limits = ai_usage_get_budget_limits($uid);
  $period_start = ai_usage_budget_period_start();
  $period_end = ai_usage_budget_period_end();
  $current = ['tokens' => 0, 'cost_usd' => 0.0, 'calls' => 0];

  if (db_table_exists('ai_usage_records')) {
    $query = db_select('ai_usage_records', 'u');
    $query->condition('u.uid', $limits['uid']);
    $query->condition('u.timestamp', $period_start, '>=');
    $query->condition('u.timestamp', $period_end, '<');
    $query->addExpression('COUNT(u.id)', 'calls');
    $query->addExpression('COALESCE(SUM(u.total_tokens), 0)', 'tokens');
    $query->addExpression('COALESCE(SUM(u.cost_usd), 0)', 'cost_usd');
    $row = $query->execute()->fetchAssoc();
    if ($row) {
      $current = [
        'calls' => (int) $row['calls'],
        'tokens' => (int) $row['tokens'],
        'cost_usd' => (float) $row['cost_usd'],
      ];
    }
  }

  $token_percent = $limits['token_limit'] > 0 ? ($current['tokens'] / $limits['token_limit']) * 100 : 0;
  $cost_percent = $limits['cost_limit_usd'] > 0 ? ($current['cost_usd'] / $limits['cost_limit_usd']) * 100 : 0;
  $percent = max($token_percent, $cost_percent);
  $config = ai_usage_get_budget_config();
  return [
    'uid' => $limits['uid'],
    'scope' => $limits['scope'],
    'period_start' => $period_start,
    'period_end' => $period_end,
    'current' => $current,
    'limits' => [
      'tokens' => $limits['token_limit'],
      'cost_usd' => $limits['cost_limit_usd'],
    ],
    'percent' => $percent,
    'threshold_percent' => $config['alert_threshold_percent'],
    'threshold_reached' => $percent >= $config['alert_threshold_percent'] && $percent > 0,
    'exceeded' => ($limits['token_limit'] > 0 && $current['tokens'] >= $limits['token_limit']) || ($limits['cost_limit_usd'] > 0 && $current['cost_usd'] >= $limits['cost_limit_usd']),
    'action' => $config['action'],
  ];
}

/**
 * Check whether the current user may start an AI operation.
 *
 * This check is deliberately based on completed ledger rows. It prevents
 * subsequent calls after a hard limit is reached; it does not reserve an
 * unknown provider response before the call begins.
 */
function ai_usage_budget_check($provider = '', $operation = '', $model = '') {
  global $user;
  $config = ai_usage_get_budget_config();
  if (!$config['enabled'] || !config_get('ai_usage.settings', 'enabled') || !db_table_exists('ai_usage_records')) {
    return ['allowed' => TRUE];
  }

  if ($config['admin_bypass'] && !empty($user->uid) && user_access('administer ai usage', $user)) {
    return ['allowed' => TRUE, 'bypassed' => TRUE];
  }

  $status = ai_usage_get_budget_status();
  if ($status['exceeded'] && $config['action'] === 'block') {
    $status['allowed'] = FALSE;
    $status['provider'] = (string) $provider;
    $status['operation'] = (string) $operation;
    $status['model'] = (string) $model;
    $status['message'] = t('The @scope AI usage budget has been reached for this month.', ['@scope' => $status['scope']]);
    watchdog('ai_usage', 'Blocked @operation for @provider because the @scope usage budget was reached.', [
      '@operation' => $operation,
      '@provider' => $provider,
      '@scope' => $status['scope'],
    ], WATCHDOG_WARNING);
    return $status;
  }

  $status['allowed'] = TRUE;
  return $status;
}

/**
 * Emit one threshold alert per user and budget period.
 */
function ai_usage_maybe_alert_budget(array $row) {
  $status = ai_usage_get_budget_status(isset($row['uid']) ? $row['uid'] : 0);
  if (empty($status['threshold_reached']) || !function_exists('state_get') || !function_exists('state_set')) {
    return;
  }

  $key = 'ai_usage_budget_alert:' . $status['uid'] . ':' . $status['period_start'] . ':' . $status['threshold_percent'];
  if (state_get($key, FALSE)) {
    return;
  }
  state_set($key, time());
  watchdog('ai_usage', 'AI usage for @scope UID @uid reached @percent% of its configured budget.', [
    '@scope' => $status['scope'],
    '@uid' => $status['uid'],
    '@percent' => round($status['percent'], 1),
  ], WATCHDOG_WARNING);
  backdrop_alter('ai_usage_budget_alert', $status, $row);
}

/**
 * Persist one normalized AI operation record.
 *
 * This is called by AIApi only when the optional submodule is enabled. The
 * request and response values are used transiently for conservative token
 * estimates and are never persisted.
 *
 * @param array $record
 *   Operation metadata. Supported keys include operation, model, provider,
 *   module, uid, request_id, context_group, status, duration_ms, usage,
 *   request, response, and error_message.
 *
 * @return int|false
 *   Insert ID, or FALSE when recording is disabled or fails.
 */
function ai_usage_record_operation(array $record) {
  if (!config_get('ai_usage.settings', 'enabled') || !db_table_exists('ai_usage_records')) {
    return FALSE;
  }

  $has_provider_usage = !empty($record['usage']) && is_array($record['usage']);
  $usage = $has_provider_usage ? ai_usage_normalize_usage($record['usage']) : [];
  $usage_source = $has_provider_usage ? 'provider' : 'unknown';

  if (!$has_provider_usage) {
    $usage = ai_usage_estimate_operation($record);
    $usage_source = $usage['total_tokens'] > 0 ? 'estimated' : 'unknown';
  }

  $row = [
    'timestamp' => time(),
    'uid' => isset($record['uid']) ? max(0, (int) $record['uid']) : 0,
    'module' => substr((string) ($record['module'] ?? 'ai'), 0, 128),
    'operation' => substr((string) ($record['operation'] ?? 'unknown'), 0, 96),
    'provider' => substr((string) ($record['provider'] ?? ''), 0, 96),
    'model' => substr((string) ($record['model'] ?? ''), 0, 255),
    'requested_model' => substr((string) ($record['requested_model'] ?? ''), 0, 255),
    'request_id' => substr((string) ($record['request_id'] ?? ''), 0, 128),
    'context_group' => substr((string) ($record['context_group'] ?? ''), 0, 128),
    'status' => !empty($record['status']) ? 1 : 0,
    'duration_ms' => max(0, (int) ($record['duration_ms'] ?? 0)),
    'input_tokens' => (int) ($usage['input_tokens'] ?? 0),
    'output_tokens' => (int) ($usage['output_tokens'] ?? 0),
    'cached_tokens' => (int) ($usage['cached_tokens'] ?? 0),
    'cache_write_tokens' => (int) ($usage['cache_write_tokens'] ?? 0),
    'reasoning_tokens' => (int) ($usage['reasoning_tokens'] ?? 0),
    'total_tokens' => (int) ($usage['total_tokens'] ?? 0),
    'input_cost_usd' => 0,
    'output_cost_usd' => 0,
    'cost_usd' => 0,
    'cost_source' => 'unknown',
    'usage_source' => $usage_source,
    'error_message' => !empty($record['error_message']) ? substr((string) $record['error_message'], 0, 1000) : NULL,
  ];

  $pricing = ai_usage_get_pricing($row['provider'], $row['model']);
  if ($pricing) {
    // Cache reads and writes are billed at their own rates when the catalog
    // has them, and at the input rate otherwise.
    $cached = min($row['cached_tokens'], $row['input_tokens']);
    $written = min($row['cache_write_tokens'], $row['input_tokens'] - $cached);
    $row['input_cost_usd'] = ($row['input_tokens'] - $cached - $written) * $pricing['input']
      + $cached * ($pricing['cache_read'] ?? $pricing['input'])
      + $written * ($pricing['cache_write'] ?? $pricing['input']);
    $row['output_cost_usd'] = $row['output_tokens'] * $pricing['output'];
    $row['cost_usd'] = $row['input_cost_usd'] + $row['output_cost_usd'];
    $row['cost_source'] = $pricing['source'];
  }

  backdrop_alter('ai_usage_record', $row, $record);

  try {
    $record_id = db_insert('ai_usage_records')
      ->fields($row)
      ->execute();
    try {
      ai_usage_maybe_alert_budget($row);
    }
    catch (Exception $e) {
      // Alert delivery must not turn a successful ledger insert into a
      // reported persistence failure.
      watchdog('ai_usage', 'Could not emit a usage budget alert: @message', ['@message' => $e->getMessage()], WATCHDOG_WARNING);
    }
    return $record_id;
  }
  catch (Exception $e) {
    watchdog('ai_usage', 'Could not persist AI usage record: @message', ['@message' => $e->getMessage()], WATCHDOG_WARNING);
    return FALSE;
  }
}

/**
 * Normalize common provider usage envelopes into the shared ledger shape.
 */
function ai_usage_normalize_usage(array $usage) {
  $input = ai_usage_first_numeric($usage, ['input_tokens', 'prompt_tokens', 'inputTokenCount', 'promptTokenCount']);
  $output = ai_usage_first_numeric($usage, ['output_tokens', 'completion_tokens', 'candidatesTokenCount']);
  $cached = ai_usage_first_numeric($usage, ['cached_tokens', 'cache_read_input_tokens', 'cachedContentTokenCount']);
  if ($cached <= 0) {
    $cached = ai_usage_first_numeric($usage['prompt_tokens_details'] ?? [], ['cached_tokens'])
      ?: ai_usage_first_numeric($usage['input_tokens_details'] ?? [], ['cached_tokens']);
  }
  $reasoning = ai_usage_first_numeric($usage, ['reasoning_tokens', 'thoughtsTokenCount']);
  if ($reasoning <= 0) {
    $reasoning = ai_usage_first_numeric($usage['completion_tokens_details'] ?? [], ['reasoning_tokens'])
      ?: ai_usage_first_numeric($usage['output_tokens_details'] ?? [], ['reasoning_tokens']);
  }
  $cache_write = ai_usage_first_numeric($usage, ['cache_write_tokens', 'cache_creation_input_tokens']);
  // Anthropic-style envelopes report cache reads and writes beside
  // input_tokens rather than inside it.
  if (array_key_exists('cache_read_input_tokens', $usage) || array_key_exists('cache_creation_input_tokens', $usage)) {
    $input += $cached + $cache_write;
  }
  $total = ai_usage_first_numeric($usage, ['total_tokens', 'totalTokenCount']);

  if ($total <= 0) {
    $total = $input + $output;
  }

  return [
    'input_tokens' => $input,
    'output_tokens' => $output,
    'cached_tokens' => $cached,
    'cache_write_tokens' => $cache_write,
    'reasoning_tokens' => $reasoning,
    'total_tokens' => $total,
  ];
}

/**
 * Estimate usage for operations whose provider response omitted token data.
 */
function ai_usage_estimate_operation(array $record) {
  $operation = strtolower((string) ($record['operation'] ?? ''));
  if (in_array($operation, ['images', 'text_to_speech', 'speech_to_text'], TRUE)) {
    return [
      'input_tokens' => 0,
      'output_tokens' => 0,
      'cached_tokens' => 0,
      'cache_write_tokens' => 0,
      'reasoning_tokens' => 0,
      'total_tokens' => 0,
    ];
  }
  $input_tokens = ai_usage_estimate_tokens(ai_usage_extract_text($record['request'] ?? []));
  $output_tokens = 0;
  $output_operations = ['chat', 'completion', 'describe_image', 'summarize', 'translate', 'generate'];
  foreach ($output_operations as $output_operation) {
    if (strpos($operation, $output_operation) !== FALSE) {
      $output_tokens = ai_usage_estimate_tokens(ai_usage_extract_text($record['response'] ?? []));
      break;
    }
  }

  return [
    'input_tokens' => $input_tokens,
    'output_tokens' => $output_tokens,
    'cached_tokens' => 0,
    'cache_write_tokens' => 0,
    'reasoning_tokens' => 0,
    'total_tokens' => $input_tokens + $output_tokens,
  ];
}

/**
 * Return a conservative token estimate based on roughly four characters each.
 */
function ai_usage_estimate_tokens($text) {
  $text = trim((string) $text);
  return $text === '' ? 0 : (int) ceil(strlen($text) / 4);
}

/**
 * Extract textual content without traversing binary/image/vector payloads.
 */
function ai_usage_extract_text($value, $depth = 0) {
  if ($depth > 8) {
    return '';
  }
  if (is_string($value)) {
    return $value;
  }
  if (!is_array($value)) {
    return '';
  }

  $parts = [];
  foreach ($value as $key => $item) {
    if (in_array((string) $key, ['raw', 'data', 'embedding', 'image_url', 'url', 'file', 'audio'], TRUE)) {
      continue;
    }
    $text = ai_usage_extract_text($item, $depth + 1);
    if ($text !== '') {
      $parts[] = $text;
    }
  }
  return implode("\n", $parts);
}

/**
 * Return the first non-negative numeric usage value from a provider envelope.
 */
function ai_usage_first_numeric(array $values, array $keys) {
  foreach ($keys as $key) {
    if (isset($values[$key]) && is_numeric($values[$key])) {
      return max(0, (int) $values[$key]);
    }
  }
  return 0;
}

/**
 * Parse the administrator's model pricing textarea.
 */
function ai_usage_parse_pricing($text) {
  $values = [];
  $errors = [];
  foreach (preg_split('/\r\n|\r|\n/', (string) $text) as $line_number => $line) {
    $line = trim($line);
    if ($line === '' || strpos($line, '#') === 0) {
      continue;
    }
    $parts = array_map('trim', explode('|', $line));
    if (count($parts) !== 3 || $parts[0] === '' || !is_numeric($parts[1]) || !is_numeric($parts[2])) {
      $errors[] = t('Pricing line @line is invalid. Use provider/model|input rate|output rate.', ['@line' => $line_number + 1]);
      continue;
    }
    $input = (float) $parts[1];
    $output = (float) $parts[2];
    if ($input < 0 || $output < 0) {
      $errors[] = t('Pricing line @line cannot contain negative rates.', ['@line' => $line_number + 1]);
      continue;
    }
    $values[$parts[0]] = ['input' => $input, 'output' => $output];
  }
  return ['values' => $values, 'errors' => $errors];
}

/**
 * Format pricing config for the settings textarea.
 */
function ai_usage_pricing_to_text(array $pricing) {
  $lines = [];
  foreach ($pricing as $model => $rates) {
    if (!is_array($rates)) {
      continue;
    }
    $lines[] = $model . '|' . ($rates['input'] ?? 0) . '|' . ($rates['output'] ?? 0);
  }
  return implode("\n", $lines);
}

/**
 * Find pricing for a provider/model pair.
 *
 * @return array|null
 *   Keys input, output, cache_read, and cache_write (USD per token; the
 *   cache rates are NULL when unknown) and source ("manual" or "synced"), or NULL when the model
 *   has no price.
 */
function ai_usage_get_pricing($provider, $model) {
  $pricing = ai_usage_get_provider_pricing($provider);
  return $pricing[$model] ?? NULL;
}

/**
 * All prices for one provider, keyed by model ID.
 *
 * Prices from the AI model catalog are overlaid by manual rows: first rows keyed by bare
 * model ID, then rows keyed by provider/model.
 */
function ai_usage_get_provider_pricing($provider) {
  $provider = (string) $provider;

  $prices = [];
  foreach (ai_model_catalog_provider($provider) as $model => $entry) {
    if ($entry['input_usd'] !== NULL) {
      $prices[$model] = [
        'input' => $entry['input_usd'],
        'output' => (float) $entry['output_usd'],
        'cache_read' => $entry['cache_read_usd'],
        'cache_write' => $entry['cache_write_usd'],
        'source' => 'synced',
      ];
    }
  }

  $manual = config_get('ai_usage.settings', 'pricing') ?: [];
  $specific = [];
  foreach ($manual as $key => $rates) {
    if (!is_array($rates)) {
      continue;
    }
    $rates = [
      'input' => max(0, (float) ($rates['input'] ?? 0)),
      'output' => max(0, (float) ($rates['output'] ?? 0)),
      'cache_read' => NULL,
      'cache_write' => NULL,
      'source' => 'manual',
    ];
    if (strpos($key, $provider . '/') === 0) {
      $specific[substr($key, strlen($provider) + 1)] = $rates;
    }
    else {
      $prices[$key] = $rates;
    }
  }
  return $specific + $prices;
}
