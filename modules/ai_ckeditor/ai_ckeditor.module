<?php

/**
 * Implements hook_permission().
 */
function ai_ckeditor_permission() {
  return [
    'use ai ckeditor' => [
      'title' => t('Use AI CKEditor'),
      'description' => t('Allows users to access and use the AI CKEditor integration.'),
    ],
  ];
}

/**
 * Implements hook_menu().
 */
function ai_ckeditor_menu() {
  $items = [];

  $items['api/ai-ckeditor/completion'] = [
    'title' => 'AI CKEditor Generate Completion',
    'page callback' => 'ai_ckeditor_generate_completion',
    'access callback' => 'user_access',
    'access arguments' => ['use ai ckeditor'],
    'type' => MENU_CALLBACK,
    'delivery callback' => 'backdrop_json_output',
  ];

  return $items;
}

/**
 * Implements hook_library_info().
 */
function ai_ckeditor_library_info() {
  $module_path = backdrop_get_path('module', 'ai_ckeditor');
  $info = system_get_info('module', 'ai_ckeditor');

  $libraries['ai_ckeditor.ai-plugin'] = [
    'title' => 'AI CKEditor Plugin',
    'version' => $info['version'],
    'js' => [$module_path . '/js/ai.js' => []],
    'css' => [$module_path . '/css/ai.css' => []],
    'dependencies' => [['ckeditor5', 'ckeditor5']],
  ];

  return $libraries;
}

/**
 * Implements hook_ckeditor5_plugins().
 */
function ai_ckeditor_ckeditor5_plugins() {
  $plugins['ai.AI'] = [
    'library' => ['ai_ckeditor', 'ai_ckeditor.ai-plugin'],
    'buttons' => [
      'AI' => [
        'label' => t('AI'),
        'image' => backdrop_get_path('module', 'ai_ckeditor') . '/icons/ai.svg',
      ],
    ],
    'enabled_callback' => 'ai_ckeditor_plugin_enabled_callback',
  ];

  return $plugins;
}

/**
 * Callback to enable the plugin based on filter format.
 */
function ai_ckeditor_plugin_enabled_callback($format, $plugin_name) {
  $settings = !empty($format->editor_settings['ai']) && is_array($format->editor_settings['ai'])
    ? $format->editor_settings['ai']
    : [];
  return !empty($settings['enabled']) || (!empty($format->filters['ai']) && !empty($format->filters['ai']->status));
}

/**
 * Return the configured chat model, normalized to a provider-qualified ID.
 */
function _ai_ckeditor_resolve_model($preferred = NULL) {
  $models = ai_get_all_chat_models();
  $preferred = $preferred ?: config_get('ai.settings', 'default_text_model');
  if (!is_string($preferred) || (!empty($preferred) && strpos($preferred, '/') === FALSE)) {
    $preferred = config_get('ai.settings', 'default_text_model');
  }
  $model = ai_default_model($models, $preferred);

  // Do not route an unqualified legacy value through whichever provider happens
  // to be first in ai.settings.providers.
  if (empty($model) || strpos($model, '/') === FALSE) {
    return '';
  }

  return $model;
}

/**
 * Return the prompt templates saved for a text operation.
 */
function _ai_ckeditor_get_prompts(array $saved = []) {
  $prompts = [];
  foreach (_ai_ckeditor_default_prompts() as $key => $definition) {
    $prompts[$key] = isset($saved[$key]) && is_string($saved[$key])
      ? $saved[$key]
      : $definition['prompt'];
  }
  return $prompts;
}

/**
 * Restrict generated HTML to the elements supported by the editor tools.
 */
function _ai_ckeditor_safe_markup($text) {
  return filter_xss((string) $text, [
    'p', 'br', 'strong', 'em', 'ul', 'ol', 'li',
    'h1', 'h2', 'h3', 'h4', 'h5', 'h6', 'blockquote', 'code', 'pre',
  ]);
}

/**
 * Implements hook_form_alter().
 * Adds AI integration settings to CKEditor configuration forms.
 */
function ai_ckeditor_form_alter(&$form, &$form_state, $form_id) {
  if ($form_id === 'ckeditor5_settings_form' || $form_id === 'filter_admin_format_form') {
    // Load available models from all enabled providers.
    // Do not require a single AI API key; providers may vary.
    $format_name = !empty($form['format']['#default_value']) ? $form['format']['#default_value'] : 'filtered_html';
    $format_config = config('filter.format.' . $format_name);
    $ai_settings = $format_config->get('editor_settings.ai') ?? [];

    $form['editor_settings']['plugins']['ai'] = [
      '#type' => 'fieldset',
      '#title' => t('AI Integration'),
      '#description' => t('Settings for AI integration in CKEditor.'),
      '#group' => 'plugins',
      '#open' => TRUE,
      '#parents' => ['editor_settings', 'ai'],
      '#attributes' => ['class' => ['ckeditor5-plugin-ai']],
    ];

    $form['editor_settings']['plugins']['ai']['enabled'] = [
      '#type' => 'checkbox',
      '#title' => t('Enable AI Integration'),
      '#default_value' => !empty($ai_settings['enabled']),
    ];

    // Model selector: use ai module helper for all chat models from all providers.
    $model_options = ai_get_all_chat_models();

    $default_model = _ai_ckeditor_resolve_model($ai_settings['model'] ?? NULL);

    $form['editor_settings']['plugins']['ai']['model'] = [
      '#type' => 'select',
      '#title' => t('Default model'),
      '#options' => $model_options,
      '#default_value' => $default_model,
      '#description' => t('Select which model to use to analyze text. See the <a href="@url" target="_blank">model overview</a> for details about each model.', ['@url' => 'https://platform.ai.com/docs/models']),
    ];

    $form['editor_settings']['plugins']['ai']['temperature'] = [
      '#type' => 'number',
      '#title' => t('Temperature'),
      '#min' => 0,
      '#max' => 2,
      '#step' => 0.1,
      '#default_value' => $ai_settings['temperature'] ?? '0.2',
      '#description' => t('What sampling temperature to use, between 0 and 2. Higher values make the output more random, while lower values make it more focused.'),
    ];

    $form['editor_settings']['plugins']['ai']['max_tokens'] = [
      '#type' => 'number',
      '#title' => t('Max tokens'),
      '#min' => 128,
      '#step' => 1,
      '#default_value' => $ai_settings['max_tokens'] ?? '128',
      '#description' => t('The maximum number of tokens to generate. The token count of your prompt plus max_tokens cannot exceed the model\'s context length.'),
    ];

    $saved_prompts = $ai_settings['prompts'] ?? [];
    $prompt_defaults = _ai_ckeditor_default_prompts();

    $form['editor_settings']['plugins']['ai']['prompts'] = [
      '#type'        => 'fieldset',
      '#title'       => t('Prompt templates'),
      '#description' => t('Customize the prompts sent to the AI for each operation. Placeholders are replaced at runtime — see each field\'s description for available tokens.'),
      '#collapsible' => TRUE,
      '#collapsed'   => TRUE,
      '#tree'        => TRUE,
    ];

    foreach ($prompt_defaults as $key => $default) {
      $form['editor_settings']['plugins']['ai']['prompts'][$key] = [
        '#type'          => 'textarea',
        '#title'         => $default['label'],
        '#default_value' => isset($saved_prompts[$key]) ? $saved_prompts[$key] : $default['prompt'],
        '#rows'          => 3,
        '#description'   => $default['description'],
      ];
    }
  }
}

/**
 * Returns default prompt templates for each CKEditor operation.
 *
 * @return array
 *   Keyed by operation ID. Each entry has 'label', 'prompt', 'description'.
 */
function _ai_ckeditor_default_prompts() {
  return [
    'tone' => [
      'label'       => t('Adjust tone'),
      'prompt'      => "Please rewrite the following text with a tone that is {{tone}} while preserving the original meaning:\n{{selectedText}}",
      'description' => t('Available placeholders: <code>{{selectedText}}</code> (selected editor content), <code>{{tone}}</code> (adjective entered by the user).'),
    ],
    'summarize' => [
      'label'       => t('Summarize'),
      'prompt'      => "Create a concise summary of the following text, keeping the key points intact:\n{{selectedText}}",
      'description' => t('Available placeholder: <code>{{selectedText}}</code> (selected editor content).'),
    ],
    'translate' => [
      'label'       => t('Translate'),
      'prompt'      => "Please accurately translate the following text into {{language}}:\n{{selectedText}}",
      'description' => t('Available placeholders: <code>{{selectedText}}</code> (selected editor content), <code>{{language}}</code> (language entered by the user).'),
    ],
    'reformat' => [
      'label'       => t('Reformat / correct HTML'),
      'prompt'      => "Please fix this text to be marked up with semantic HTML using only lists, headers, or paragraph tags: {{selectedText}}",
      'description' => t('Available placeholder: <code>{{selectedText}}</code> (selected editor content).'),
    ],
  ];
}

/**
 * Implements hook_ckeditor5_config_alter().
 * Modifies the CKEditor configuration to include AI settings.
 */
function ai_ckeditor_ckeditor5_config_alter(array &$config, $format) {
  if (!empty($config['pluginList']) && in_array('ai.AI', $config['pluginList'], TRUE)) {
    $format_config = config('filter.format.' . $format->format);
  $ai_settings = $format_config->get('editor_settings.ai') ?? [];
    $model = _ai_ckeditor_resolve_model($ai_settings['model'] ?? NULL);

    $config['ai'] = [
      'enabled' => $ai_settings['enabled'] ?? FALSE,
      'model' => $model,
      'format' => $format->format,
      'temperature' => $ai_settings['temperature'] ?? 0.2,
      'max_tokens' => $ai_settings['max_tokens'] ?? 128,
      'prompts' => _ai_ckeditor_get_prompts($ai_settings['prompts'] ?? []),
      'token' => backdrop_get_token('ai-ckeditor/completion'),
    ];
  }
}

/**
 * Helper function to communicate with AI.
 */
function ai_ckeditor_generate_text($prompt, $settings) {
  $model = $settings['model'] ?? '';

  // Use the centralized helper to get the API for this model
  $stripped_model = '';
  $ai_api = ai_get_api_for_model($model, $stripped_model);

  if (!$ai_api) {
    watchdog('ai_ckeditor', 'Unable to load API for model @model', ['@model' => $model], WATCHDOG_ERROR);
    return '';
  }

  // Use the chat endpoint (messages) which works for modern chat-capable models,
  // including OpenRouter-backed chat models. Build a simple user message.
  $messages = [
    ['role' => 'user', 'content' => $prompt],
  ];

  try {
    // Use the stripped model identifier (without provider prefix)
    $response = $ai_api->chat($stripped_model, $messages, floatval($settings['temperature'] ?? 0.2), (int) ($settings['max_tokens'] ?? 128), FALSE, ['operation' => 'content_tools']);
  }
  catch (\Throwable $e) {
    watchdog('ai_ckeditor', 'AI chat error: @error', ['@error' => $e->getMessage()], WATCHDOG_ERROR);
    return '';
  }

  // Try to handle various response shapes. If chat returns a string, use it.
  if (is_string($response) && !empty($response)) {
    return _ai_ckeditor_safe_markup($response);
  }

  // If returned as array with choices, try to extract text/content.
  if (is_array($response)) {
    if (!empty($response['choices'][0]['message']['content'])) {
      return _ai_ckeditor_safe_markup($response['choices'][0]['message']['content']);
    }
    if (!empty($response['choices'][0]['text'])) {
      return _ai_ckeditor_safe_markup($response['choices'][0]['text']);
    }
  }

  return '';
}

/**
 * Rate-limiting function to prevent excessive API usage.
 */
function ai_ckeditor_check_rate_limit($user_id) {
  $lock_name = 'ai_ckeditor_rate_limit:' . (int) $user_id;
  if (!lock_acquire($lock_name, 5.0)) {
    return FALSE;
  }

  $cache_key = 'api_request_count_' . $user_id;
  try {
    $cache = cache_get($cache_key, 'cache_api_rate_limit');
    $count = $cache ? (int) $cache->data : 0;

    if ($count >= 100) {
      return FALSE;
    }

    cache_set($cache_key, $count + 1, 'cache_api_rate_limit', REQUEST_TIME + 3600);
    return TRUE;
  }
  finally {
    lock_release($lock_name);
  }
}

/**
 * Handles API request for generating AI completion.
 */
function ai_ckeditor_generate_completion() {
  global $user;

  $raw_input = file_get_contents('php://input');
  $input = json_decode($raw_input, TRUE);
  if (!is_array($input) || json_last_error() !== JSON_ERROR_NONE) {
    return backdrop_json_output(['error' => 'Invalid JSON input.']);
  }

  if (empty($input['token']) || !backdrop_valid_token($input['token'], 'ai-ckeditor/completion')) {
    watchdog('ai_ckeditor', 'Rejected completion request with an invalid token.', [], WATCHDOG_WARNING);
    return backdrop_json_output(['error' => 'Invalid request token.']);
  }

  $prompt = isset($input['prompt']) && is_string($input['prompt']) ? trim($input['prompt']) : '';
  if ($prompt === '') {
    return backdrop_json_output(['error' => 'No prompt received or prompt is empty.']);
  }

  if (strlen($prompt) > 12000) {
    return backdrop_json_output(['error' => 'Prompt is too long.']);
  }

  if (!ai_ckeditor_check_rate_limit($user->uid)) {
    watchdog('ai_ckeditor', 'Rate limit exceeded for user ID: @uid', ['@uid' => $user->uid], WATCHDOG_WARNING);
    return backdrop_json_output(['error' => 'Rate limit exceeded. Please try again later.']);
  }

  $format_id = isset($input['format']) && is_string($input['format']) ? $input['format'] : '';
  $format = $format_id !== '' ? filter_format_load($format_id) : FALSE;
  if (!$format || !filter_access($format)) {
    return backdrop_json_output(['error' => 'The selected text format is not available.']);
  }

  $format_config = config('filter.format.' . $format->format);
  $ai_settings = $format_config->get('editor_settings.ai') ?? [];
  if (empty($ai_settings['enabled'])) {
    return backdrop_json_output(['error' => 'AI is not enabled for this text format.']);
  }

  $model = _ai_ckeditor_resolve_model($ai_settings['model'] ?? NULL);
  if ($model === '') {
    watchdog('ai_ckeditor', 'No valid chat model is configured for format @format.', ['@format' => $format->format], WATCHDOG_ERROR);
    return backdrop_json_output(['error' => 'No valid AI chat model is configured.']);
  }

  $settings = [
    'model' => $model,
    'temperature' => max(0, min(2, (float) ($ai_settings['temperature'] ?? 0.2))),
    'max_tokens' => max(128, min(8192, (int) ($ai_settings['max_tokens'] ?? 128))),
  ];
  $response_text = ai_ckeditor_generate_text($prompt, $settings);
  if ($response_text === '') {
    return backdrop_json_output(['error' => 'No response received from AI.']);
  }

  return backdrop_json_output(['responseText' => $response_text]);
}
