<?php

/**
 * @file
 * Admin UI and CLI tools for migrating legacy openai_* modules to ai_* modules.
 */

/**
 * Implements hook_menu().
 */
function ai_upgrade_menu() {
  $items = [];

  $items['admin/config/ai/upgrade'] = [
    'title' => 'AI Upgrade',
    'description' => 'Enable AI replacement modules and migrate from legacy modules.',
    'page callback' => 'backdrop_get_form',
    'page arguments' => ['ai_upgrade_form'],
    'access arguments' => ['administer modules'],
    'file' => 'ai_upgrade.pages.inc',
    'type' => MENU_NORMAL_ITEM,
  ];

  $items['admin/config/ai/upgrade/install-missing'] = [
    'title' => 'Install missing AI modules',
    'page callback' => 'backdrop_get_form',
    'page arguments' => ['ai_upgrade_install_missing_form'],
    'access arguments' => ['administer modules'],
    'file' => 'ai_upgrade.pages.inc',
    'type' => MENU_CALLBACK,
  ];

  return $items;
}

/**
 * Return actionable AI upgrade candidates keyed by replacement module name.
 */
function ai_upgrade_get_candidates() {
  module_load_install('ai_upgrade');

  $candidates = [];
  foreach (ai_upgrade_registry() as $module => $info) {
    $legacy_enabled = [];
    foreach ($info['legacy_modules'] as $legacy_module) {
      if (module_exists($legacy_module)) {
        $legacy_enabled[] = $legacy_module;
      }
    }

    $deprecated = !empty($info['deprecated']);
    $actual_module = !empty($info['module']) ? $info['module'] : $module;
    // Deprecated entries have no replacement module — treat as never enabled.
    $replacement_enabled = !$deprecated && module_exists($actual_module);
    if (empty($legacy_enabled) && !$replacement_enabled) {
      continue;
    }

    $candidates[$module] = [
      'module' => $actual_module,
      'label' => $info['label'],
      'legacy_modules' => $info['legacy_modules'],
      'legacy_enabled' => $legacy_enabled,
      'replacement_enabled' => $replacement_enabled,
      'deprecated' => $deprecated,
    ];
  }

  return $candidates;
}

/**
 * Resolve selected modules to a full replacement set for enabled legacy state.
 */
function ai_upgrade_resolve_modules(array $modules) {
  $registry = ai_upgrade_registry();
  $selected = [];
  $legacy_to_modules = [];

  foreach ($registry as $module => $info) {
    foreach ($info['legacy_modules'] as $legacy_module) {
      $legacy_to_modules[$legacy_module][] = $module;
    }
  }

  foreach ($modules as $module) {
    if (isset($registry[$module])) {
      $selected[$module] = $module;
    }
  }

  $changed = TRUE;
  while ($changed) {
    $changed = FALSE;
    $legacy_modules = [];

    foreach ($selected as $module) {
      foreach ($registry[$module]['legacy_modules'] as $legacy_module) {
        if (module_exists($legacy_module)) {
          $legacy_modules[$legacy_module] = $legacy_module;
        }
      }
    }

    foreach ($legacy_modules as $legacy_module) {
      if (!empty($legacy_to_modules[$legacy_module])) {
        foreach ($legacy_to_modules[$legacy_module] as $replacement_module) {
          if (!isset($selected[$replacement_module])) {
            $selected[$replacement_module] = $replacement_module;
            $changed = TRUE;
          }
        }
      }
    }

    $dependents = ai_upgrade_find_enabled_dependents(array_values($legacy_modules), array_values($legacy_modules));
    foreach ($dependents as $dependent_modules) {
      foreach ($dependent_modules as $dependent_module) {
        if (!empty($legacy_to_modules[$dependent_module])) {
          foreach ($legacy_to_modules[$dependent_module] as $replacement_module) {
            if (!isset($selected[$replacement_module])) {
              $selected[$replacement_module] = $replacement_module;
              $changed = TRUE;
            }
          }
        }
      }
    }
  }

  return array_values($selected);
}

/**
 * Find enabled modules that still depend on legacy modules slated for removal.
 */
function ai_upgrade_find_enabled_dependents(array $legacy_modules, array $ignore_modules = []) {
  $dependents = [];
  $module_data = system_rebuild_module_data();
  $ignore = array_fill_keys(array_merge($legacy_modules, $ignore_modules), TRUE);

  foreach ($legacy_modules as $legacy_module) {
    if (empty($module_data[$legacy_module])) {
      continue;
    }
    foreach (array_keys($module_data[$legacy_module]->required_by) as $dependent) {
      if (!empty($ignore[$dependent])) {
        continue;
      }
      if (!empty($module_data[$dependent]->status)) {
        $dependents[$legacy_module][] = $dependent;
      }
    }
  }

  return $dependents;
}

/**
 * Map of replacement modules that ship bundled inside a parent project.
 *
 * Key: replacement machine name. Value: parent project name that ships it.
 * Modules not listed here are assumed to be standalone projects.
 */
function ai_upgrade_bundle_map() {
  return [
    'ai_alt' => 'ai',
    'ai_alt_bulk' => 'ai',
    'ai_alt_tools' => 'ai',
    'ai_ckeditor' => 'ai',
    'ai_content' => 'ai',
    'ai_dblog' => 'ai',
    'ai_devel' => 'ai',
    'ai_explorer' => 'ai',
    'ai_guardrails' => 'ai',
    'ai_mcp' => 'ai',
    'ai_moderation' => 'ai',
    'ai_privacy' => 'ai',
    'ai_rate_limit' => 'ai',
    'ai_site_context' => 'ai',
    'ai_tools' => 'ai',
    'ai_webform_tools' => 'ai',
    'ai_search_explorer' => 'ai_search',
    'ai_search_header' => 'ai_search',
    'ai_search_search_block' => 'ai_search',
    'ai_search_search_block_log' => 'ai_search',
    'ai_search_simple_chatbot' => 'ai_search',
  ];
}

/**
 * Identify replacement modules that are not present on disk.
 *
 * Returns a list of [registry_key => actual_module] for entries whose
 * replacement module has no .info on disk. Deprecated entries (no replacement)
 * are skipped.
 */
function ai_upgrade_find_missing_modules(array $modules) {
  $registry = ai_upgrade_registry();
  $module_data = system_rebuild_module_data();
  $missing = [];

  foreach ($modules as $module) {
    if (empty($registry[$module])) {
      continue;
    }
    $info = $registry[$module];
    if (!empty($info['deprecated'])) {
      continue;
    }
    $actual_module = !empty($info['module']) ? $info['module'] : $module;
    if (empty($module_data[$actual_module])) {
      $missing[$module] = $actual_module;
    }
  }

  return $missing;
}

/**
 * Return the project name that provides a replacement module.
 *
 * Most standalone replacement modules use their machine name as their
 * project name. Bundled modules must instead be installed with their parent
 * project, such as the AI project itself.
 */
function ai_upgrade_project_name($module) {
  $registry = ai_upgrade_registry();
  if (empty($registry[$module])) {
    return $module;
  }

  $info = $registry[$module];
  $actual_module = !empty($info['module']) ? $info['module'] : $module;
  $bundles = ai_upgrade_bundle_map();
  if (!empty($bundles[$actual_module])) {
    return $bundles[$actual_module];
  }

  return !empty($info['project']) ? $info['project'] : $actual_module;
}

/**
 * Return missing replacement projects, keyed by project machine name.
 */
function ai_upgrade_get_missing_projects(array $modules) {
  $missing_modules = ai_upgrade_find_missing_modules($modules);
  $projects = [];
  foreach ($missing_modules as $module => $actual_module) {
    $projects[ai_upgrade_project_name($module)] = [
      'module' => $actual_module,
      'registry_key' => $module,
    ];
  }
  return $projects;
}

/**
 * Download missing replacement projects into the modules directory.
 *
 * Each project's newest release from its backdropcms.org release history is
 * downloaded, verified and copied into place with the installer's helpers.
 * Dependencies the downloaded modules need that are not on disk are
 * downloaded the same way. Nothing is enabled; the upgrade form handles that
 * once modules are on disk.
 *
 * @return array
 *   Download results with 'downloaded' and 'errors' lists.
 */
function ai_upgrade_download_missing_projects(array $modules) {
  $result = ['downloaded' => [], 'errors' => []];
  $projects = ai_upgrade_get_missing_projects($modules);
  if (empty($projects)) {
    return $result;
  }

  if (!module_exists('installer')) {
    $result['errors'][] = t('Backdrop Installer is not enabled. Install missing AI modules manually, then rerun the upgrade.');
    return $result;
  }

  module_load_include('inc', 'installer', 'installer.manager');

  // Work through a queue so dependencies found after each download are
  // fetched as well.
  $queue = array_keys($projects);
  $attempted = [];
  while ($queue) {
    $project_name = array_shift($queue);
    if (isset($attempted[$project_name])) {
      continue;
    }
    $attempted[$project_name] = TRUE;

    $release = ai_upgrade_get_project_release($project_name);
    if (!$release) {
      $result['errors'][] = t('@project has no published release on backdropcms.org. Install it manually.', [
        '@project' => $project_name,
      ]);
      continue;
    }

    $download = installer_manager_download_project(file_create_url($release['download_link']), TRUE);
    if (empty($download['success'])) {
      $result['errors'][] = t('@project @version could not be downloaded: @message', [
        '@project' => $project_name,
        '@version' => $release['version'],
        '@message' => strip_tags($download['message']),
      ]);
      continue;
    }

    $result['downloaded'][] = t('@project @version (@stability)', [
      '@project' => $project_name,
      '@version' => $release['version'],
      '@stability' => ai_upgrade_release_stability($release),
    ]);

    foreach (ai_upgrade_find_missing_dependencies($project_name) as $dependency) {
      $queue[] = $dependency;
    }
  }

  return $result;
}

/**
 * Return projects needed by a downloaded project's modules but not on disk.
 *
 * Like Backdrop's installer, a dependency is assumed to be its own project,
 * except for modules known to ship inside a parent project.
 *
 * @return string[]
 *   Project machine names.
 */
function ai_upgrade_find_missing_dependencies($project_name) {
  // The module list was cached before the download; rescan the disk.
  backdrop_static_reset('system_rebuild_module_data');
  $module_data = system_rebuild_module_data();
  $bundles = ai_upgrade_bundle_map();
  $projects = [];
  foreach ($module_data as $module) {
    if (strpos('/' . dirname($module->uri) . '/', '/' . $project_name . '/') === FALSE) {
      continue;
    }
    foreach ($module->requires as $requires) {
      $dependency = $requires['name'];
      if (empty($module_data[$dependency])) {
        $dependency_project = !empty($bundles[$dependency]) ? $bundles[$dependency] : $dependency;
        $projects[$dependency_project] = $dependency_project;
      }
    }
  }
  return array_values($projects);
}

/**
 * Return the release that would be downloaded for a project.
 *
 * Releases are newest first. The newest stable release is preferred; a
 * project with no stable release gets its newest alpha, beta, RC or
 * development release instead.
 *
 * @return array|NULL
 *   The release from the project's backdropcms.org release history, or NULL
 *   if the project has no published release.
 */
function ai_upgrade_get_project_release($project_name) {
  $releases = &backdrop_static(__FUNCTION__, []);
  if (!array_key_exists($project_name, $releases)) {
    module_load_include('inc', 'installer', 'installer.browser');
    $release_data = installer_browser_get_project_release_data([
      'name' => $project_name,
      'type' => 'module',
      'includes' => [],
    ]);
    $releases[$project_name] = NULL;
    if (!empty($release_data['releases'])) {
      $releases[$project_name] = reset($release_data['releases']);
      foreach ($release_data['releases'] as $release) {
        if (empty($release['version_extra'])) {
          $releases[$project_name] = $release;
          break;
        }
      }
    }
  }
  return $releases[$project_name];
}

/**
 * Describe a release's stability: stable, alpha, beta, RC or development.
 */
function ai_upgrade_release_stability(array $release) {
  $extra = !empty($release['version_extra']) ? strtolower($release['version_extra']) : '';
  if ($extra === '') {
    return t('stable');
  }
  if (strpos($extra, 'dev') === 0) {
    return t('development');
  }
  if (strpos($extra, 'alpha') === 0) {
    return t('alpha');
  }
  if (strpos($extra, 'beta') === 0) {
    return t('beta');
  }
  if (strpos($extra, 'rc') === 0) {
    return t('release candidate');
  }
  return $extra;
}

/**
 * Format missing replacement modules for error output.
 */
function ai_upgrade_format_missing_modules(array $missing) {
  $registry = ai_upgrade_registry();
  $bundles = ai_upgrade_bundle_map();
  $module_data = system_rebuild_module_data();
  $lines = [];
  foreach ($missing as $module => $actual_module) {
    $label = !empty($registry[$module]['label']) ? $registry[$module]['label'] : $module;
    if (!empty($bundles[$actual_module])) {
      $parent = $bundles[$actual_module];
      $parent_present = !empty($module_data[$parent]);
      if ($parent_present) {
        $lines[] = t('@label: @actual_module ships as a submodule of @parent (already on disk). It should appear in the modules list — rebuild the cache if not.', [
          '@label' => $label,
          '@actual_module' => $actual_module,
          '@parent' => $parent,
        ]);
      }
      else {
        $lines[] = t('@label: @actual_module ships as a submodule of the @parent project — download and install @parent.', [
          '@label' => $label,
          '@actual_module' => $actual_module,
          '@parent' => $parent,
        ]);
      }
    }
    else {
      $lines[] = t('@label: download and place @actual_module in your modules directory (standalone project).', [
        '@label' => $label,
        '@actual_module' => $actual_module,
      ]);
    }
  }
  return implode("\n", $lines);
}

/**
 * Format enabled dependent-module blockers for error output.
 */
function ai_upgrade_format_dependent_blockers(array $dependents) {
  $messages = [];
  foreach ($dependents as $legacy_module => $modules) {
    sort($modules);
    $messages[] = t('@legacy is still required by enabled module(s): @modules', [
      '@legacy' => $legacy_module,
      '@modules' => implode(', ', $modules),
    ]);
  }
  return implode("\n", $messages);
}

/**
 * Find resolved upgrade modules that cannot run, with the reason for each.
 *
 * A module is skipped when its replacement or a dependency is not on disk,
 * when it shares an enabled legacy module with a skipped module, or when an
 * enabled module outside the upgrade still requires one of its legacy
 * modules. Skipping repeats until stable so a skipped module never has its
 * legacy modules disabled by another module in the set.
 *
 * @return array
 *   Reasons keyed by registry module name.
 */
function ai_upgrade_find_skipped_modules(array $modules) {
  $registry = ai_upgrade_registry();
  $module_data = system_rebuild_module_data();
  $skipped = [];

  foreach (ai_upgrade_find_missing_modules($modules) as $module => $actual_module) {
    $skipped[$module] = ai_upgrade_format_missing_modules([$module => $actual_module]);
  }
  foreach ($modules as $module) {
    $actual_module = !empty($registry[$module]['module']) ? $registry[$module]['module'] : $module;
    if (isset($skipped[$module]) || !empty($registry[$module]['deprecated']) || empty($module_data[$actual_module])) {
      continue;
    }
    $absent = [];
    foreach ($module_data[$actual_module]->requires as $requires) {
      if (empty($module_data[$requires['name']])) {
        $absent[] = $requires['name'];
      }
    }
    if ($absent) {
      $skipped[$module] = t('@module requires @dependencies, which are not on disk.', [
        '@module' => $actual_module,
        '@dependencies' => implode(', ', $absent),
      ]);
    }
  }

  $legacy_owners = [];
  foreach ($modules as $module) {
    foreach ($registry[$module]['legacy_modules'] as $legacy_module) {
      if (module_exists($legacy_module)) {
        $legacy_owners[$legacy_module][] = $module;
      }
    }
  }

  do {
    $changed = FALSE;
    foreach ($legacy_owners as $legacy_module => $owners) {
      $skipped_owners = array_intersect($owners, array_keys($skipped));
      if (!$skipped_owners) {
        continue;
      }
      foreach (array_diff($owners, $skipped_owners) as $module) {
        $skipped[$module] = t('@legacy is shared with @module, which cannot be upgraded yet.', [
          '@legacy' => $legacy_module,
          '@module' => reset($skipped_owners),
        ]);
        $changed = TRUE;
      }
    }

    $active_legacy = [];
    foreach ($legacy_owners as $legacy_module => $owners) {
      if (!array_intersect($owners, array_keys($skipped))) {
        $active_legacy[] = $legacy_module;
      }
    }
    $blockers = ai_upgrade_find_enabled_dependents($active_legacy);
    foreach ($blockers as $legacy_module => $dependents) {
      foreach ($legacy_owners[$legacy_module] as $module) {
        $skipped[$module] = ai_upgrade_format_dependent_blockers([$legacy_module => $dependents]);
        $changed = TRUE;
      }
    }
  } while ($changed);

  return $skipped;
}

/**
 * Enable and/or migrate selected AI replacement modules.
 *
 * Modules that cannot run are reported with a 'skipped' reason instead of
 * aborting the rest of the upgrade.
 */
function ai_upgrade_execute(array $modules) {
  $plan = ai_upgrade_plan($modules);
  $results = $plan['skipped'];
  foreach ($plan['run'] as $module) {
    $result = ai_upgrade_execute_module($module);
    if ($result) {
      $results[$module] = $result;
    }
  }
  return $results;
}

/**
 * Work out which selected modules will run, in registry order.
 *
 * @return array
 *   An array with 'run' (module names to execute, in order) and 'skipped'
 *   (result rows with a 'skipped' reason, keyed by module).
 */
function ai_upgrade_plan(array $modules) {
  module_load_install('ai_upgrade');
  $modules = ai_upgrade_resolve_modules($modules);

  $registry = ai_upgrade_registry();
  $ordered_modules = [];
  foreach (array_keys($registry) as $module) {
    if (in_array($module, $modules, TRUE)) {
      $ordered_modules[] = $module;
    }
  }

  $skipped = ai_upgrade_find_skipped_modules($ordered_modules);
  $plan = ['run' => [], 'skipped' => []];
  foreach ($skipped as $module => $reason) {
    $plan['skipped'][$module] = [
      'module' => $module,
      'label' => $registry[$module]['label'],
      'skipped' => $reason,
    ];
  }
  foreach ($ordered_modules as $module) {
    if (!isset($skipped[$module])) {
      $plan['run'][] = $module;
    }
  }

  return $plan;
}

/**
 * Enable and/or migrate one AI replacement module.
 *
 * Each call is self-contained so the upgrade can run one module per request.
 *
 * @return array|NULL
 *   The module's result row, or NULL if it has no registry entry.
 */
function ai_upgrade_execute_module($module) {
  module_load_install('ai_upgrade');
  $info = ai_upgrade_module_info($module);
  if (empty($info)) {
    return NULL;
  }

  $actual_module = !empty($info['module']) ? $info['module'] : $module;
  $deprecated = !empty($info['deprecated']);

  ai_upgrade_runtime_active(TRUE);
  try {
    if (!$deprecated && !module_exists($actual_module)) {
      module_enable([$actual_module]);
      // Never migrate or disable legacy modules for a replacement that did
      // not enable.
      if (!module_exists($actual_module)) {
        return [
          'module' => $actual_module,
          'label' => $info['label'],
          'skipped' => t('@module could not be enabled.', ['@module' => $actual_module]),
        ];
      }
    }

    // Enabling a replacement can invoke its hook_install() and perform the
    // migration while the runtime flag is active. Reuse that result rather
    // than migrating the same config and tables a second time.
    $result = ai_upgrade_install_result($module);
    if ($result === NULL) {
      $result = ai_upgrade_module_install($module);
    }
    if ($deprecated && empty($result['disabled'])) {
      $result['disabled'] = ai_upgrade_disable_legacy($info['legacy_modules'], FALSE);
    }
  }
  finally {
    ai_upgrade_runtime_active(FALSE);
    entity_info_cache_clear();
    module_implements_reset();
  }

  if (empty($result)) {
    $result = ['migrated' => 0, 'disabled' => [], 'tables' => [], 'permissions' => 0, 'blocks' => 0];
  }

  return [
    'module' => $actual_module,
    'label' => $info['label'],
    'enabled' => $deprecated ? FALSE : module_exists($actual_module),
    'migrated' => $result['migrated'],
    'disabled' => $result['disabled'],
    'tables' => $result['tables'],
    'permissions' => isset($result['permissions']) ? $result['permissions'] : 0,
    'blocks' => isset($result['blocks']) ? $result['blocks'] : 0,
  ];
}
