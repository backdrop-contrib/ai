<?php

/**
 * @file
 * Entity moderation hooks and public API.
 */

/**
 * Implements hook_config_info().
 */
function ai_moderation_config_info() {
  return [
    'ai_moderation.settings' => [
      'label' => t('AI Moderation settings'),
      'group' => t('AI'),
    ],
  ];
}

/**
 * Implements hook_permission().
 */
function ai_moderation_permission() {
  return [
    'access ai moderation' => [
      'title' => t('Administer AI Moderation'),
      'description' => t('Configure moderation profiles and review moderation verdicts.'),
      'restrict access' => TRUE,
    ],
    'bypass ai moderation' => [
      'title' => t('Bypass AI moderation enforcement'),
      'description' => t('Submit or publish targeted content without automatic AI moderation enforcement.'),
      'restrict access' => TRUE,
    ],
  ];
}

/**
 * Check whether the current account may bypass automatic enforcement.
 */
function ai_moderation_user_can_bypass() {
  return user_access('bypass ai moderation');
}

/**
 * Return the shared editorial severity score boundaries.
 */
function ai_moderation_level_thresholds() {
  return ['clear' => 9, 'review' => 20, 'smoldering' => 70];
}

/**
 * Return display ranges derived from the editorial severity boundaries.
 */
function ai_moderation_level_ranges() {
  $thresholds = ai_moderation_level_thresholds();
  return [
    'clear' => '0–' . $thresholds['clear'],
    'review' => ($thresholds['clear'] + 1) . '–' . $thresholds['review'],
    'smoldering' => ($thresholds['review'] + 1) . '–' . $thresholds['smoldering'],
    'dumpster_fire' => ($thresholds['smoldering'] + 1) . '–100',
  ];
}

