/**
 * Return upgrade info for a specific AI replacement module.
 */
function ai_upgrade_module_info($module) {
  $registry = ai_upgrade_registry();
  return isset($registry[$module]) ? $registry[$module] : NULL;
}

/**
 * Store and retrieve install-time upgrade results for the current request.
 */
function ai_upgrade_install_result($module, $result = NULL, $reset = FALSE) {
  $results = &backdrop_static(__FUNCTION__, []);

  if ($reset) {
    unset($results[$module]);
    return NULL;
  }

  if (func_num_args() >= 2) {
    $results[$module] = $result;
  }

  return isset($results[$module]) ? $results[$module] : NULL;
}

/**
 * Track whether an explicit AI upgrade run is currently in progress.
 */
function ai_upgrade_runtime_active($set = NULL) {
  $active = &backdrop_static(__FUNCTION__, FALSE);

  if (func_num_args() > 0) {
    $active = (bool) $set;
  }

  return $active;
}

/**
 * Migrate config and data for one AI module from its legacy module(s).
 *
 * Copying config and table rows is non-destructive, so it runs on every
 * install. Destructive steps (forced config overwrites, table renames and
 * disabling legacy modules) only run during an explicit AI upgrade run, so the
 * operator controls when the cutover happens.
 */
function ai_upgrade_module_install($module) {
  $info = ai_upgrade_module_info($module);
  if (empty($info)) {
    $result = ['migrated' => 0, 'disabled' => [], 'tables' => [], 'permissions' => 0, 'blocks' => 0];
    ai_upgrade_install_result($module, $result);
    return $result;
  }

  $explicit = ai_upgrade_runtime_active();
  $owner = !empty($info['module']) ? $info['module'] : $module;
  $migrated = 0;

  if (!empty($info['config_map'])) {
    foreach ($info['config_map'] as $old_name => $new_name) {
      $transform = NULL;
      $force = FALSE;
      if (is_array($new_name)) {
        $transform = !empty($new_name['transform']) ? $new_name['transform'] : NULL;
        $force = $explicit && !empty($new_name['force']);
        $new_name = $new_name['new'];
      }
      if (_ai_migrate_config_object($old_name, $new_name, $transform, $force, $owner)) {
        $migrated++;
      }
    }
  }

  if (!empty($info['config_prefix_map'])) {
    foreach ($info['config_prefix_map'] as $mapping) {
      $migrated += _ai_migrate_prefixed_config($mapping['old'], $mapping['new'], $owner);
    }
  }

  $tables = [];
  if (!empty($info['table_map'])) {
    foreach ($info['table_map'] as $mapping) {
      $tables[] = ai_upgrade_migrate_table($mapping['old'], $mapping['new'], $mapping['primary_keys'], $explicit);
    }
  }

  $disabled = $explicit ? ai_upgrade_disable_legacy($info['legacy_modules'], FALSE) : [];

  $permissions = !empty($info['permission_map']) ? ai_upgrade_migrate_permissions($info['permission_map']) : 0;
  $blocks = ai_upgrade_migrate_entry_blocks($module);

  $result = [
    'migrated' => $migrated,
    'disabled' => $disabled,
    'tables' => $tables,
    'permissions' => $permissions,
    'blocks' => $blocks,
  ];
  ai_upgrade_install_result($module, $result);
  return $result;
}

/**
 * Grant each role the new permission for every legacy permission it holds.
 *
 * Additive only: legacy permissions are left in place.
 *
 * @return int
 *   Number of role/permission grants added.
 */
function ai_upgrade_migrate_permissions(array $permission_map) {
  $granted = 0;
  foreach (array_keys(user_roles()) as $role_name) {
    $role = user_role_load($role_name);
    if (!$role || !is_array($role->permissions)) {
      continue;
    }
    $add = [];
    foreach ($permission_map as $old => $new) {
      if (in_array($old, $role->permissions, TRUE) && !in_array($new, $role->permissions, TRUE)) {
        $add[$new] = $new;
      }
    }
    if ($add) {
      user_role_grant_permissions($role_name, array_values($add));
      $granted += count($add);
    }
  }
  return $granted;
}

/**
 * Swap legacy block placements for one registry entry, when safe.
 *
 * Only runs once the replacement is enabled and every legacy module is
 * disabled, so a placement never points at a block that cannot render.
 *
 * @return int
 *   Number of placements swapped.
 */
function ai_upgrade_migrate_entry_blocks($key) {
  $info = ai_upgrade_module_info($key);
  if (empty($info['block_map']) || !empty($info['deprecated'])) {
    return 0;
  }
  $replacement = !empty($info['module']) ? $info['module'] : $key;
  if (!module_exists($replacement)) {
    return 0;
  }
  foreach ($info['legacy_modules'] as $legacy) {
    if (module_exists($legacy)) {
      return 0;
    }
  }
  return ai_upgrade_migrate_blocks($info['block_map']);
}

/**
 * Point layout block placements at their replacement blocks.
 *
 * Covers layouts and mini layouts. Placement position, style and generic
 * settings are kept; module-specific settings can be converted by a
 * 'settings_callback'.
 *
 * @param array $block_map
 *   Keyed by legacy plugin ("module:delta"); values hold 'plugin' and an
 *   optional 'settings_callback' ($settings) -> $settings.
 *
 * @return int
 *   Number of placements swapped.
 */
function ai_upgrade_migrate_blocks(array $block_map) {
  $swapped = 0;
  foreach (config_get_names_with_prefix('layout.') as $name) {
    $config = config($name);
    $content = $config->get('content');
    if (!is_array($content)) {
      continue;
    }
    $changed = FALSE;
    foreach ($content as $uuid => $block) {
      $plugin = isset($block['plugin']) ? $block['plugin'] : '';
      if (!isset($block_map[$plugin])) {
        continue;
      }
      $mapping = $block_map[$plugin];
      list($module, $delta) = explode(':', $mapping['plugin'], 2);
      $block['plugin'] = $mapping['plugin'];
      $block['data']['module'] = $module;
      $block['data']['delta'] = $delta;
      if (!empty($mapping['settings_callback'])) {
        $settings = isset($block['data']['settings']) && is_array($block['data']['settings']) ? $block['data']['settings'] : [];
        $block['data']['settings'] = call_user_func($mapping['settings_callback'], $settings);
      }
      $content[$uuid] = $block;
      $changed = TRUE;
      $swapped++;
    }
    if ($changed) {
      $config->set('content', $content);
      $config->save();
    }
  }
  if ($swapped && function_exists('layout_reset_caches')) {
    layout_reset_caches();
  }
  return $swapped;
}

/**
 * Convert the legacy global chat block config into per-placement settings.
 */
function _ai_upgrade_assistant_block_settings(array $settings) {
  $legacy = config_get('openai_assistant.settings', 'block_config');
  if (!is_array($legacy) || empty($legacy)) {
    $legacy = config_get('ai_assistants.settings', 'block_config');
  }
  $legacy = is_array($legacy) ? $legacy : [];

  $uuid = new Uuid();
  $settings['block_settings'] = isset($settings['block_settings']) && is_array($settings['block_settings']) ? $settings['block_settings'] : [];
  $settings['block_settings']['ai_assistants_block'] = [
    'custom_title' => isset($legacy['custom_title']) ? (string) $legacy['custom_title'] : '',
    'assistant_id' => isset($legacy['assistant_id']) ? (string) $legacy['assistant_id'] : '',
    'instance_id' => $uuid->generate(),
  ];
  return $settings;
}

/**
 * Copy data from an old table into its replacement, or rename when possible.
 *
 * The old table is never dropped. Pass FALSE for $allow_rename while the
 * legacy module may still be using the old table.
 */
function ai_upgrade_migrate_table($old_table, $new_table, array $primary_keys, $allow_rename = TRUE) {
  $result = [
    'old' => $old_table,
    'new' => $new_table,
    'renamed' => FALSE,
    'copied' => 0,
    'skipped' => 0,
  ];

  if (!db_table_exists($old_table)) {
    return $result;
  }

  if (!db_table_exists($new_table)) {
    if (!$allow_rename) {
      return $result;
    }
    db_rename_table($old_table, $new_table);
    $result['renamed'] = TRUE;
    return $result;
  }

  $query = db_select($old_table, 't');
  $query->fields('t');
  $rows = $query->execute();
  $target_fields = [];

  foreach ($rows as $row) {
    $record = (array) $row;
    foreach ($primary_keys as $key) {
      if (!array_key_exists($key, $record)) {
        $result['skipped']++;
        continue 2;
      }
    }
    $exists_query = db_select($new_table, 'n');
    $exists_query->addExpression('1');
    foreach ($primary_keys as $key) {
      $exists_query->condition($key, $record[$key]);
    }
    $exists = (bool) $exists_query->execute()->fetchField();

    if ($exists) {
      $result['skipped']++;
      continue;
    }

    // Legacy tables can contain columns that were removed or renamed in the
    // replacement schema. Keep the shared columns and let the new schema
    // supply defaults for fields introduced by the replacement module.
    $fields = [];
    foreach ($record as $field => $value) {
      if (!array_key_exists($field, $target_fields)) {
        $target_fields[$field] = db_field_exists($new_table, $field);
      }
      if ($target_fields[$field]) {
        $fields[$field] = $value;
      }
    }
    if (empty($fields)) {
      $result['skipped']++;
      continue;
    }

    db_insert($new_table)
      ->fields($fields)
      ->execute();
    $result['copied']++;
  }

  return $result;
}

/**
 * Build a short human-readable summary for migrated tables.
 */
function ai_upgrade_table_results_summary(array $tables) {
  $parts = [];

  foreach ($tables as $table) {
    if (!empty($table['renamed'])) {
      $parts[] = t('@old -> @new renamed', [
        '@old' => $table['old'],
        '@new' => $table['new'],
      ]);
      continue;
    }

    if (!empty($table['copied']) || !empty($table['skipped'])) {
      $parts[] = t('@old -> @new copied @copied, skipped @skipped', [
        '@old' => $table['old'],
        '@new' => $table['new'],
        '@copied' => $table['copied'],
        '@skipped' => $table['skipped'],
      ]);
    }
  }

  return empty($parts) ? t('none') : implode('; ', $parts);
}

/**
 * Build a module-specific install-time warning about legacy modules.
 */
function ai_upgrade_module_requirements($phase, $module) {
  if ($phase !== 'install') {
    return [];
  }

  $info = ai_upgrade_module_info($module);
  if (empty($info)) {
    return [];
  }

  return ai_upgrade_install_warning($info['legacy_modules'], $info['label']);
}

/**
 * Copy a legacy config object into its AI namespace replacement.
 */
function _ai_migrate_config_object($old_name, $new_name, $transform_callback = NULL, $force = FALSE, $owner = NULL) {
  $old = config($old_name);
  $data = $old->get();
  if (empty($data) || !is_array($data)) {
    return FALSE;
  }

  $new = config($new_name);
  $new_data = $new->get();
  $pristine = FALSE;
  if (!empty($new_data) && !$force) {
    // Backdrop writes a module's default config before hook_install() runs,
    // so an untouched shipped default must not block the migration.
    if (!_ai_upgrade_config_is_shipped_default($owner, $new_name, $new_data)) {
      return FALSE;
    }
    $pristine = TRUE;
  }

  if ($transform_callback) {
    $data = call_user_func($transform_callback, $data, $old_name, $new_name);
  }

  if (empty($data) || !is_array($data)) {
    return FALSE;
  }

  if ($pristine) {
    // Legacy values win; shipped defaults fill keys the legacy config lacks.
    $data += $new_data;
  }

  $data['_config_name'] = $new_name;
  $new->setData($data);
  $new->save();

  return TRUE;
}

/**
 * Whether $data still matches the default config $owner ships for $name.
 */
function _ai_upgrade_config_is_shipped_default($owner, $name, array $data) {
  // Views embed their own machine name, so a copied legacy view would be
  // broken; never replace a shipped view.
  if (empty($owner) || strpos($name, 'views.view.') === 0) {
    return FALSE;
  }
  $path = backdrop_get_path('module', $owner);
  if (empty($path)) {
    return FALSE;
  }
  $storage = new ConfigFileStorage($path . '/config');
  if (!$storage->exists($name)) {
    return FALSE;
  }
  $default = $storage->read($name);
  if (!is_array($default)) {
    return FALSE;
  }
  unset($default['_config_name'], $data['_config_name']);
  return $default == $data;
}

/**
 * Copy prefixed legacy configs into AI namespace replacements.
 */
function _ai_migrate_prefixed_config($old_prefix, $new_prefix, $owner = NULL) {
  $migrated = 0;

  foreach (config_get_names_with_prefix($old_prefix) as $old_name) {
    $suffix = substr($old_name, strlen($old_prefix));
    $new_name = $new_prefix . $suffix;
    if (_ai_migrate_config_object($old_name, $new_name, NULL, FALSE, $owner)) {
      $migrated++;
    }
  }

  return $migrated;
}

/**
 * Normalize old openai.settings data for ai.settings.
 */
function _ai_transform_settings_config(array $data, $old_name, $new_name) {
  unset($old_name);

  // Remap the top-level api_key from openai.settings into the structured
  // providers array that ai.settings expects. Only populate if not already set
  // so a manually configured ai.settings is never overwritten.
  if (!empty($data['api_key']) && empty($data['providers']['openai']['api_key'])) {
    $data['providers']['openai']['api_key'] = $data['api_key'];
  }
  if (!isset($data['providers']['openai']['enabled'])) {
    $data['providers']['openai']['enabled'] = 1;
  }
  // api_org is not used by ai_provider_openai; drop it from ai.settings.
  unset($data['api_key'], $data['api_org']);

  $existing = config($new_name)->get();
  if (!empty($existing) && is_array($existing)) {
    // Merge existing ai.settings on top so manual configuration wins.
    $data = backdrop_array_merge_deep($data, $existing);
  }

  if (isset($data['openai_log_enabled']) && !isset($data['ai_log_enabled'])) {
    $data['ai_log_enabled'] = $data['openai_log_enabled'];
  }
  if (isset($data['openai_log_max_age']) && !isset($data['ai_log_max_age'])) {
    $data['ai_log_max_age'] = $data['openai_log_max_age'];
  }

  unset($data['openai_log_enabled'], $data['openai_log_max_age']);

  return $data;
}

/**
 * Qualify a legacy model ID with its implied provider.
 *
 * The legacy suite routed unprefixed model IDs to OpenAI; the AI suite routes
 * them to the first enabled provider, so they must become "openai/<model>".
 */
function _ai_upgrade_qualify_model($model) {
  if (!is_string($model) || $model === '' || strpos($model, '/') !== FALSE) {
    return $model;
  }
  return 'openai/' . $model;
}

/**
 * Qualify the 'model' of every item in $items; returns how many changed.
 */
function _ai_upgrade_qualify_item_models(array &$items) {
  $changed = 0;
  foreach ($items as &$item) {
    if (is_array($item) && isset($item['model'])) {
      $qualified = _ai_upgrade_qualify_model($item['model']);
      if ($qualified !== $item['model']) {
        $item['model'] = $qualified;
        $changed++;
      }
    }
  }
  return $changed;
}

/**
 * Normalize openai_agent.settings data for ai_agents.settings.
 */
function _ai_transform_agent_config(array $data, $old_name, $new_name) {
  unset($old_name);
  if (!empty($data['agents']) && is_array($data['agents'])) {
    _ai_upgrade_qualify_item_models($data['agents']);
  }
  // Keep agents that ship with (or were added to) ai_agents but that the
  // legacy config lacks.
  $existing = config($new_name)->get('agents');
  if (is_array($existing)) {
    $data['agents'] = (isset($data['agents']) && is_array($data['agents']) ? $data['agents'] : []) + $existing;
  }
  return $data;
}

/**
 * Normalize openai_assistant.settings data for ai_assistants.settings.
 */
function _ai_transform_assistant_config(array $data, $old_name, $new_name) {
  unset($old_name, $new_name);
  if (!empty($data['assistants']) && is_array($data['assistants'])) {
    _ai_upgrade_qualify_item_models($data['assistants']);
  }
  return $data;
}

/**
 * Migrate suite config from legacy openai_* names to ai_* names.
 */
function _ai_migrate_legacy_suite_config() {
  $exact_mappings = [
    'openai.settings' => ['new' => 'ai.settings', 'transform' => '_ai_transform_settings_config', 'force' => TRUE],
    'openai_agent.settings' => ['new' => 'ai_agents.settings', 'transform' => '_ai_transform_agent_config'],
    'openai_assistant.settings' => ['new' => 'ai_assistants.settings', 'transform' => '_ai_transform_assistant_config'],
    'openai_agent_content_audit.settings' => ['new' => 'ai_content_audit.settings'],
    'openai_agent_maintenance.settings' => ['new' => 'ai_agents_maintenance.settings'],
    'openai_alt.settings' => ['new' => 'ai_alt.settings'],
    'openai_content.settings' => ['new' => 'ai_content.settings'],
    'openai_content_lifecycle.settings' => ['new' => 'ai_content_lifecycle.settings'],
    'openai_dblog.settings' => ['new' => 'ai_dblog.settings'],
    'openai_guardrails.settings' => ['new' => 'ai_guardrails.settings'],
    'openai_metatag.settings' => ['new' => 'ai_metatag.settings'],
    'openai_openrouter.settings' => ['new' => 'ai_provider_openrouter.settings'],
    'openai_litellm.settings' => ['new' => 'ai_provider_litellm.settings'],
    'openai_aws_bedrock.settings' => ['new' => 'ai_provider_aws_bedrock.settings'],
    'openai_privacy.settings' => ['new' => 'ai_privacy.settings'],
    'openai_rate_limit.settings' => ['new' => 'ai_rate_limit.settings'],
    'openai_related_content.settings' => ['new' => 'ai_related_content.settings'],
    'views.view.openai_related_content' => ['new' => 'views.view.ai_related_content'],
    'views.view.openai_alt_bulk' => ['new' => 'views.view.ai_alt_bulk'],
    'openai_seo_advisor.settings' => ['new' => 'ai_seo_advisor.settings'],
    'openai_site_context.settings' => ['new' => 'ai_site_context.settings'],
  ];

  $migrated = 0;

  foreach ($exact_mappings as $old_name => $mapping) {
    $transform = !empty($mapping['transform']) ? $mapping['transform'] : NULL;
    $force = !empty($mapping['force']);
    if (_ai_migrate_config_object($old_name, $mapping['new'], $transform, $force)) {
      $migrated++;
    }
  }

  $migrated += _ai_migrate_prefixed_config('openai_field_automator.', 'ai_field_automator.');
  $migrated += _ai_migrate_prefixed_config('openai_seo_advisor.report_type.', 'ai_seo_advisor.report_type.');

  return $migrated;
}

/**
 * Disable legacy OpenAI modules that have AI replacements.
 *
 * Only disables a legacy module if its AI replacement is currently enabled,
 * so sites still running only the openai_* suite are not affected.
 */
function _ai_disable_legacy_suite_modules() {
  $to_disable = [];
  foreach (ai_upgrade_registry() as $registry_key => $info) {
    if (!empty($info['deprecated'])) {
      continue;
    }
    $replacement = !empty($info['module']) ? $info['module'] : $registry_key;
    if (!module_exists($replacement)) {
      continue;
    }
    foreach ($info['legacy_modules'] as $legacy) {
      if (module_exists($legacy)) {
        $to_disable[$legacy] = $legacy;
      }
    }
  }

  if (!empty($to_disable)) {
    module_disable($to_disable);
  }
}
