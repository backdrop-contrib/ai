  public function testAssistantSendStoresThread() {
    $result = ai_assistant_send('assistant_test', 'Hello assistant');

    $this->assertEqual('ok', $result['status'], 'Assistant call completed.');
    $this->assertTrue(!empty($result['thread_id']), 'Thread id returned.');
    $this->assertEqual('Final answer: {"echo":"Hello assistant"}', $result['answer'], 'Assistant returned deterministic answer.');

    $thread = ai_assistant_get_thread($result['thread_id']);
    $this->assertTrue(!empty($thread['messages']), 'Thread messages stored.');
    $this->assertEqual('user', $thread['messages'][0]['role'], 'First stored message is user input.');
    $this->assertEqual('assistant', $thread['messages'][1]['role'], 'Second stored message is assistant reply.');
  }

  public function testAssistantDirectModeUsesChat() {
    $result = ai_assistant_send('assistant_direct', 'Hello direct');

    $this->assertEqual('ok', $result['status'], 'Direct assistant completed.');
    $this->assertEqual('chat', $result['answer'], 'Direct assistant used the chat path.');
  }

  public function testAssistantMultiAgentModeCombinesAnswers() {
    $result = ai_assistant_send('assistant_multi', 'Hello multi');

    $this->assertEqual('ok', $result['status'], 'Multi-agent assistant completed.');
    $this->assertTrue(strpos($result['answer'], 'Assistant Test Agent') !== FALSE, 'First agent label included.');
    $this->assertTrue(strpos($result['answer'], 'Assistant Test Agent Two') !== FALSE, 'Second agent label included.');
    $this->assertTrue(substr_count($result['answer'], 'Final answer: {"echo":"Hello multi"}') === 2, 'Each agent returned a deterministic answer.');
  }

  public function testAssistantRouterContentTypeFieldsWithTaxonomyReference() {
    $assistant = [
      'route_mode' => 'router',
      'agent_ids' => ['taxonomy_agent', 'content_type_agent', 'field_agent'],
    ];
    $message = 'Create a This is Neat! content type with a long text field named Whoa! Also add an entity reference field that uses the Languages taxonomy.';

    $route_agent_ids = ai_assistant_route_agent_ids($assistant, $message);

    $this->assertEqual(['content_type_agent', 'field_agent'], $route_agent_ids, 'Router treats taxonomy in an entity-reference field request as field context.');
  }

  public function testAssistantRouterSiteBuilderOrchestratesContentTypeFields() {
    $assistant = [
      'route_mode' => 'router',
      'agent_ids' => ['site_builder_agent', 'taxonomy_agent', 'content_type_agent', 'field_agent'],
    ];
    $message = 'Create a This is Neat! content type with a long text field named Whoa! Also add an entity reference field that uses the Languages taxonomy.';

    $route_agent_ids = ai_assistant_route_agent_ids($assistant, $message);

    $this->assertEqual(['site_builder_agent'], $route_agent_ids, 'Router sends content-type-plus-field requests to the site-builder orchestrator when available.');
  }

  public function testAssistantRouterNormalizesDependentWorkflowToSiteBuilder() {
    $assistant = [
      'route_mode' => 'router',
      'agent_ids' => ['site_builder_agent', 'taxonomy_agent', 'content_type_agent', 'field_agent'],
    ];

    $route_agent_ids = ai_assistant_normalize_route_agent_ids($assistant, ['field_agent', 'content_type_agent']);

    $this->assertEqual(['site_builder_agent'], $route_agent_ids, 'Router normalization collapses dependent content type and field work to the site-builder orchestrator.');
  }

  public function testAssistantRouterContentTypeDescriptionEdit() {
    $assistant = [
      'route_mode' => 'router',
      'agent_ids' => ['site_builder_agent', 'taxonomy_agent', 'content_type_agent', 'field_agent'],
    ];

    $route_agent_ids = ai_assistant_route_agent_ids($assistant, 'Update the description for This is Neat! that says this comes from the Backdrop Assistant.');

    $this->assertEqual(['content_type_agent'], $route_agent_ids, 'Router sends content type description edits to the content type agent.');
  }

  public function testAssistantRouterDirectTaxonomyRequest() {
    $assistant = [
      'route_mode' => 'router',
      'agent_ids' => ['site_builder_agent', 'taxonomy_agent', 'content_type_agent', 'field_agent'],
    ];

    $route_agent_ids = ai_assistant_route_agent_ids($assistant, 'Add Dutch as a term in the Languages taxonomy.');

    $this->assertEqual(['taxonomy_agent'], $route_agent_ids, 'Router still sends direct taxonomy term requests to the taxonomy agent.');
  }

  public function testAssistantApprovalResume() {
    $result = ai_assistant_send('assistant_approval', 'Hello approval');

    $this->assertEqual('needs_approval', $result['status'], 'Assistant paused for approval.');
    $this->assertTrue(!empty($result['token']), 'Approval token returned.');
    $this->assertEqual('test_write_message', $result['pending']['name'], 'Pending tool identified.');

    $resume = ai_assistant_resume('assistant_approval', $result['token'], TRUE);
    $this->assertEqual('ok', $resume['status'], 'Resumed assistant completed.');
    $this->assertEqual('Final answer: {"channel":"#content-team","message":"Approved: Hello approval"}', $resume['answer'], 'Resumed assistant returned approved answer.');
  }

  public function testAssistantMultiAgentModeAllowsSingleRelevantAgent() {
    AITestSupportAdapter::$chatWithToolsCalls = [];

    $result = ai_assistant_send('assistant_site_builder_multi', 'Create a content type named This is cool!');

    $this->assertEqual('needs_approval', $result['status'], 'Single relevant agent can still run in multi-agent mode.');
    $this->assertEqual('create_content_type', $result['pending']['name'], 'Content type creation is the pending approval step.');
    $this->assertTrue(empty($result['error']), 'No multi-agent routing error returned.');
    $this->assertEqual(1, count(AITestSupportAdapter::$chatWithToolsCalls), 'Only one agent run was needed.');
  }

  public function testAssistantMultiAgentModeStopsBeforeFieldAgentOnPlanningReply() {
    AITestSupportAdapter::$chatWithToolsCalls = [];

    $result = ai_assistant_send('assistant_site_builder_multi', 'Create a content type named This is Cool! add a long text field to it named Whoa! also create an entityreference field for the Languages taxonomy.');

    $this->assertEqual('ok', $result['status'], 'Assistant returns planning response without error.');
    $this->assertTrue(strpos($result['answer'], 'Content Type Agent') !== FALSE, 'Content type agent reply is included.');
    $this->assertTrue(strpos($result['answer'], 'Field Agent') === FALSE, 'Field agent did not run before the content type existed.');
    $this->assertTrue(empty($result['tool_calls']), 'No write tool ran during the planning-only response.');
    $this->assertEqual(1, count(AITestSupportAdapter::$chatWithToolsCalls), 'Only the content type agent was invoked.');
  }

  public function testAssistantUpdatesContentTypeDescription() {
    AITestSupportAdapter::$chatWithToolsCalls = [];

    $result = ai_assistant_send('assistant_content_type_edit', 'Update the description for This is Cool! to be Look at what we did!');

    $this->assertEqual('needs_approval', $result['status'], 'Description update requires approval.');
    $this->assertEqual('edit_content_type', $result['pending']['name'], 'Edit tool is pending, not create.');

    $resume = ai_assistant_resume('assistant_content_type_edit', $result['token'], TRUE);

    $this->assertEqual('ok', $resume['status'], 'Approved description update completed.');
    $this->assertTrue(strpos($resume['answer'], 'Look at what we did!') !== FALSE, 'Updated description returned in final answer.');

    $type = node_type_load('this_is_cool');
    $this->assertEqual('Look at what we did!', $type->description, 'Content type description was actually updated.');
  }
}
