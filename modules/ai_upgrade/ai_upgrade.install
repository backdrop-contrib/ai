<?php

/**
 * @file
 * Install-time helpers for migrating legacy openai_* modules to ai_* modules.
 *
 * Loaded by ai_upgrade.module at runtime (via module_load_install) and by
 * submodule .install hooks so all upgrade logic lives inside ai_upgrade.
 */

/**
 * Public helper: migrate a single config object from old to new namespace.
 *
 * Wrapper around _ai_migrate_config_object so ai_* submodule install hooks
 * can call it without depending on the underscore-prefixed internal name.
 *
 * @param string $old_name
 *   Legacy config object name (e.g. 'openai_anthropic.settings').
 * @param string $new_name
 *   New config object name (e.g. 'ai_provider_anthropic.settings').
 * @param callable|null $transform
 *   Optional ($data, $old_name, $new_name) -> $data transformer.
 * @param string|null $owner
 *   Module that ships $new_name as default config. When given, a target that
 *   still matches the shipped default is treated as unconfigured.
 *
 * @return bool
 *   TRUE if config was migrated, FALSE if old was empty or new already
 *   customized.
 */
function ai_upgrade_migrate_config($old_name, $new_name, $transform = NULL, $owner = NULL) {
  return _ai_migrate_config_object($old_name, $new_name, $transform, FALSE, $owner);
}

/**
 * Public helper: migrate every config object with $old_prefix to $new_prefix.
 *
 * @return int Count of migrated configs.
 */
function ai_upgrade_migrate_prefixed($old_prefix, $new_prefix, $owner = NULL) {
  return _ai_migrate_prefixed_config($old_prefix, $new_prefix, $owner);
}

/**
 * Public helper: disable any legacy openai_* modules from the list that are
 * still enabled. Safe no-op if none are enabled. Callers pass module machine
 * names (e.g. ['openai_anthropic']).
 *
 * Pass FALSE for $disable_dependents to avoid cascade-disabling unrelated
 * modules (recommended during per-module upgrades).
 */
function ai_upgrade_disable_legacy(array $legacy_modules, $disable_dependents = FALSE) {
  $to_disable = [];
  foreach ($legacy_modules as $m) {
    if (module_exists($m)) {
      $to_disable[] = $m;
    }
  }
  if (!empty($to_disable)) {
    module_disable($to_disable, $disable_dependents);
  }
  return $to_disable;
}

/**
 * Public helper: build a hook_requirements('install') response that warns when
 * legacy openai_* modules are still enabled. WARNING severity does not block
 * install — it just informs the operator that the legacy module will be
 * superseded by the new one when install runs.
 *
 * @param array $legacy_modules
 *   List of legacy module machine names to check.
 * @param string $new_module_label
 *   Human label of the new module (e.g. 'AI Provider: Anthropic').
 *
 * @return array
 *   Array suitable for return from hook_requirements.
 */
function ai_upgrade_install_warning(array $legacy_modules, $new_module_label) {
  $enabled = [];
  foreach ($legacy_modules as $m) {
    if (module_exists($m)) {
      $enabled[] = $m;
    }
  }
  if (empty($enabled)) {
    return [];
  }
  return [
    'ai_upgrade_legacy' => [
      'title' => t('@new — legacy module(s) detected', ['@new' => $new_module_label]),
      'value' => implode(', ', $enabled),
      'description' => t(
        'Installing @new will copy config and data from: @legacy. The legacy module(s) stay enabled until you complete the cutover with the AI Upgrade UI module at admin/config/ai/upgrade.',
        [
          '@new' => $new_module_label,
          '@legacy' => implode(', ', $enabled),
        ]
      ),
      'severity' => REQUIREMENT_WARNING,
    ],
  ];
}

