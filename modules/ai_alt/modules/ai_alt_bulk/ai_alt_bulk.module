<?php


/**
 * @file
 * Bulk generate alt text for images using AI.
 */

/**
 * Implements hook_file_presave().
 */
function ai_alt_bulk_file_presave($file) {
  $alt_field = function_exists('image_entity_alt_field_name') ? image_entity_alt_field_name() : 'field_alt';
  $lang = LANGUAGE_NONE;
  if (!empty($file->{$alt_field}[$lang][0]['value'])) {
    $file->{$alt_field}[$lang][0]['value'] = substr($file->{$alt_field}[$lang][0]['value'], 0, 255);
  }
}

/**
 * Implements hook_menu().
 */
function ai_alt_bulk_menu() {
  $items = [];
  // The path is now handled by a View.
  return $items;
}

/**
 * Implements hook_views_api().
 */
function ai_alt_bulk_views_api() {
  return [
    'api' => 3,
    'path' => backdrop_get_path('module', 'ai_alt_bulk'),
  ];
}

/**
 * Implements hook_views_query_alter().
 */
function ai_alt_bulk_views_query_alter(&$view, &$query) {
  if ($view->name !== 'ai_alt_bulk' || $view->base_table !== 'file_managed') {
    return;
  }

  module_load_include('inc', 'ai_alt_tools', 'includes/alt.tools');
  if (!function_exists('ai_alt_tools_excluded_file_ids')) {
    return;
  }

  $excluded_fids = ai_alt_tools_excluded_file_ids();
  if (empty($excluded_fids)) {
    return;
  }

  $query->add_where(0, 'file_managed.fid', $excluded_fids, 'NOT IN');
}

/**
 * Implements hook_autoload_info().
 */
function ai_alt_bulk_autoload_info() {
  return [
    'ai_alt_bulk_handler_field_usage_links' => 'ai_alt_bulk_handler_field_usage_links.inc',
  ];
}

/**
 * Implements hook_action_info().
 */
function ai_alt_bulk_action_info() {
  return [
    'ai_alt_bulk_generate_action' => [
      'type' => 'file',
      'label' => t('Generate alt text using AI (skip if not empty]'),
      'callback' => 'ai_alt_bulk_generate_action',
      'vbo' => TRUE,
    ],
    'ai_alt_bulk_generate_force_action' => [
      'type' => 'file',
      'label' => t('Generate alt text using AI (overwrite existing]'),
      'callback' => 'ai_alt_bulk_generate_force_action',
      'vbo' => TRUE,
    ],
    'ai_alt_bulk_seed_from_usage_action' => [
      'type' => 'file',
      'label' => t('Copy usage alt to global alt (skip if not empty]'),
      'callback' => 'ai_alt_bulk_seed_from_usage_action',
      'vbo' => TRUE,
    ],
    'ai_alt_bulk_clear_action' => [
      'type' => 'file',
      'label' => t('Clear alt text'),
      'callback' => 'ai_alt_bulk_clear_action',
      'vbo' => TRUE,
    ],
    'ai_alt_bulk_copy_filename_action' => [
      'type' => 'file',
      'label' => t('Copy filename to alt text'),
      'callback' => 'ai_alt_bulk_copy_filename_action',
      'vbo' => TRUE,
    ],
    'ai_alt_bulk_rename_filename_action' => [
      'type' => 'file',
      'label' => t('Rename filename from AI label and rewrite URLs'),
      'callback' => 'ai_alt_bulk_rename_filename_action',
      'vbo' => TRUE,
    ],
  ];
}

/**
 * Action callback: generates alt text for a file using AI.
 *
 * Skips files that already have global alt text set.
 */
function ai_alt_bulk_generate_action($file, $context = []) {
  if ($file->type != 'image') {
    return;
  }

  $alt_field = image_entity_alt_field_name();
  $lang = LANGUAGE_NONE;

  // Skip if it already has alt text.
  if (!empty($file->{$alt_field}[$lang][0]['value'])) {
    backdrop_set_message(t('Skipped @filename: already has alt text.', ['@filename' => $file->filename]), 'status');
    return;
  }

  ai_alt_bulk_generate_force_action($file, $context);
}

/**
 * Action callback: generates alt text for a file using AI (always).
 */
function ai_alt_bulk_generate_force_action($file, $context = []) {
  if ($file->type != 'image') {
    return;
  }

  $alt_field = image_entity_alt_field_name();
  $lang = LANGUAGE_NONE;

  module_load_include('module', 'ai_alt');
  if (function_exists('ai_alt_generate_from_file')) {
    $alt_text = ai_alt_generate_from_file($file);
    if ($alt_text) {
      $file->{$alt_field}[$lang][0]['value'] = $alt_text;
      file_save($file);
      backdrop_set_message(t('Generated alt text for @filename: "@alt"', [
        '@filename' => $file->filename,
        '@alt' => truncate_utf8($alt_text, 80, TRUE, TRUE),
      ]));
    }
    else {
      backdrop_set_message(t('Could not generate alt text for @filename.', ['@filename' => $file->filename]), 'warning');
    }
  }
  else {
    backdrop_set_message(t('AI alt generate function not available.'), 'error');
  }
}

/**
 * Action callback: clears the global alt text field.
 */
function ai_alt_bulk_clear_action($file, $context = []) {
  if ($file->type != 'image') {
    return;
  }

  $alt_field = image_entity_alt_field_name();
  $lang = LANGUAGE_NONE;

  if (isset($file->{$alt_field}[$lang][0]['value'])) {
    $file->{$alt_field}[$lang][0]['value'] = '';
    file_save($file);
    backdrop_set_message(t('Cleared alt text for @filename.', ['@filename' => $file->filename]));
  }
  else {
    backdrop_set_message(t('No alt text to clear for @filename.', ['@filename' => $file->filename]), 'status');
  }
}

/**
 * Action callback: copies the filename to the alt text field.
 */
function ai_alt_bulk_copy_filename_action($file, $context = []) {
  if ($file->type != 'image') {
    return;
  }

  $alt_field = image_entity_alt_field_name();
  $lang = LANGUAGE_NONE;

  $filename = pathinfo($file->filename, PATHINFO_FILENAME);
  $alt_text = ucfirst(str_replace(['_', '-'], ' ', $filename));

  $file->{$alt_field}[$lang][0]['value'] = $alt_text;
  file_save($file);
  backdrop_set_message(t('Set alt text for @filename to "@alt".', [
    '@filename' => $file->filename,
    '@alt' => $alt_text,
  ]));
}

/**
 * Action callback: renames the file from existing alt text.
 */
function ai_alt_bulk_rename_filename_action($file, $context = []) {
  if ($file->type != 'image') {
    return;
  }

  module_load_include('module', 'ai_alt');
  if (!function_exists('ai_alt_generate_short_filename_for_file')) {
    backdrop_set_message(t('Rename skipped for @filename: rename helper unavailable.', ['@filename' => $file->filename]), 'error');
    return;
  }

  $new_filename = ai_alt_generate_short_filename_for_file($file);
  if (!$new_filename) {
    backdrop_set_message(t('Rename skipped for @filename: could not generate a new filename.', ['@filename' => $file->filename]), 'warning');
    return;
  }

  $moved_file = ai_alt_move_file_to_filename($file, $new_filename);
  if (!$moved_file) {
    if (!function_exists('ai_alt_file_uses_local_stream_wrapper') || !ai_alt_file_uses_local_stream_wrapper($file->uri)) {
      backdrop_set_message(t('Rename skipped for @filename: remote storage not supported.', ['@filename' => $file->filename]), 'warning');
      return;
    }
    backdrop_set_message(t('Rename failed for @filename.', ['@filename' => $file->filename]), 'error');
    return;
  }

  backdrop_set_message(t('Renamed @old to @new.', [
    '@old' => $file->filename,
    '@new' => $new_filename,
  ]));
}

/**
 * Action callback: seeds global alt text from existing per-usage image field data.
 *
 * Uses file_usage as the entry point, then recursively scans each referencing
 * entity (including paragraphs) using two matching strategies:
 *   1. data-file-id attribute (Backdrop-native CKEditor images)
 *   2. src URL resolved to a file URI via file_managed (migrated/legacy images)
 *
 * Run this before "Generate alt text using AI" to avoid API calls for
 * images that already have human-written alt text somewhere on the site.
 */
function ai_alt_bulk_seed_from_usage_action($file, $context = []) {
  if (is_array($file)) {
    foreach ($file as $item) {
      ai_alt_bulk_seed_from_usage_action($item, $context);
    }
    return;
  }
  if ($file->type != 'image') {
    return;
  }

  $alt_field = image_entity_alt_field_name();
  $lang = LANGUAGE_NONE;

  // Skip if global alt text already exists.
  if (!empty($file->{$alt_field}[$lang][0]['value'])) {
    backdrop_set_message(t('Skipped @filename: already has global alt text.', ['@filename' => $file->filename]), 'status');
    return;
  }

  module_load_include('inc', 'ai_alt_tools', 'includes/alt.tools');
  $result = ai_alt_tools_execute_seed_alt_for_image_from_usage([
    'fid' => $file->fid,
  ]);

  if (!empty($result['error'])) {
    backdrop_set_message(t('Failed to seed alt for @filename: @error', [
      '@filename' => $file->filename,
      '@error' => $result['error'],
    ]), 'error');
    return;
  }

  if (!empty($result['saved'])) {
    backdrop_set_message(t('Seeded alt for @filename: "@alt"', [
      '@filename' => $file->filename,
      '@alt' => truncate_utf8($result['alt_text'], 80, TRUE, TRUE),
    ]));
    return;
  }

  if (!empty($result['skipped'])) {
    backdrop_set_message(t('Skipped @filename: @reason', [
      '@filename' => $file->filename,
      '@reason' => $result['reason'],
    ]), 'status');
    return;
  }

  backdrop_set_message(t('Unexpected result seeding alt for @filename.', ['@filename' => $file->filename]), 'warning');
}

/**
 * Check whether an entity type can be loaded with entity_load().
 *
 * file_usage can contain rows for entity-like types that are not actually
 * loadable through the Entity API. Skip those instead of fataling in
 * entity_get_controller().
 */
function _ai_alt_bulk_can_load_entity_type($entity_type) {
  if (!is_string($entity_type) || $entity_type === '') {
    return FALSE;
  }

  $entity_info = entity_get_info($entity_type);
  if (empty($entity_info) || empty($entity_info['controller class'])) {
    return FALSE;
  }

  return is_string($entity_info['controller class']) && class_exists($entity_info['controller class']);
}

/**
 * Implements hook_node_insert().
 */
function ai_alt_bulk_node_insert($node) {
  _ai_alt_bulk_seed_from_entity($node, 'node');
}

/**
 * Implements hook_node_update().
 */
function ai_alt_bulk_node_update($node) {
  _ai_alt_bulk_seed_from_entity($node, 'node');
}

/**
 * Seeds global alt text from image data on a freshly saved entity.
 *
 * Scans the entity recursively (including paragraphs) for any image with
 * alt text, and seeds the file entity's global alt field if it is empty.
 */
function _ai_alt_bulk_seed_from_entity($entity, $entity_type) {
  $alt_field = image_entity_alt_field_name();
  $lang = LANGUAGE_NONE;

  $fids = _ai_alt_bulk_collect_fids($entity, $entity_type);

  foreach ($fids as $fid) {
    $file = file_load($fid);
    if (!$file || $file->type !== 'image') {
      continue;
    }
    if (!empty($file->{$alt_field}[$lang][0]['value'])) {
      continue;
    }

    $alt = _ai_alt_bulk_scan_entity($entity_type, $entity, $file);
    if ($alt !== FALSE) {
      $file->{$alt_field}[$lang] = [['value' => $alt]];
      file_save($file);
    }
  }
}

/**
 * Collect all fids referenced within an entity (recursively, including paragraphs).
 *
 * Used so we know which files to attempt seeding on node save.
 */
function _ai_alt_bulk_collect_fids($entity, $entity_type) {
  $fids = [];

  $entity_info = entity_get_info($entity_type);
  $bundle_key = !empty($entity_info['entity keys']['bundle']) ? $entity_info['entity keys']['bundle'] : NULL;
  $bundle = $bundle_key ? $entity->{$bundle_key} : $entity_type;
  $instances = field_info_instances($entity_type, $bundle);

  foreach ($instances as $field_name => $instance) {
    $field_info = field_info_field($field_name);
    $lang = LANGUAGE_NONE;

    if (empty($entity->{$field_name}[$lang])) {
      continue;
    }

    switch ($field_info['type']) {
      case 'image':
      case 'file':
        foreach ($entity->{$field_name}[$lang] as $item) {
          if (!empty($item['fid'])) {
            $fids[] = $item['fid'];
          }
        }
        break;

      case 'text':
      case 'text_long':
      case 'text_with_summary':
        foreach ($entity->{$field_name}[$lang] as $item) {
          if (empty($item['value'])) continue;
          foreach (_ai_alt_bulk_parse_img_tags($item['value']) as $info) {
            if (!empty($info['fid'])) {
              $fids[] = $info['fid'];
            }
            elseif (!empty($info['src'])) {
              $fid = _ai_alt_bulk_src_to_fid($info['src']);
              if ($fid) $fids[] = $fid;
            }
          }
        }
        break;

      case 'paragraphs':
        foreach ($entity->{$field_name}[$lang] as $item) {
          if (empty($item['value'])) continue;
          $children = entity_load('paragraphs_item', [$item['value']]);
          if (!empty($children[$item['value']])) {
            $fids = array_merge($fids, _ai_alt_bulk_collect_fids($children[$item['value']], 'paragraphs_item'));
          }
        }
        break;
    }
  }

  return array_unique($fids);
}

/**
 * Recursively scan an entity and any referenced paragraphs for alt text for
 * a specific file.
 *
 * Matching strategy (in order):
 *   1. Image field: match by fid in field item → read alt value.
 *   2. Text field, Backdrop images: match <img data-file-id="X">.
 *   3. Text field, migrated images: resolve src URL to file URI, exact-match
 *      against file_managed → read alt attribute.
 *   4. Paragraphs fields: load referenced paragraphs_item entities, recurse.
 *
 * @param string $entity_type
 * @param object $entity
 * @param object $file  The file entity whose alt text we're looking for.
 *
 * @return string|FALSE  First non-empty alt text found, or FALSE.
 */
function _ai_alt_bulk_scan_entity($entity_type, $entity, $file) {
  $entity_info = entity_get_info($entity_type);
  $bundle_key = !empty($entity_info['entity keys']['bundle']) ? $entity_info['entity keys']['bundle'] : NULL;
  $bundle = $bundle_key ? $entity->{$bundle_key} : $entity_type;
  $instances = field_info_instances($entity_type, $bundle);
  $lang = LANGUAGE_NONE;

  foreach ($instances as $field_name => $instance) {
    $field_info = field_info_field($field_name);

    if (empty($entity->{$field_name}[$lang])) {
      continue;
    }

    switch ($field_info['type']) {

      // ── Standard image fields ────────────────────────────────────────────
      case 'image':
        foreach ($entity->{$field_name}[$lang] as $item) {
          if (!empty($item['fid']) && $item['fid'] == $file->fid && !empty($item['alt'])) {
            $alt = trim($item['alt']);
            if ($alt !== '') return $alt;
          }
        }
        break;

      // ── Text / body fields (CKEditor HTML) ──────────────────────────────
      case 'text':
      case 'text_long':
      case 'text_with_summary':
        foreach ($entity->{$field_name}[$lang] as $item) {
          if (empty($item['value'])) continue;
          $alt = _ai_alt_bulk_find_alt_in_html($item['value'], $file);
          if ($alt !== FALSE) return $alt;
        }
        break;

      // ── Paragraphs ───────────────────────────────────────────────────────
      case 'paragraphs':
        foreach ($entity->{$field_name}[$lang] as $item) {
          if (empty($item['value'])) continue;
          $children = entity_load('paragraphs_item', [$item['value']]);
          if (empty($children[$item['value']])) continue;
          $alt = _ai_alt_bulk_scan_entity('paragraphs_item', $children[$item['value']], $file);
          if ($alt !== FALSE) return $alt;
        }
        break;
    }
  }

  return FALSE;
}

/**
 * Find alt text for a specific file within an HTML string.
 *
 * Tries data-file-id first (Backdrop native), then resolves src URL to a
 * file URI and exact-matches against file_managed (migrated/legacy content).
 *
 * @return string|FALSE
 */
function _ai_alt_bulk_find_alt_in_html($html, $file) {
  $img_tags = _ai_alt_bulk_parse_img_tags($html);

  foreach ($img_tags as $info) {
    $matched = FALSE;

    // Strategy 1: data-file-id (Backdrop CKEditor).
    if (!empty($info['fid']) && $info['fid'] == $file->fid) {
      $matched = TRUE;
    }

    // Strategy 2: resolve src URL to a file URI (migrated images).
    if (!$matched && !empty($info['src'])) {
      $resolved_fid = _ai_alt_bulk_src_to_fid($info['src']);
      if ($resolved_fid && $resolved_fid == $file->fid) {
        $matched = TRUE;
      }
    }

    if ($matched && !empty($info['alt'])) {
      return $info['alt'];
    }
  }

  return FALSE;
}

/**
 * Resolve an image src URL to a Backdrop fid via file_managed URI lookup.
 *
 * Converts the URL path back to a public:// or private:// URI and does an
 * exact match — no filename guessing or normalization needed.
 *
 * @param string $src  The src attribute value from an <img> tag.
 *
 * @return int|FALSE  The fid, or FALSE if not found.
 */
function _ai_alt_bulk_src_to_fid($src) {
  if (empty($src)) {
    return FALSE;
  }

  // Strip query string / fragment.
  $src = preg_replace('/[?#].*$/', '', $src);

  // Normalize to a root-relative path if it's absolute.
  global $base_url;
  if (strpos($src, $base_url) === 0) {
    $src = substr($src, strlen($base_url));
  }
  // Strip leading slash.
  $src = ltrim($src, '/');

  // Map to public:// or private:// URI.
  $public_path = rtrim(config_get('system.core', 'file_public_path') ?: 'files', '/');
  $private_path = rtrim(config_get('system.core', 'file_private_path') ?: '', '/');

  if ($public_path && strpos($src, $public_path . '/') === 0) {
    $file_path = substr($src, strlen($public_path) + 1);

    // Strip image style derivative prefix (e.g. "styles/large/public/…" → original path).
    if (preg_match('#^styles/[^/]+/public/(.+]$#', $file_path, $m)) {
      $file_path = $m[1];
    }

    $uri = 'public://' . $file_path;
  }
  elseif ($private_path && strpos($src, $private_path . '/') === 0) {
    $file_path = substr($src, strlen($private_path) + 1);

    if (preg_match('#^styles/[^/]+/private/(.+]$#', $file_path, $m)) {
      $file_path = $m[1];
    }

    $uri = 'private://' . $file_path;
  }
  else {
    // Can't map to a stream-wrapper URI — give up.
    return FALSE;
  }

  return db_select('file_managed', 'fm')
    ->fields('fm', ['fid'])
    ->condition('uri', $uri)
    ->execute()
    ->fetchField();
}

/**
 * Parse all <img> tags from an HTML string.
 *
 * Returns an array of associative arrays with keys:
 *   - fid: integer from data-file-id attribute, if present
 *   - alt: decoded alt attribute value, if present
 *   - src: raw src attribute value, if present
 *
 * @return array
 */
function _ai_alt_bulk_parse_img_tags($html) {
  $found = [];

  if (!preg_match_all('/<img[^>]+>/is', $html, $matches)) {
    return $found;
  }

  foreach ($matches[0] as $tag) {
    $info = [];

    // data-file-id (quoted or unquoted).
    if (preg_match('/data-file-id\s*=\s*["\']?(\d+]["\']?/i', $tag, $m)) {
      $info['fid'] = (int) $m[1];
    }

    // alt attribute.
    if (preg_match('/\balt\s*=\s*(["\']](.*?]\1/is', $tag, $m)) {
      $alt = trim(html_entity_decode($m[2], ENT_QUOTES, 'UTF-8'));
      if ($alt !== '') {
        $info['alt'] = $alt;
      }
    }

    // src attribute.
    if (preg_match('/\bsrc\s*=\s*(["\']](.*?]\1/is', $tag, $m)) {
      $info['src'] = $m[2];
    }

    $found[] = $info;
  }

  return $found;
}
