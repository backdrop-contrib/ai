/**
 * Generic model collector for enabled providers.
 */
function ai_get_all_models_for_method($method, array $method_args = []) {
  $models = [];
  $providers_root = config_get('ai.settings', 'providers') ?: [];

  foreach ($providers_root as $provider_id => $provider_config) {
    if (empty($provider_config['enabled'])) {
      continue;
    }

    try {
      $cache_key = ai_models_cache_key($provider_id, $method, $method_args);
      $cached = cache_get($cache_key);
      if ($cached && is_array($cached->data)) {
        $provider_models = $cached->data;
      }
      else {
        $provider_api = ai_get_api($provider_id);
        if (!$provider_api) {
          continue;
        }

        if ($method === 'getModelsByCapability') {
          $provider_models = $provider_api->getModelsByCapability($method_args[0] ?? '');
        }
        elseif (method_exists($provider_api, $method)) {
          $provider_models = $provider_api->{$method}();
        }
        else {
          $provider_models = $provider_api->getModels();
        }

        if (is_array($provider_models)) {
          cache_set($cache_key, $provider_models, 'cache', REQUEST_TIME + 21600);
        }
      }

      if (empty($provider_models)) {
        continue;
      }

      $provider_label = ai_get_provider_label($provider_id);
      foreach ($provider_models as $model_id => $model_name) {
        $prefixed_id = $provider_id . '/' . $model_id;
        $models[$provider_label][$prefixed_id] = $model_name;
      }
    }
    catch (\Exception $e) {
      watchdog('ai', 'Failed to fetch models from @provider: @message', [
        '@provider' => $provider_id,
        '@message' => $e->getMessage(),
      ], WATCHDOG_WARNING);
    }
  }

  ksort($models);
  foreach ($models as $provider_label => &$provider_models) {
    natcasesort($provider_models);
  }
  unset($provider_models);
  return $models;
}

/**
 * Flattens a grouped models array into a single id => label map.
 */
function ai_flatten_models(array $grouped) {
  $flat = [];
  foreach ($grouped as $key => $value) {
    if (is_array($value)) {
      foreach ($value as $k => $v) {
        $flat[$k] = $v;
      }
    }
    else {
      $flat[$key] = $value;
    }
  }
  return $flat;
}

/**
 * Picks the best available default model from a grouped models array.
 */
function ai_default_model(array $grouped, $preferred = NULL, array $fallbacks = []) {
  $flat = ai_flatten_models($grouped);
  if (empty($flat)) {
    return $preferred;
  }
  if ($preferred && isset($flat[$preferred])) {
    return $preferred;
  }
  if ($preferred) {
    // If preferred was stored without provider prefix (or different provider prefix),
    // match by the model ID part.
    foreach (array_keys($flat) as $key) {
      $model_part = strpos($key, '/') !== FALSE ? substr($key, strpos($key, '/') + 1) : $key;
      if ($key === $preferred || $model_part === $preferred) {
        return $key;
      }
    }
  }
  foreach ($fallbacks as $candidate) {
    if (isset($flat[$candidate])) {
      return $candidate;
    }
    foreach (array_keys($flat) as $key) {
      $model_part = strpos($key, '/') !== FALSE ? substr($key, strpos($key, '/') + 1) : $key;
      if ($key === $candidate || $model_part === $candidate) {
        return $key;
      }
    }
  }
  // If no explicit fallback matched, prioritize common modern flagship models.
  $flagships = [
    '/gpt-4o(?:-mini)?$/i',
    '/claude-3-(?:7|5)-sonnet/i',
    '/gemini-2\.0-flash/i',
    '/llama-3\.[123]-(?:70b|8b)/i',
    '/mistral-large/i',
  ];
  foreach ($flagships as $pattern) {
    foreach (array_keys($flat) as $key) {
      if (preg_match($pattern, $key)) {
        return $key;
      }
    }
  }
  reset($flat);
  return key($flat);
}
