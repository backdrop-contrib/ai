<?php

/**
 * Implements hook_config_info().
 */
function ai_alt_config_info() {
  return [
    'ai_alt.settings' => [
      'label' => t('AI Alt Settings'),
      'group' => t('AI'),
    ],
  ];
}

/**
 * Implements hook_permission().
 */
function ai_alt_permission() {
  return [
    'access ai alt text generation' => [
      'title' => t('Generate AI alt text'),
      'description' => t('Generate AI alt text for files the user can view.'),
    ],
  ];
}

/**
 * Access callback for generation endpoints.
 */
function ai_alt_generation_access() {
  return user_access('access ai alt text generation') || user_access('administer site configuration');
}

/**
 * Implements hook_cron_queue_info().
 */
function ai_alt_cron_queue_info() {
  return [
    'ai_alt_filename_queue' => [
      'worker callback' => 'ai_alt_filename_queue_worker',
      'time' => 30,
    ],
  ];
}

/**
 * Implements hook_menu().
 */
function ai_alt_menu() {
  $items = [];

  $items['admin/config/ai/ai-alt'] = [
    'title' => 'AI Alt Text Generation',
    'description' => 'Provides the possibility to fill out the alt text of an image field using AI.',
    'page callback' => 'backdrop_get_form',
    'page arguments' => ['ai_alt_settings_form'],
    'access arguments' => ['administer site configuration'],
    'file' => 'includes/ai_alt.admin.inc',
    'weight' => -9,
  ];

  $items['ai-alt/generate-alt-text'] = [
    'page callback' => 'ai_alt_generate_alt_text_callback',
    'access callback' => 'ai_alt_generation_access',
    'type' => MENU_CALLBACK,
    'delivery callback' => 'backdrop_json_output',
    'file' => 'includes/ai_alt.ajax.inc',
  ];

  $items['ai-alt/ckeditor-autogenerate'] = [
    'page callback' => 'ai_alt_generate_alt_text_for_ckeditor_autogenerate',
    'access callback' => 'ai_alt_generation_access',
    'type' => MENU_CALLBACK,
    'delivery callback' => 'backdrop_json_output',
    'file' => 'includes/ai_alt.ajax.inc',
  ];

  return $items;
}

/**
 * Implements hook_element_info_alter().
 */
function ai_alt_element_info_alter(&$types) {
  if (isset($types['managed_file'])) {
    $types['managed_file']['#process'][] = 'ai_alt_image_field_process';
  }
}

/**
 * Process callback for managed_file elements.
 */
function ai_alt_image_field_process($element, &$form_state, $form) {
  module_load_include('inc', 'ai_alt', 'includes/ai_alt.widget');
  return _ai_alt_image_field_process($element, $form_state, $form);
}

/**
 * Implements hook_form_alter().
 */
function ai_alt_form_alter(&$form, &$form_state, $form_id) {
  module_load_include('inc', 'ai_alt', 'includes/ai_alt.widget');
  return _ai_alt_form_alter($form, $form_state, $form_id);
}

/**
 * Implements hook_file_insert().
 */
function ai_alt_file_insert($file) {
  if (!$file || empty($file->fid) || empty($file->filemime) || strpos($file->filemime, 'image/') !== 0 || !config_get('ai_alt.settings', 'rename_filenames')) {
    return;
  }

  BackdropQueue::get('ai_alt_filename_queue')->createItem(['fid' => (int) $file->fid]);
}

/**
 * Process one queued filename generation task.
 */
function ai_alt_filename_queue_worker($data) {
  $fid = !empty($data['fid']) ? (int) $data['fid'] : 0;
  if (!$fid || !config_get('ai_alt.settings', 'rename_filenames')) {
    return;
  }

  $file = file_load($fid);
  if (!$file || empty($file->filemime) || strpos($file->filemime, 'image/') !== 0) {
    return;
  }

  module_load_include('inc', 'ai_alt', 'includes/ai_alt.filename');
  try {
    $new_filename = _ai_alt_generate_short_filename_for_file($file);
    if (empty($new_filename) || backdrop_basename($file->uri) === $new_filename) {
      return;
    }

    if (!_ai_alt_file_uses_local_stream_wrapper($file->uri)) {
      watchdog('ai_alt', 'Skipped queued filename rename for remote file @fid.', ['@fid' => $fid], WATCHDOG_WARNING);
      return;
    }

    _ai_alt_move_file_to_filename($file, $new_filename);
  }
  catch (\Throwable $e) {
    watchdog('ai_alt', 'Queued filename generation failed for file @fid: @error', [
      '@fid' => $fid,
      '@error' => $e->getMessage(),
    ], WATCHDOG_ERROR);
  }
}

/**
 * Implements hook_form_FORM_ID_alter() for file_add_form.
 */
function ai_alt_form_file_add_form_alter(&$form, &$form_state) {
  if (isset($form['#step']) && $form['#step'] == 4) {
    module_load_include('inc', 'ai_alt', 'includes/ai_alt.widget');
    _ai_alt_attach_to_file_form($form, $form_state);
  }
}

/**
 * Implements hook_form_FORM_ID_alter() for file_manage_form.
 */
function ai_alt_form_file_manage_form_alter(&$form, &$form_state) {
  module_load_include('inc', 'ai_alt', 'includes/ai_alt.widget');
  _ai_alt_attach_to_file_form($form, $form_state);
}

/**
 * AJAX callback for file form alt text generation.
 */
function ai_alt_file_form_ajax_callback($form, &$form_state) {
  module_load_include('inc', 'ai_alt', 'includes/ai_alt.widget');
  return _ai_alt_file_form_ajax_callback($form, $form_state);
}

/**
 * Public wrapper for external callers (e.g. ai_alt_bulk).
 */
function ai_alt_generate_from_file($file) {
  module_load_include('inc', 'ai_alt', 'includes/ai_alt.generate');
  return _ai_alt_generate_from_file($file);
}

/**
 * Public wrapper for external callers (e.g. ai_alt_tools).
 */
function ai_alt_generate_short_filename_for_file($file) {
  module_load_include('inc', 'ai_alt', 'includes/ai_alt.filename');
  return _ai_alt_generate_short_filename_for_file($file);
}

/**
 * Public wrapper for external callers (e.g. ai_alt_tools, ai_alt_bulk).
 */
function ai_alt_move_file_to_filename($file, $new_filename) {
  module_load_include('inc', 'ai_alt', 'includes/ai_alt.filename');
  module_load_include('inc', 'ai_alt', 'includes/ai_alt.references');
  return _ai_alt_move_file_to_filename($file, $new_filename);
}

/**
 * Public wrapper for external callers (e.g. ai_alt_tools, ai_alt_bulk).
 */
function ai_alt_file_uses_local_stream_wrapper($uri) {
  module_load_include('inc', 'ai_alt', 'includes/ai_alt.filename');
  return _ai_alt_file_uses_local_stream_wrapper($uri);
}
