<?php

/**
 * @file
 * Test class for AI module integration.
 */

/**
 * Defines a test case for the AI module.
 */
class AITestCase extends BackdropWebTestCase {

  /**
   * A user object for the privileged user.
   *
   * @var object
   */
  protected $privilegedUser;

  /**
   * Sets up the test environment.
   */
  public function setUp() {
    // Load AI plus the local Ollama provider and deterministic helper.
    parent::setUp(['ai', 'ai_provider_ollama', 'ai_agent_test']);

    $providers = config('ai.settings');
    $providers->set('providers', [
      'agent_test' => [
        'enabled' => 1,
      ],
      'ollama' => [
        'enabled' => 1,
        'ollama_base_url' => 'http://host.docker.internal:11434',
      ],
    ]);
    $providers->save();

    // Create a user with the necessary permissions.
    $this->privilegedUser = $this->backdropCreateUser([
      'administer site configuration'
    ]);
    $this->backdropLogin($this->privilegedUser);
  }

  /**
   * Test the API key configuration form.
   */
  public function testAPIKeyConfiguration() {
    // Navigate to the AI settings form.
    $this->backdropGet('admin/config/ai/settings');

    // Verify the built-in AI provider settings are present.
    $this->assertFieldByName('providers[enabled_providers_ollama]', '', 'Ollama enable checkbox found.');
    $this->assertFieldByName('providers[ollama_settings][ollama_base_url]', '', 'Ollama server URL field found.');

    // Save the local Ollama endpoint through the provider form.
    $edit = [
      'providers[enabled_providers_agent_test]' => 1,
      'providers[enabled_providers_ollama]' => 1,
      'providers[ollama_settings][ollama_base_url]' => 'http://host.docker.internal:11434',
    ];
    $this->backdropPost(NULL, $edit, t('Save configuration'));

    $this->assertText('AI provider settings saved.', 'Provider configuration saved message shown.');
    $saved_providers = config_get('ai.settings', 'providers');
    $this->assertEqual('http://host.docker.internal:11434', $saved_providers['ollama']['ollama_base_url'], 'Ollama endpoint persisted.');

    // Verify the logging form separately; it is now a dedicated local task.
    $this->backdropGet('admin/config/ai/settings/logging');
    $this->assertFieldByName('ai_log_enabled', '', 'AI logging checkbox found.');
    $this->assertFieldByName('ai_log_max_age', NULL, 'AI log retention field found.');
    $this->backdropPost(NULL, [
      'ai_log_enabled' => 1,
      'ai_log_max_age' => 3600,
    ], t('Save configuration'));
    $this->assertText('API logging settings saved.', 'Logging configuration saved message shown.');
    $this->assertTrue((bool) config_get('ai.settings', 'ai_log_enabled'), 'Logging setting persisted.');
  }

  /**
   * Test provider connectivity using the local Ollama provider.
   */
  public function testAPIConnectivity() {
    $api = ai_get_api('ollama');
    $this->assertTrue(is_object($api), 'Ollama provider API was created.');

    $models = $api->getModels();

    $this->assertTrue(isset($models['qwen3.5:4b']), 'Ollama chat model was retrieved from the live server.');
    $this->assertTrue(isset($models['nomic-embed-text:latest']), 'Ollama embedding model was retrieved from the live server.');
  }
}
