<?php

/**
 * @file
 * Install, update and uninstall functions for the ai_site_context module.
 */

/**
 * Implements hook_install().
 */
function ai_site_context_install() {
  if (!module_load_install('ai_upgrade')) { return []; }
  ai_upgrade_module_install('ai_site_context');
}

/**
 * Copy legacy Site Context configuration into the AI namespace.
 *
 * Non-destructive: legacy config is kept and the legacy module stays enabled
 * until the operator completes the cutover with AI Upgrade.
 */
function ai_site_context_update_1000() {
  if (!module_load_install('ai_upgrade')) {
    return t('AI Upgrade helpers unavailable; legacy Site Context configuration not migrated.');
  }
  $result = ai_upgrade_module_install('ai_site_context');
  return t('Copied @count legacy Site Context config object(s).', ['@count' => $result['migrated']]);
}

/**
 * Implements hook_requirements().
 */
function ai_site_context_requirements($phase) {
  if (!module_load_install('ai_upgrade')) { return []; }
  return ai_upgrade_module_requirements($phase, 'ai_site_context');
}
