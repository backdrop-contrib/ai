    'description' => 'Configure AI moderation profiles and content targets.',
    'page callback' => 'backdrop_get_form',
    'page arguments' => ['ai_moderation_settings_form'],
    'access arguments' => ['access ai moderation'],
    'file' => 'includes/admin.inc',
    'type' => MENU_NORMAL_ITEM,
    'weight' => -5,
  ];
  $items['admin/config/ai/ai-moderation/settings'] = [
    'title' => 'Settings',
    'type' => MENU_DEFAULT_LOCAL_TASK,
    'weight' => -10,
  ];
  $items['admin/config/ai/ai-moderation/queue'] = [
    'title' => 'Review queue',
    'description' => 'Review AI moderation verdicts.',
    'page callback' => 'ai_moderation_queue_page',
    'access arguments' => ['access ai moderation'],
    'file' => 'includes/pages.inc',
    'type' => MENU_LOCAL_TASK,
  ];
  $items['admin/config/ai/ai-moderation/reported'] = [
    'title' => 'Reported content',
    'description' => 'Review content that AI moderation flagged or could not evaluate.',
    'page callback' => 'ai_moderation_queue_page',
    'page arguments' => [TRUE],
    'access arguments' => ['access ai moderation'],
    'file' => 'includes/pages.inc',
    'type' => MENU_LOCAL_TASK,
