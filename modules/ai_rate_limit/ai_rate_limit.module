<?php


/**
 * @file
 * Per-provider rate limiting for external AI API calls.
 *
 * All external AI calls pass through AIApi (or its provider adapters).
 * AIApi::checkRateLimit() calls ai_rate_limit_check() before each
 * request. If the limit is exceeded the call throws an exception, which is
 * caught and recorded by the calling module (runner, async callback, etc.).
 *
 * Configuration:
 *  - A site-wide global limit (across all providers combined), 0 = disabled.
 *  - Per-provider limits (requests per window, window in seconds).
 *
 * Limits are stored in the database so they are shared across PHP processes
 * and web workers — unlike static variables or APC/APCu caches.
 *
 * Usage from other modules:
 * @code
 *   if (!ai_rate_limit_check('provider_name', 'chat')) {
 *     throw new Exception('Rate limit exceeded.');
 *   }
 * @endcode
 */

// ---------------------------------------------------------------------------
// Config
// ---------------------------------------------------------------------------

/**
 * Implements hook_config_info().
 */
function ai_rate_limit_config_info() {
  return [
    'ai_rate_limit.settings' => [
      'label' => t('AI Rate Limit settings'),
      'group' => t('AI'),
    ],
  ];
}

// ---------------------------------------------------------------------------
// Menu / admin / permissions
// ---------------------------------------------------------------------------

/**
 * Implements hook_permission().
 */
function ai_rate_limit_permission() {
  return [
    'bypass ai rate limit' => [
      'title' => t('Bypass AI rate limits'),
      'description' => t('Exempts the user from AI rate limits and quota restrictions.'),
      'restrict access' => TRUE,
    ],
  ];
}

/**
 * Implements hook_menu().
 */
function ai_rate_limit_menu() {
  $items = [];

  $items['admin/config/ai/ai-rate-limit'] = [
    'title'            => 'AI Rate Limiting',
    'description'      => 'Configure per-provider request rate limits for external AI API calls.',
    'page callback'    => 'backdrop_get_form',
    'page arguments'   => ['ai_rate_limit_settings_form'],
    'access arguments' => ['administer site configuration'],
    'type'             => MENU_NORMAL_ITEM,
  ];

  return $items;
}

/**
 * Settings form.
 */
function ai_rate_limit_settings_form($form, &$form_state) {
  $config = config('ai_rate_limit.settings');
  $default_limit = 60;
  $default_window = 60;

  $form['#config'] = 'ai_rate_limit.settings';

  $form['enabled'] = [
    '#type'          => 'checkbox',
    '#title'         => t('Enable rate limiting'),
    '#description'   => t('When checked, rate limiting is active immediately using the global defaults below unless you change them.'),
    '#default_value' => $config->get('enabled'),
  ];

  // Current usage display when rate limiting is active.
  if ($config->get('enabled') && db_table_exists('ai_rate_limit_events')) {
    $status = ai_rate_limit_status(TRUE);
    $rows = [];

    if (isset($status['global']) && $status['global']['limit'] > 0) {
      $g = $status['global'];
      $pct = round(($g['count'] / max(1, $g['limit'])) * 100);
      $rows[] = [
        '<strong>' . t('Global (All Providers)') . '</strong>',
        t('@count / @limit requests (@pct%)', ['@count' => $g['count'], '@limit' => $g['limit'], '@pct' => $pct]),
        t('@window seconds', ['@window' => $g['window']]),
      ];
    }

    if (isset($status['user']) && $status['user']['limit'] > 0) {
      $u = $status['user'];
      $pct = round(($u['count'] / max(1, $u['limit'])) * 100);
      $rows[] = [
        t('Current User (UID @uid)', ['@uid' => $GLOBALS['user']->uid ?? 0]),
        t('@count / @limit requests (@pct%)', ['@count' => $u['count'], '@limit' => $u['limit'], '@pct' => $pct]),
        t('@window seconds', ['@window' => $u['window']]),
      ];
    }

    foreach ($status as $key => $info) {
      if ($key === 'global' || $key === 'user') {
        continue;
      }
      if (!empty($info['limit'])) {
        $pct = round(($info['count'] / max(1, $info['limit'])) * 100);
        $providers = _ai_rate_limit_get_providers();
        $label = $providers[$key] ?? $key;
        $rows[] = [
          check_plain($label),
          t('@count / @limit requests (@pct%)', ['@count' => $info['count'], '@limit' => $info['limit'], '@pct' => $pct]),
          t('@window seconds', ['@window' => $info['window']]),
        ];
      }
    }

    if (!empty($rows)) {
      $form['current_usage'] = [
        '#type'        => 'fieldset',
        '#title'       => t('Current usage (active sliding windows)'),
        '#collapsible' => FALSE,
        '#states'      => [
          'visible' => [':input[name="enabled"]' => ['checked' => TRUE]],
        ],
      ];
      $form['current_usage']['table'] = [
        '#theme'  => 'table',
        '#header' => [t('Scope'), t('Usage'), t('Window')],
        '#rows'   => $rows,
      ];
    }
  }

  $form['global'] = [
    '#type'  => 'fieldset',
    '#title' => t('Global limit'),
    '#description' => t('Applies across <em>all</em> providers combined. Example: limit `2` with window `60` allows up to 2 requests within 60 seconds.'),
    '#states' => [
      'visible' => [':input[name="enabled"]' => ['checked' => TRUE]],
    ],
  ];

  $form['global']['global_limit'] = [
    '#type'          => 'number',
    '#title'         => t('Request limit'),
    '#min'           => 1,
    '#default_value' => (int) ($config->get('global_limit') ?: $default_limit),
    '#field_suffix'  => t('requests'),
    '#size'          => 6,
    '#description'   => t('Default: @limit requests.', ['@limit' => $default_limit]),
  ];

  $form['global']['global_window'] = [
    '#type'          => 'number',
    '#title'         => t('Window'),
    '#min'           => 1,
    '#default_value' => (int) ($config->get('global_window') ?: $default_window),
    '#field_suffix'  => t('seconds'),
    '#size'          => 6,
    '#description'   => t('Default: @window seconds.', ['@window' => $default_window]),
  ];

  // Per-user limit.
  $form['user'] = [
    '#type'  => 'fieldset',
    '#title' => t('Per-user limit'),
    '#description' => t('Optional limit applied to individual users (and anonymous visitors) to prevent a single actor from exhausting the site quota. Set limit to 0 to disable.'),
    '#states' => [
      'visible' => [':input[name="enabled"]' => ['checked' => TRUE]],
    ],
  ];

  $form['user']['user_limit'] = [
    '#type'          => 'number',
    '#title'         => t('Request limit'),
    '#min'           => 0,
    '#default_value' => (int) ($config->get('user_limit') ?: 0),
    '#field_suffix'  => t('requests (0 = disabled)'),
    '#size'          => 6,
    '#description'   => t('Maximum requests allowed per individual user account within the window. Set to 0 to disable.'),
  ];

  $form['user']['user_window'] = [
    '#type'          => 'number',
    '#title'         => t('Window'),
    '#min'           => 1,
    '#default_value' => (int) ($config->get('user_window') ?: $default_window),
    '#field_suffix'  => t('seconds'),
    '#size'          => 6,
    '#description'   => t('Default: @window seconds.', ['@window' => $default_window]),
  ];

  // Per-provider limits. Source providers from hook_ai_provider_info() when
  // available, with a sensible static fallback list.
  $providers = _ai_rate_limit_get_providers();
  $provider_limits = $config->get('provider_limits') ?: [];

  $form['providers'] = [
    '#type'  => 'fieldset',
    '#title' => t('Per-provider limits'),
    '#description' => t('Optional overrides for providers that are enabled in AI settings. These limits apply only to that provider.'),
    '#states' => [
      'visible' => [':input[name="enabled"]' => ['checked' => TRUE]],
    ],
    '#tree' => TRUE,
  ];

  foreach ($providers as $provider_id => $provider_label) {
    $saved = isset($provider_limits[$provider_id]) ? $provider_limits[$provider_id] : [];

    $form['providers'][$provider_id] = [
      '#type'  => 'fieldset',
      '#title' => check_plain($provider_label),
    ];

    $form['providers'][$provider_id]['enabled'] = [
      '#type' => 'checkbox',
      '#title' => t('Enable provider-specific limit'),
      '#default_value' => !empty($saved['limit']),
    ];

    $form['providers'][$provider_id]['limit'] = [
      '#type'          => 'number',
      '#title'         => t('Request limit'),
      '#min'           => 1,
      '#default_value' => !empty($saved['limit']) ? (int) $saved['limit'] : $default_limit,
      '#field_suffix'  => t('requests'),
      '#size'          => 6,
      '#description'   => t('Applies only when the provider-specific limit is enabled.'),
      '#states' => [
        'visible' => [':input[name="providers[' . $provider_id . '][enabled]"]' => ['checked' => TRUE]],
      ],
    ];

    $form['providers'][$provider_id]['window'] = [
      '#type'          => 'number',
      '#title'         => t('Window (seconds)'),
      '#min'           => 1,
      '#default_value' => isset($saved['window']) ? (int) $saved['window'] : $default_window,
      '#size'          => 6,
      '#states' => [
        'visible' => [':input[name="providers[' . $provider_id . '][enabled]"]' => ['checked' => TRUE]],
      ],
    ];
  }

  $form['actions'] = ['#type' => 'actions'];
  $form['actions']['submit'] = [
    '#type'  => 'submit',
    '#value' => t('Save configuration'),
  ];

  return $form;
}

/**
 * Submit handler for ai_rate_limit_settings_form.
 */
function ai_rate_limit_settings_form_submit($form, &$form_state) {
  $config = config('ai_rate_limit.settings');
  $config->set('enabled', (bool) $form_state['values']['enabled']);
  $config->set('global_limit', max(1, (int) $form_state['values']['global_limit']));
  $config->set('global_window', max(1, (int) $form_state['values']['global_window']));
  $config->set('user_limit', max(0, (int) $form_state['values']['user_limit']));
  $config->set('user_window', max(1, (int) $form_state['values']['user_window']));

  $provider_limits = [];
  if (!empty($form_state['values']['providers']) && is_array($form_state['values']['providers'])) {
    foreach ($form_state['values']['providers'] as $provider_id => $values) {
      if (!empty($values['enabled'])) {
        $limit  = max(1, (int) ($values['limit'] ?? 60));
        $window = max(1, (int) ($values['window'] ?? 60));
        $provider_limits[$provider_id] = ['limit' => $limit, 'window' => $window];
      }
    }
  }
  $config->set('provider_limits', $provider_limits);
  $config->save();

  backdrop_set_message(t('Rate limit settings saved.'));
}

// ---------------------------------------------------------------------------
// Implements hook_cron()
// ---------------------------------------------------------------------------

/**
 * Implements hook_cron().
 *
 * Purges rate limit event records older than the longest configured window so
 * the table does not grow unbounded.
 */
function ai_rate_limit_cron() {
  $config = config('ai_rate_limit.settings');

  // Find the longest window across all configured limits.
  $max_window = max(
    (int) ($config->get('global_window') ?: 60),
    (int) ($config->get('user_window') ?: 60),
    60
  );
  $provider_limits = $config->get('provider_limits') ?: [];
  foreach ($provider_limits as $pl) {
    $max_window = max($max_window, (int) ($pl['window'] ?? 60));
  }

  // Keep a 2× safety margin so borderline rows are not deleted prematurely.
  $cutoff = time() - ($max_window * 2);
  db_delete('ai_rate_limit_events')
    ->condition('timestamp', $cutoff, '<')
    ->execute();
}

// ---------------------------------------------------------------------------
// Public API
// ---------------------------------------------------------------------------

/**
 * Checks whether an AI provider call is within the configured rate limit.
 *
 * If the call is allowed, it is registered in the event table before returning.
 * This function is called by AIApi::checkRateLimit() before every external
 * AI API request.
 *
 * @param string $provider
 *   Provider machine name (e.g. 'provider_name', 'anthropic', 'ollama').
 * @param string $operation
 *   Operation name (e.g. 'chat', 'embedding', 'images', 'moderation').
 *
 * @return bool
 *   TRUE if the call is allowed and has been registered.
 *   FALSE if the rate limit is exceeded — the caller should throw or return.
 */
function ai_rate_limit_check($provider, $operation) {
  global $user;
  if (!empty($user->uid) && user_access('bypass ai rate limit', $user)) {
    return TRUE;
  }

  $config = config('ai_rate_limit.settings');

  if (!$config->get('enabled')) {
    return TRUE;
  }

  $global_limit = (int) $config->get('global_limit');
  $user_limit = (int) $config->get('user_limit');
  $provider_limits = $config->get('provider_limits') ?: [];
  $provider_limit_configured = !empty($provider_limits[$provider]) && !empty($provider_limits[$provider]['limit']);

  // If no global, user, or provider-specific limits apply, do not write tracking rows.
  if ($global_limit <= 0 && $user_limit <= 0 && !$provider_limit_configured) {
    return TRUE;
  }

  $lock_name = 'ai_rate_limit:check';
  if (!lock_acquire($lock_name, 5.0)) {
    watchdog('ai_rate_limit', 'Could not acquire rate limit lock for provider @provider, operation @op. Blocking request to preserve strict enforcement.', [
      '@provider' => $provider,
      '@op' => $operation,
    ], WATCHDOG_WARNING);
    return FALSE;
  }

  try {
    $now = time();

    // 1. Global limit (all providers combined).
    $global_window = (int) ($config->get('global_window') ?: 60);
    if ($global_limit > 0) {
      $since = $now - $global_window;
      $count = db_query(
        'SELECT COUNT(*) FROM {ai_rate_limit_events} WHERE timestamp > :since',
        [':since' => $since]
      )->fetchField();

      if ((int) $count >= $global_limit) {
        $oldest = db_query(
          'SELECT MIN(timestamp) FROM {ai_rate_limit_events} WHERE timestamp > :since',
          [':since' => $since]
        )->fetchField();
        $retry_after = max(1, ($oldest ? (int) $oldest + $global_window : $now + $global_window) - $now);
        _ai_rate_limit_record_violation('global', $count, $global_limit, $global_window, $retry_after, $provider, $operation);

        watchdog('ai_rate_limit', 'Global rate limit exceeded: @count/@limit calls in @window s. Provider: @provider, Operation: @op.', [
          '@count'    => $count,
          '@limit'    => $global_limit,
          '@window'   => $global_window,
          '@provider' => $provider,
          '@op'       => $operation,
        ], WATCHDOG_WARNING);
        return FALSE;
      }
    }

    // 2. Per-provider limit.
    if ($provider_limit_configured) {
      $pl     = $provider_limits[$provider];
      $limit  = (int) $pl['limit'];
      $window = (int) ($pl['window'] ?? 60);
      $since  = $now - $window;

      $count = db_query(
        'SELECT COUNT(*) FROM {ai_rate_limit_events} WHERE provider = :provider AND timestamp > :since',
        [':provider' => $provider, ':since' => $since]
      )->fetchField();

      if ((int) $count >= $limit) {
        $oldest = db_query(
          'SELECT MIN(timestamp) FROM {ai_rate_limit_events} WHERE provider = :provider AND timestamp > :since',
          [':provider' => $provider, ':since' => $since]
        )->fetchField();
        $retry_after = max(1, ($oldest ? (int) $oldest + $window : $now + $window) - $now);
        _ai_rate_limit_record_violation('provider', $count, $limit, $window, $retry_after, $provider, $operation);

        watchdog('ai_rate_limit', 'Provider rate limit exceeded for @provider: @count/@limit calls in @window s. Operation: @op.', [
          '@provider' => $provider,
          '@count'    => $count,
          '@limit'    => $limit,
          '@window'   => $window,
          '@op'       => $operation,
        ], WATCHDOG_WARNING);
        return FALSE;
      }
    }

    // 3. Per-user limit.
    if ($user_limit > 0) {
      $user_window = (int) ($config->get('user_window') ?: 60);
      $user_since  = $now - $user_window;
      $uid         = isset($user->uid) ? (int) $user->uid : 0;

      $count = db_query(
        'SELECT COUNT(*) FROM {ai_rate_limit_events} WHERE uid = :uid AND timestamp > :since',
        [':uid' => $uid, ':since' => $user_since]
      )->fetchField();

      if ((int) $count >= $user_limit) {
        $oldest = db_query(
          'SELECT MIN(timestamp) FROM {ai_rate_limit_events} WHERE uid = :uid AND timestamp > :since',
          [':uid' => $uid, ':since' => $user_since]
        )->fetchField();
        $retry_after = max(1, ($oldest ? (int) $oldest + $user_window : $now + $user_window) - $now);
        _ai_rate_limit_record_violation('user', $count, $user_limit, $user_window, $retry_after, $provider, $operation);

        watchdog('ai_rate_limit', 'Per-user rate limit exceeded for UID @uid: @count/@limit calls in @window s. Provider: @provider, Operation: @op.', [
          '@uid'      => $uid,
          '@count'    => $count,
          '@limit'    => $user_limit,
          '@window'   => $user_window,
          '@provider' => $provider,
          '@op'       => $operation,
        ], WATCHDOG_WARNING);
        return FALSE;
      }
    }

    // Allowed — register the event while still holding the lock so
    // concurrent workers cannot overshoot the configured limit.
    db_insert('ai_rate_limit_events')
      ->fields([
        'provider'  => $provider,
        'operation' => $operation,
        'uid'       => isset($user->uid) ? (int) $user->uid : 0,
        'timestamp' => $now,
      ])
      ->execute();
  }
  finally {
    lock_release($lock_name);
  }

  return TRUE;
}

/**
 * Records the most recent rate limit violation in static memory.
 */
function _ai_rate_limit_record_violation($type, $count, $limit, $window, $retry_after, $provider, $operation) {
  $info = &backdrop_static('ai_rate_limit_last_violation', []);
  $info = [
    'type'        => $type,
    'count'       => (int) $count,
    'limit'       => (int) $limit,
    'window'      => (int) $window,
    'retry_after' => max(1, (int) $retry_after),
    'provider'    => $provider,
    'operation'   => $operation,
  ];
}

/**
 * Returns the most recent rate limit violation details, if any.
 *
 * @return array
 *   Associative array with keys: type, count, limit, window, retry_after,
 *   provider, operation. Empty array if no violation occurred.
 */
function ai_rate_limit_get_last_violation() {
  return backdrop_static('ai_rate_limit_last_violation', []);
}

/**
 * Returns current call counts for configured scopes within their active windows.
 *
 * Useful for status pages and admin dashboards.
 *
 * @param bool $include_global
 *   Whether to include global and per-user limits in the returned status.
 *
 * @return array
 *   Keyed by scope ('global', 'user', or provider ID), each value is an array with keys:
 *   - count: calls in the current window
 *   - limit: configured limit (0 = none)
 *   - window: window in seconds
 */
function ai_rate_limit_status($include_global = TRUE) {
  $config = config('ai_rate_limit.settings');
  $now = time();
  $status = [];

  if ($include_global) {
    $global_limit = (int) $config->get('global_limit');
    $global_window = (int) ($config->get('global_window') ?: 60);
    $since = $now - $global_window;
    $count = db_query(
      'SELECT COUNT(*) FROM {ai_rate_limit_events} WHERE timestamp > :since',
      [':since' => $since]
    )->fetchField();

    $status['global'] = [
      'count'  => (int) $count,
      'limit'  => $global_limit,
      'window' => $global_window,
    ];

    $user_limit = (int) $config->get('user_limit');
    if ($user_limit > 0) {
      $user_window = (int) ($config->get('user_window') ?: 60);
      $user_since = $now - $user_window;
      global $user;
      $uid = isset($user->uid) ? (int) $user->uid : 0;
      $count = db_query(
        'SELECT COUNT(*) FROM {ai_rate_limit_events} WHERE uid = :uid AND timestamp > :since',
        [':uid' => $uid, ':since' => $user_since]
      )->fetchField();

      $status['user'] = [
        'count'  => (int) $count,
        'limit'  => $user_limit,
        'window' => $user_window,
      ];
    }
  }

  $provider_limits = $config->get('provider_limits') ?: [];
  foreach ($provider_limits as $provider => $pl) {
    $window = (int) ($pl['window'] ?? 60);
    $since  = $now - $window;
    $count  = db_query(
      'SELECT COUNT(*) FROM {ai_rate_limit_events} WHERE provider = :provider AND timestamp > :since',
      [':provider' => $provider, ':since' => $since]
    )->fetchField();

    $status[$provider] = [
      'count'  => (int) $count,
      'limit'  => (int) $pl['limit'],
      'window' => $window,
    ];
  }

  return $status;
}

// ---------------------------------------------------------------------------
// Internal helpers
// ---------------------------------------------------------------------------

/**
 * Returns an array of provider machine names => labels for the settings form.
 */
function _ai_rate_limit_get_providers() {
  $enabled_provider_ids = [];
  $ai_config = config('ai.settings');
  $provider_config = $ai_config->get('providers') ?: [];
  foreach ($provider_config as $provider_id => $provider_settings) {
    if (!empty($provider_settings['enabled'])) {
      $enabled_provider_ids[$provider_id] = TRUE;
    }
  }

  // Use the ai provider registry when available.
  if (function_exists('ai_get_providers')) {
    $raw = ai_get_providers();
    $providers = [];
    foreach ($raw as $id => $info) {
      if (!empty($enabled_provider_ids) && empty($enabled_provider_ids[$id])) {
        continue;
      }
      $providers[$id] = isset($info['label']) ? $info['label'] : $id;
    }
    if (!empty($providers)) {
      return $providers;
    }
  }

  // Static fallback covering the common providers in this ecosystem.
  $providers = [
    'openai'       => t('OpenAI'),
    'anthropic'    => t('Anthropic'),
    'google_gemini' => t('Google Gemini'),
    'ollama'       => t('Ollama'),
    'openrouter'   => t('OpenRouter'),
    'litellm'      => t('LiteLLM'),
  ];
  if (empty($enabled_provider_ids)) {
    return $providers;
  }

  return array_intersect_key($providers, $enabled_provider_ids);
}
