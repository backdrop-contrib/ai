/**
 * Implements hook_ai_async_callbacks().
 */
function ai_agent_test_ai_async_callbacks() {
  return [
    'ai_agent_test_async_echo' => t('Deterministic async echo callback for tests.'),
  ];
}

/**
 * Tool executor for deterministic tests.
 */
function ai_agent_test_execute_test_echo_message(array $args) {
  return [
    'echo' => isset($args['message']) ? (string) $args['message'] : '',
  ];
}

/**
 * Tool executor used by constraint tests.
 */
function ai_agent_test_execute_test_controlled_message(array $args) {
  return [
    'channel' => isset($args['channel']) ? (string) $args['channel'] : '',
    'message' => isset($args['message']) ? (string) $args['message'] : '',
  ];
}

/**
 * Tool executor used by constraint tests.
 */
function ai_agent_test_execute_test_routed_message(array $args) {
  return [
    'channel' => isset($args['channel']) ? (string) $args['channel'] : '',
    'message' => isset($args['message']) ? (string) $args['message'] : '',
  ];
}

/**
 * Tool executor used by approval tests.
 */
function ai_agent_test_execute_test_write_message(array $args) {
  return [
    'channel' => isset($args['channel']) ? (string) $args['channel'] : '',
    'message' => isset($args['message']) ? (string) $args['message'] : '',
  ];
}

/**
 * Pre-execute hook for deterministic agent tests.
 */
function ai_agent_test_ai_agent_tool_pre_execute($tool_name, &$args, $agent_config) {
  if ($tool_name === 'test_controlled_message') {
    if (isset($args['message'])) {
      $args['message'] = 'Hooked: ' . $args['message'];
    }
    return TRUE;
  }

  if ($tool_name === 'test_write_message') {
    if (isset($args['message'])) {
      $args['message'] = 'Approved: ' . $args['message'];
    }
    return TRUE;
  }

  return TRUE;
}

/**
 * Async callback used by worker tests.
 */
function ai_agent_test_async_echo(array $data) {
  return [
    'echo' => isset($data['message']) ? (string) $data['message'] : '',
  ];
}
