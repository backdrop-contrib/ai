  return $items;
}

/**
 * Load one implementation include.
 */
function ai_moderation_load_include($name) {
  module_load_include('inc', 'ai_moderation', 'includes/' . $name);
}

/**
 * Evaluate untrusted text with a moderation profile.
 *
 * @see ai_moderation.api.php
 */
function ai_moderation_evaluate($text, array $options = []) {
  ai_moderation_load_include('evaluate');
  return _ai_moderation_evaluate($text, $options);
}

/**
 * Evaluate and record a verdict for one entity.
 *
 * Returns NULL when the entity/bundle has no configured target.
 */
function ai_moderation_gate_entity($entity_type, $bundle, $entity_id, $text, array $options = []) {
  ai_moderation_load_include('evaluate');
  return _ai_moderation_gate_entity($entity_type, $bundle, $entity_id, $text, $options);
}

/**
 * Queue an entity re-scan without serializing submitted text into a job.
 *
 * Returns the async job ID, or FALSE when AI Async is not enabled.
 */
function ai_moderation_rescan_entity_async($entity_type, $entity_id) {
  if (!module_exists('ai_async') || !function_exists('ai_async_submit')) {
    return FALSE;
  }
  return ai_async_submit('ai_moderation_async_rescan_entity', [
    'entity_type' => $entity_type,
    'entity_id' => (string) $entity_id,
  ]);
}

/**
 * Implements hook_ai_async_callbacks().
 */
function ai_moderation_ai_async_callbacks() {
  return [
    'ai_moderation_async_rescan_entity' => t('Re-scan an entity with its configured AI moderation profile.'),
  ];
}

/**
 * Execute a queued entity re-scan.
 */
function ai_moderation_async_rescan_entity(array $data) {
  $entity_type = !empty($data['entity_type']) ? $data['entity_type'] : '';
  $entity_id = !empty($data['entity_id']) ? (string) $data['entity_id'] : '';
  $entity_info = $entity_type === '' ? NULL : entity_get_info($entity_type);
  if (empty($entity_info) || $entity_id === '') {
    return ['status' => 'error', 'message' => 'Entity type or ID is invalid.'];
  }
  $entities = entity_load($entity_type, [$entity_id]);
  if (empty($entities)) {
    return ['status' => 'error', 'message' => 'Entity was not found.'];
  }
  $entity = reset($entities);
  $ids = entity_extract_ids($entity_type, $entity);
  $bundle = $ids[2] ?? '';
  if ($entity_type === 'comment') {
    $bundle = _ai_moderation_comment_bundle($bundle);
  }
  $revision_id = $ids[1] ?? NULL;
  $definitions = ai_moderation_get_entity_info();
  $extract = $definitions[$entity_type]['extract'] ?? '';
  if (!is_callable($extract)) {
    return ['status' => 'error', 'message' => 'No moderation extractor is registered.'];
  }
  $text = call_user_func($extract, $entity);
  if ($text === '') {
    return ['status' => 'error', 'message' => 'Entity has no moderatable text.'];
  }
  $options = !empty($revision_id) ? ['entity_revision' => $revision_id] : [];
  $options['uid'] = isset($entity->uid) ? (int) $entity->uid : 0;
  $verdict = ai_moderation_gate_entity($entity_type, $bundle, $entity_id, $text, $options);
  if (in_array($entity_type, ['node', 'comment'], TRUE)) {
    _ai_moderation_enforce_async_verdict($entity_type, $entity_id, $revision_id, hash('sha256', $text), $verdict);
  }
  return $verdict ?: ['status' => 'skipped', 'message' => 'Entity bundle has no configured moderation target.'];
}

/**
 * Quarantine already-saved built-in content flagged by an async re-scan.
 *
 * Reuses the same enforcement gate as the presave path. The re-save is
 * marked to skip another gate pass so it cannot recursively queue or store
 * another verdict via _ai_moderation_store_builtin_entity_verdict().
 *
 * The entity is reloaded fresh (rather than reusing the object evaluated
 * before the provider call) and its revision/content hash are compared
 * against what was actually evaluated; a mismatch means the content changed
 * during evaluation, so this discards the stale verdict and queues a new
 * scan instead of quarantining content the verdict no longer describes.
 * Bypass eligibility is checked against the entity's original submitter,
 * not whichever account is executing the queued job.
 */
function _ai_moderation_enforce_async_verdict($entity_type, $entity_id, $revision_id, $content_hash, $verdict) {
  if (!_ai_moderation_enforcement_ready($verdict)) {
    return;
  }
  $entities = entity_load($entity_type, [$entity_id]);
  if (empty($entities)) {
    return;
  }
  $entity = reset($entities);
  if (ai_moderation_uid_can_bypass(isset($entity->uid) ? (int) $entity->uid : 0)) {
    return;
  }
  $ids = entity_extract_ids($entity_type, $entity);
  $current_revision = $ids[1] ?? NULL;
  $revision_matches = empty($revision_id) || empty($current_revision) || (string) $revision_id === (string) $current_revision;
  $definitions = ai_moderation_get_entity_info();
  $extract = $definitions[$entity_type]['extract'] ?? '';
  $current_text = is_callable($extract) ? call_user_func($extract, $entity) : '';
  if (!$revision_matches || hash('sha256', (string) $current_text) !== $content_hash) {
    ai_moderation_rescan_entity_async($entity_type, $entity_id);
    return;
  }
  if ($entity_type === 'node' && (int) $entity->status !== NODE_NOT_PUBLISHED) {
    $entity->_ai_moderation_skip_gate = TRUE;
    $entity->status = NODE_NOT_PUBLISHED;
    node_save($entity);
  }
  elseif ($entity_type === 'comment' && (int) $entity->status !== COMMENT_NOT_PUBLISHED) {
    $entity->_ai_moderation_skip_gate = TRUE;
    $entity->status = COMMENT_NOT_PUBLISHED;
    comment_save($entity);
  }
}

/**
 * Check whether a specific account (not necessarily the current user) may
 * bypass automatic enforcement.
 */
function ai_moderation_uid_can_bypass($uid) {
  if (empty($uid)) {
    return FALSE;
  }
  $account = user_load($uid);
  return $account ? user_access('bypass ai moderation', $account) : FALSE;
}

/**
 * Process verdict observer notifications after their originating save commits.
 */
function ai_moderation_cron() {
  ai_moderation_load_include('evaluate');
  _ai_moderation_process_verdict_outbox();
}

/**
 * Implements the ai_moderation_entity_info hook for built-in entities.
 */
function ai_moderation_ai_moderation_entity_info() {
  $info = [];
  if (module_exists('node')) {
    $bundles = [];
    foreach (node_type_get_types() as $type => $node_type) {
      $bundles[$type] = $node_type->name;
    }
    $info['node'] = [
      'label' => t('Content'),
      'bundles' => $bundles,
      'extract' => 'ai_moderation_extract_node_text',
      'fields' => ['body'],
    ];
  }
  if (module_exists('comment')) {
    $bundles = [];
    foreach (node_type_get_names() as $type => $label) {
      $bundles['comment_node_' . $type] = t('@label comment', ['@label' => $label]);
    }
    $info['comment'] = [
      'label' => t('Comments'),
      'bundles' => $bundles,
      'extract' => 'ai_moderation_extract_comment_text',
      'fields' => ['comment_body'],
    ];
  }
  return $info;
}

/**
 * Return all entity types declared as moderatable.
 *
 * Earlier implementations win label, bundle-label, and extractor conflicts;
 * field allowlists are combined.
 */
function ai_moderation_get_entity_info() {
  $info = [];
  foreach ((array) module_implements('ai_moderation_entity_info') as $module) {
    $module_info = module_invoke($module, 'ai_moderation_entity_info');
    if (!is_array($module_info)) {
      continue;
    }
    foreach ($module_info as $entity_type => $definition) {
      if (!is_string($entity_type) || !is_array($definition)) {
        continue;
      }
      if (!isset($info[$entity_type])) {
        $info[$entity_type] = ['label' => $entity_type, 'bundles' => [], 'extract' => '', 'fields' => []];
      }
      if ($info[$entity_type]['label'] === $entity_type && !empty($definition['label']) && is_string($definition['label'])) {
        $info[$entity_type]['label'] = $definition['label'];
      }
      if (!empty($definition['bundles']) && is_array($definition['bundles'])) {
        foreach ($definition['bundles'] as $bundle => $label) {
          if (is_string($bundle) && is_string($label) && !isset($info[$entity_type]['bundles'][$bundle])) {
            $info[$entity_type]['bundles'][$bundle] = $label;
          }
        }
      }
      if (!empty($definition['fields']) && is_array($definition['fields'])) {
        $info[$entity_type]['fields'] = _ai_moderation_merge_entity_fields($info[$entity_type]['fields'], $definition['fields']);
      }
      if ($info[$entity_type]['extract'] === '' && !empty($definition['extract']) && is_string($definition['extract']) && is_callable($definition['extract'])) {
        $info[$entity_type]['extract'] = $definition['extract'];
      }
    }
  }
  return $info;
}

/**
 * Merge shared and per-bundle editorial field allowlists.
 */
function _ai_moderation_merge_entity_fields(array $existing, array $incoming) {
  foreach ($incoming as $bundle => $fields) {
    if (is_int($bundle)) {
      if (is_string($fields) && $fields !== '' && !in_array($fields, $existing, TRUE)) {
        $existing[] = $fields;
      }
    }
    elseif (is_string($bundle) && is_array($fields)) {
      $existing[$bundle] = isset($existing[$bundle]) && is_array($existing[$bundle]) ? $existing[$bundle] : [];
      foreach ($fields as $field_name) {
        if (is_string($field_name) && $field_name !== '' && !in_array($field_name, $existing[$bundle], TRUE)) {
          $existing[$bundle][] = $field_name;
        }
      }
    }
  }
  return $existing;
}

/**
 * Normalize a comment bundle to the entity-info naming convention.
 */
function _ai_moderation_comment_bundle($bundle) {
  $bundle = (string) $bundle;
  if ($bundle !== '' && strpos($bundle, 'comment_node_') !== 0) {
    $bundle = 'comment_node_' . $bundle;
  }
  return $bundle;
}

/**
 * Check whether verdicts can be durably stored for enforcement.
 */
function _ai_moderation_verdict_storage_available() {
  return db_table_exists('ai_moderation_verdicts')
    && db_table_exists('ai_moderation_verdict_events');
}

/**
 * Ensure an enforced block can be recorded before quarantining content.
 */
function _ai_moderation_enforcement_ready($verdict) {
  if (!is_array($verdict) || ($verdict['action'] ?? $verdict['verdict'] ?? '') !== 'block' || empty($verdict['enforce'])) {
    return FALSE;
  }
  if (!_ai_moderation_verdict_storage_available()) {
    watchdog('ai_moderation', 'Cannot quarantine content because verdict storage is unavailable.', [], WATCHDOG_ERROR);
    throw new RuntimeException('AI moderation verdict storage is unavailable.');
  }
  return TRUE;
}

/**
 * Extract title and text fields from a node without rendering HTML.
 */
function ai_moderation_extract_node_text($node) {
  $parts = [];
  if (!empty($node->title)) {
    $parts[] = $node->title;
  }
  $instances = field_info_instances('node', $node->type);
  foreach (array_keys($instances) as $field_name) {
    if (!ai_moderation_is_text_field('node', $node->type, $field_name)) {
      continue;
    }
    $items = field_get_items('node', $node, $field_name);
    if (empty($items)) {
      continue;
    }
    foreach ($items as $item) {
      foreach (['value', 'summary'] as $property) {
        if (!empty($item[$property]) && is_string($item[$property])) {
          $parts[] = html_entity_decode(strip_tags($item[$property]), ENT_QUOTES, 'UTF-8');
        }
      }
    }
  }
  return trim(implode("\n\n", array_unique($parts)));
}

/**
 * Extract subject and body fields from a comment without rendering HTML.
 */
function ai_moderation_extract_comment_text($comment) {
  $parts = [];
  if (!empty($comment->subject)) {
    $parts[] = $comment->subject;
  }
  $bundle = _ai_moderation_comment_bundle(!empty($comment->node_type) ? $comment->node_type : '');
  if ($bundle !== '') {
    foreach (array_keys(field_info_instances('comment', $bundle)) as $field_name) {
      if (!ai_moderation_is_text_field('comment', $bundle, $field_name)) {
        continue;
      }
      $items = field_get_items('comment', $comment, $field_name);
      if (empty($items)) {
        continue;
      }
      foreach ($items as $item) {
        foreach (['value', 'summary'] as $property) {
          if (!empty($item[$property]) && is_string($item[$property])) {
            $parts[] = html_entity_decode(strip_tags($item[$property]), ENT_QUOTES, 'UTF-8');
          }
        }
      }
    }
  }
  return trim(implode("\n\n", array_unique($parts)));
}

/**
 * Return the explicit public editorial field allowlist for a target.
 */
function ai_moderation_allowed_fields($entity_type, $bundle) {
  $configured = config_get('ai_moderation.settings', 'target_fields.' . $entity_type . '.' . $bundle);
  if (is_array($configured)) {
    return array_values(array_unique(array_filter(array_map('strval', $configured))));
  }
  $definitions = ai_moderation_get_entity_info();
  $fields = $definitions[$entity_type]['fields'] ?? [];
  $shared_fields = [];
  $bundle_fields = [];
  foreach ($fields as $field_bundle => $field_names) {
    if (is_int($field_bundle) && is_string($field_names) && $field_names !== '') {
      $shared_fields[] = $field_names;
    }
    elseif ($field_bundle === $bundle && is_array($field_names)) {
      $bundle_fields = array_merge($bundle_fields, $field_names);
    }
  }
  $allowed = array_merge($shared_fields, $bundle_fields);
  return array_values(array_unique(array_filter($allowed, 'is_string')));
}

/**
 * Allow only explicitly approved editorial text fields into extraction.
 */
function ai_moderation_is_text_field($entity_type, $bundle, $field_name) {
  if (!in_array($field_name, ai_moderation_allowed_fields($entity_type, $bundle), TRUE)) {
    return FALSE;
  }
  $field = field_info_field($field_name);
  $allowed_types = ['text', 'text_long', 'text_with_summary', 'string', 'string_long'];
  return !empty($field['type']) && in_array($field['type'], $allowed_types, TRUE);
}

/**
 * Apply enforcement for node saves using a verdict evaluated before save().
 *
 * Evaluation must happen before node_save() opens its persistence flow (see
 * ai_moderation_node_form_validate()). Presave never performs its own
 * provider evaluation; a save with no pending verdict is handled by
 * _ai_moderation_store_builtin_entity_verdict() after the save completes.
 */
function ai_moderation_node_presave($node) {
  if (empty($node->_ai_moderation_pending_verdict)) {
    return;
  }
  if (!_ai_moderation_pending_verdict_matches_entity('node', $node)) {
    unset($node->_ai_moderation_pending_verdict);
    unset($node->_ai_moderation_pending_context);
    return;
  }
  if (!ai_moderation_user_can_bypass() && _ai_moderation_enforcement_ready($node->_ai_moderation_pending_verdict)) {
    $node->status = NODE_NOT_PUBLISHED;
  }
}

/**
 * Confirm a pending verdict's content hash still matches the final entity.
 *
 * entity_form_submit_build_entity() only populates Field API values;
 * node_submit() and hook_node_submit() implementations can still transform
 * content afterward, and presave runs after that transformation. Re-extract
 * and re-hash the final text before trusting a verdict evaluated earlier.
 */
function _ai_moderation_pending_verdict_matches_entity($entity_type, $entity) {
  $context = $entity->_ai_moderation_pending_context ?? [];
  $expected_hash = $context['content_hash'] ?? NULL;
  if (empty($expected_hash)) {
    return TRUE;
  }
  $definitions = ai_moderation_get_entity_info();
  $extract = $definitions[$entity_type]['extract'] ?? '';
  if (!is_callable($extract)) {
    return TRUE;
  }
  $text = call_user_func($extract, $entity);
  return hash('sha256', (string) $text) === $expected_hash;
}

/**
 * Attach a verdict recorded during a new-node presave to its final ID.
 */
function ai_moderation_node_insert($node) {
  _ai_moderation_store_builtin_entity_verdict($node, 'node', !empty($node->nid) ? $node->nid : 0);
}

/**
 * Store a node verdict after an update has succeeded.
 */
function ai_moderation_node_update($node) {
  _ai_moderation_store_builtin_entity_verdict($node, 'node', !empty($node->nid) ? $node->nid : 0);
}

/**
 * Apply enforcement for comment saves using a verdict evaluated before save().
 *
 * Evaluation must happen before comment_save() opens its persistence flow
 * (see ai_moderation_comment_form_validate()). Presave never performs its
 * own provider evaluation; a save with no pending verdict is handled by
 * _ai_moderation_store_builtin_entity_verdict() after the save completes.
 */
function ai_moderation_comment_presave($comment) {
  if (empty($comment->_ai_moderation_pending_verdict)) {
    return;
  }
  if (!_ai_moderation_pending_verdict_matches_entity('comment', $comment)) {
    unset($comment->_ai_moderation_pending_verdict);
    unset($comment->_ai_moderation_pending_context);
    return;
  }
  if (!ai_moderation_user_can_bypass() && _ai_moderation_enforcement_ready($comment->_ai_moderation_pending_verdict)) {
    $comment->status = COMMENT_NOT_PUBLISHED;
  }
}

/**
 * Attach a verdict recorded during a new-comment presave to its final ID.
 */
function ai_moderation_comment_insert($comment) {
  _ai_moderation_store_builtin_entity_verdict($comment, 'comment', !empty($comment->cid) ? $comment->cid : 0);
}

/**
 * Store a comment verdict after an update has succeeded.
 */
function ai_moderation_comment_update($comment) {
  _ai_moderation_store_builtin_entity_verdict($comment, 'comment', !empty($comment->cid) ? $comment->cid : 0);
}

/**
 * Implements hook_form_alter().
 *
 * Enforcement must happen during validation. A presave hook runs after the
 * form submit handler has started saving and cannot reliably stop that save.
 */
function ai_moderation_form_alter(&$form, &$form_state, $form_id) {
  ai_moderation_load_include('evaluate');
  if (!empty($form['#node']) && substr($form_id, -10) === '_node_form' && !empty($form['actions']['submit'])) {
    $form['actions']['submit']['#validate'] = array_merge(
      !empty($form['actions']['submit']['#validate']) ? $form['actions']['submit']['#validate'] : $form['#validate'],
      ['ai_moderation_node_form_validate']
    );
  }
  elseif (!empty($form_state['comment']) && strpos($form_id, 'comment_node_') === 0 && substr($form_id, -5) === '_form' && !empty($form['actions']['submit'])) {
    $form['actions']['submit']['#validate'] = array_merge(
      !empty($form['actions']['submit']['#validate']) ? $form['actions']['submit']['#validate'] : $form['#validate'],
      ['ai_moderation_comment_form_validate']
    );
  }
}

/**
 * Evaluate an enabled node target before node_form_submit() saves it.
 */
function ai_moderation_node_form_validate($form, &$form_state) {
  $submit_handlers = (array) ($form_state['triggering_element']['#submit'] ?? []);
  if (in_array('node_form_preview', $submit_handlers, TRUE)) {
    return;
  }
  if (ai_moderation_user_can_bypass()) {
    return;
  }
  if (form_get_errors()) {
    return;
  }
  $node = clone $form_state['node'];
  entity_form_submit_build_entity('node', $node, $form, $form_state);
  $verdict = _ai_moderation_validate_builtin_entity('node', $node->type, $node);
  if (!empty($node->_ai_moderation_pending_verdict)) {
    $form_state['node']->_ai_moderation_pending_verdict = $node->_ai_moderation_pending_verdict;
    $form_state['node']->_ai_moderation_pending_context = $node->_ai_moderation_pending_context;
  }
  if (_ai_moderation_enforcement_ready($verdict)) {
    $form_state['values']['status'] = NODE_NOT_PUBLISHED;
    backdrop_set_message(t('Your submission was saved unpublished and sent to moderation review.'), 'warning');
  }
}

/**
 * Evaluate an enabled comment target before comment_form_submit() saves it.
 */
function ai_moderation_comment_form_validate($form, &$form_state) {
  $submit_handlers = (array) ($form_state['triggering_element']['#submit'] ?? []);
  if (in_array('comment_form_build_preview', $submit_handlers, TRUE)) {
    return;
  }
  if (ai_moderation_user_can_bypass()) {
    return;
  }
  if (form_get_errors()) {
    return;
  }
  $comment = clone $form_state['comment'];
  entity_form_submit_build_entity('comment', $comment, $form, $form_state);
  // Match the entity shape used by comment_form_submit() and presave.
  comment_submit($comment);
  $bundle = _ai_moderation_comment_bundle(!empty($comment->node_type) ? $comment->node_type : '');
  $verdict = _ai_moderation_validate_builtin_entity('comment', $bundle, $comment);
  if (!empty($comment->_ai_moderation_pending_verdict)) {
    $form_state['comment']->_ai_moderation_pending_verdict = $comment->_ai_moderation_pending_verdict;
    $form_state['comment']->_ai_moderation_pending_context = $comment->_ai_moderation_pending_context;
  }
  if (_ai_moderation_enforcement_ready($verdict)) {
    $form_state['values']['status'] = COMMENT_NOT_PUBLISHED;
    backdrop_set_message(t('Your reply was saved unpublished and sent to moderation review.'), 'warning');
  }
}

/**
 * Return a verdict for form-time quarantine when an enforced target blocks.
 */
function _ai_moderation_validate_builtin_entity($entity_type, $bundle, $entity) {
  ai_moderation_load_include('evaluate');
  $config = config('ai_moderation.settings');
  $profile_id = $config->get('targets.' . $entity_type . '.' . $bundle);
  if (empty($profile_id)) {
    return;
  }
  $entity_id = 0;
  if ($entity_type === 'node' && !empty($entity->nid)) {
    $entity_id = (int) $entity->nid;
  }
  elseif ($entity_type === 'comment' && !empty($entity->cid)) {
    $entity_id = (int) $entity->cid;
  }
  $verdict = _ai_moderation_gate_builtin_entity($entity_type, $bundle, $entity_id, $entity);
  if (empty($verdict['enforce'])) {
    return NULL;
  }
  return $verdict;
}

/**
 * Evaluate the configured built-in target and attach a pending verdict.
 *
 * Never stores a verdict. Evaluation must happen before save() opens its
 * persistence flow; _ai_moderation_store_builtin_entity_verdict() persists
 * the pending verdict this attaches once the save succeeds.
 */
function _ai_moderation_gate_builtin_entity($entity_type, $bundle, $entity_id, $entity) {
  ai_moderation_load_include('evaluate');
  $config = config('ai_moderation.settings');
  $profile = $config->get('targets.' . $entity_type . '.' . $bundle);
  if (empty($profile)) {
    return;
  }
  $profiles = $config->get('profiles') ?: [];
  if (!isset($profiles[$profile]) && !($profile === 'default' && empty($profiles))) {
    watchdog('ai_moderation', 'Target references an unknown moderation profile: @profile.', ['@profile' => $profile], WATCHDOG_ERROR);
    throw new RuntimeException('The configured moderation profile is unavailable.');
  }
  $info = ai_moderation_get_entity_info();
  $extract = !empty($info[$entity_type]['extract']) ? $info[$entity_type]['extract'] : '';
  if (!is_callable($extract)) {
    watchdog('ai_moderation', 'No text extractor is available for @type:@bundle.', ['@type' => $entity_type, '@bundle' => $bundle], WATCHDOG_ERROR);
    return;
  }
  $text = call_user_func($extract, $entity);
  if ($text === '') {
    return NULL;
  }
  $cache = &backdrop_static('ai_moderation_builtin_verdicts', []);
  $cache_key = $entity_type . ':' . $bundle . ':' . $entity_id . ':' . $profile . ':' . hash('sha256', $text);
  $context = [
    'entity_type' => $entity_type,
    'entity_bundle' => $bundle,
    'entity_id' => (string) $entity_id,
    'entity_revision' => NULL,
    'content_hash' => hash('sha256', (string) $text),
    'text_length' => strlen($text),
    'profile' => $profile,
  ];
  if (isset($cache[$cache_key])) {
    $verdict = $cache[$cache_key];
  }
  else {
    $verdict = _ai_moderation_evaluate($text, ['profile' => $profile]);
    backdrop_alter('ai_moderation_verdict', $verdict, $context);
    $cache[$cache_key] = $verdict;
  }
  if (empty($verdict)) {
    return NULL;
  }
  $entity->_ai_moderation_pending_verdict = $verdict;
  $entity->_ai_moderation_pending_context = $context;
  return $verdict;
}

/**
 * Store a cached node verdict only after its save has succeeded.
 *
 * A save that reaches here without a pending verdict skipped preflight
 * evaluation (e.g. a programmatic save that bypassed the moderation form).
 * Rather than silently skip a configured target or evaluate synchronously
 * after the fact, this queues an async re-scan; if that is unavailable, it
 * logs an explicit warning so the gap is visible instead of silent.
 */
function _ai_moderation_store_builtin_entity_verdict($entity, $entity_type, $entity_id) {
  if (!empty($entity->_ai_moderation_skip_gate)) {
    unset($entity->_ai_moderation_skip_gate);
    return;
  }
  $bundle = $entity_type === 'node' ? $entity->type : _ai_moderation_comment_bundle($entity->node_type);
  $config = config('ai_moderation.settings');
  $profile_id = $config->get('targets.' . $entity_type . '.' . $bundle);
  if (empty($profile_id)) {
    return;
  }
  if (empty($entity->_ai_moderation_pending_verdict)) {
    if (!empty($entity_id) && ai_moderation_rescan_entity_async($entity_type, $entity_id) === FALSE) {
      watchdog('ai_moderation', 'Skipped moderation for @type:@id because no preflight verdict was evaluated and AI Async is unavailable to queue a re-scan.', ['@type' => $entity_type, '@id' => $entity_id], WATCHDOG_WARNING);
    }
    return;
  }
  if (empty($entity_id)) {
    throw new RuntimeException('AI moderation verdict cannot be stored without a final entity ID.');
  }
  $context = $entity->_ai_moderation_pending_context ?? [
    'entity_type' => $entity_type,
    'entity_bundle' => $bundle,
    'entity_id' => (string) $entity_id,
    'entity_revision' => !empty($entity->vid) ? (string) $entity->vid : NULL,
    'content_hash' => NULL,
    'text_length' => 0,
    'profile' => $profile_id,
  ];
  $context['entity_id'] = (string) $entity_id;
  if ($entity_type === 'node' && !empty($entity->vid)) {
    $context['entity_revision'] = (string) $entity->vid;
  }
  $verdict = _ai_moderation_store_verdict($entity->_ai_moderation_pending_verdict, $context, $config);
  unset($entity->_ai_moderation_pending_verdict);
  unset($entity->_ai_moderation_pending_context);
  return $verdict;
}

/**
 * Implements hook_ai_tools().
 */
function ai_moderation_ai_tools() {
  return [
    'moderate_text' => [
      'definition' => [
        'type' => 'function',
        'function' => [
          'name' => 'moderate_text',
          'description' => 'Evaluate text against a configured AI moderation profile.',
          'parameters' => [
            'type' => 'object',
            'properties' => [
              'text' => ['type' => 'string', 'description' => 'Untrusted text to evaluate.'],
              'profile' => ['type' => 'string', 'description' => 'Optional moderation profile ID.'],
            ],
            'required' => ['text'],
          ],
        ],
      ],
      'execute' => 'ai_moderation_tools_execute_moderate_text',
      'module' => 'ai_moderation',
      'category' => 'moderation',
      'operation' => 'read',
      'destructive' => FALSE,
      'permission' => 'access ai moderation',
    ],
  ];
}

/**
 * Execute the public AI tool. This path never gates entity submission.
 */
function ai_moderation_tools_execute_moderate_text(array $arguments) {
  return ai_moderation_evaluate($arguments['text'] ?? '', [
    'profile' => $arguments['profile'] ?? '',
  ]);
}
