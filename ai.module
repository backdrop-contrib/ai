 */

/**
 * Implements hook_config_info().
 */
function ai_config_info() {
  return [
    'ai.settings' => [
      'label' => t('AI Settings'),
      'group' => t('AI'),
    ],
  ];
}

/**
 * Implements hook_autoload_info().
 */
function ai_autoload_info() {
  return [
    'AIProviderClient' => 'includes/AIProviderClient.php',
    'AIAdapterBase' => 'includes/AIAdapterBase.php',
    'AIApi' => 'includes/AIApi.php',
    'AIException' => 'includes/AIException.php',
    'AIConfigurationException' => 'includes/AIConfigurationException.php',
    'AIRateLimitException' => 'includes/AIRateLimitException.php',
    'AIUnsupportedCapabilityException' => 'includes/AIUnsupportedCapabilityException.php',
    'AIProviderResponseException' => 'includes/AIProviderResponseException.php',
    'AICompatibleTrait' => 'includes/AICompatibleTrait.php',
    'AIContentExtractor' => 'includes/AIContentExtractor.php',
    'AILog' => 'includes/AILog.inc',
    'AIStreamingResponse' => 'includes/AIStreamingResponse.php',
    'AIStringHelper' => 'includes/AIStringHelper.php',
  ];
}

/**
 * Implements hook_entity_info().
 */
function ai_entity_info() {
  $info['ai_log'] = [
    'label' => t('AI Log'),
    'controller class' => 'DefaultEntityController',
    'entity class' => 'AILog',
    'base table' => 'ai_log',
    'entity keys' => [
      'id' => 'id',
    ],
    'module' => 'ai',
  ];

  return $info;
}

/**
 * Load a single log entry.
 */
function ai_log_load($id) {
  $log = entity_load('ai_log', [$id]);
  return $log ? reset($log) : FALSE;
}

/**
 * Implements hook_menu().
 */
