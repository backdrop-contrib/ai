<?php

define('AI_EXPLORER_MAX_AUDIO_BYTES', 26214400);
define('AI_EXPLORER_MAX_CHAT_INPUT', 8000);
define('AI_EXPLORER_MAX_CHAT_HISTORY', 12);
define('AI_EXPLORER_MAX_CHAT_TOKENS', 4096);

/**
 * @file
 * Combined AI explorer for speech-to-text and text-to-speech tools.
 */

/**
 * Implements hook_permission().
 */
function ai_explorer_permission() {
  return [
    'access ai explorer' => [
      'title' => t('Use the AI explorer module.'),
    ],
  ];
}

