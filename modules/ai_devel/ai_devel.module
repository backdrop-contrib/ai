<?php

define('AI_DEVEL_MAX_NODES_PER_TYPE', 100);
define('AI_DEVEL_MAX_TOTAL_NODES', 500);
define('AI_DEVEL_MAX_COMMENTS_PER_NODE', 20);
define('AI_DEVEL_MAX_TOKENS', 4096);
define('AI_DEVEL_MAX_SYSTEM_LENGTH', 4000);

/**
 * Implements hook_menu().
 */
function ai_devel_menu() {
  $items = [];

  $items['admin/config/ai/ai-devel'] = [
    'title' => 'AI Content Generator',
    'description' => 'Generate content using AI',
    'page callback' => 'backdrop_get_form',
    'page arguments' => ['ai_devel_generate_content_form'],
    'access arguments' => ['administer site configuration'],
    'type' => MENU_NORMAL_ITEM,
  ];

  $items['admin/config/ai/ai-devel/settings'] = [
    'title' => 'Generator',
    'type' => MENU_DEFAULT_LOCAL_TASK,
  ];

  return $items;
}

/**
 * Form for generating content using AI's GPT services.
 */
function ai_devel_generate_content_form($form, &$form_state) {

  // Get all chat models from all enabled providers
  $models_grouped = ai_get_all_chat_models();

  // Flatten grouped models since labels already include provider prefix.
  $models = function_exists('ai_flatten_models') ? ai_flatten_models($models_grouped) : [];

  if (empty($models)) {
    form_set_error('', t('No chat models available. Please configure at least one provider in AI settings.'));
    return $form;
  }

  // AI settings.
  $form['ai_model'] = [
    '#type' => 'select',
    '#title' => t('Model'),
    '#options' => $models,
    '#default_value' => ai_devel_resolve_model(config_get('ai.settings', 'default_text_model')),
    '#description' => t('Select which model to use to generate text from any enabled provider.'),
    '#required' => TRUE,
  ];
  $form['ai_system'] = [
    '#type' => 'textarea',
    '#title' => t('Profile'),
    '#default_value' => 'Your task is to generate content. I would like you to generate content about various topics.',
    '#description' => t('The "system profile" helps set the behavior of the ChatGPT response.'),
    '#required' => TRUE,
    '#maxlength' => AI_DEVEL_MAX_SYSTEM_LENGTH,
  ];

  $form['ai_temperature'] = [
    '#type' => 'number',
    '#title' => t('Temperature'),
    '#min' => 0,
    '#max' => 2,
    '#step' => .1,
    '#default_value' => '0.7',
    '#description' => t('Sampling temperature to use, between 0 and 2. Higher values make output more random.'),
  ];

  $form['ai_max_tokens'] = [
    '#type' => 'number',
    '#title' => t('Max tokens'),
    '#min' => 1,
    '#max' => AI_DEVEL_MAX_TOKENS,
    '#default_value' => '512',
    '#description' => t("The maximum number of tokens to generate in the response."),
  ];

  $form['ai_html'] = [
    '#type' => 'checkbox',
    '#title' => t('HTML formatted'),
    '#default_value' => FALSE,
    '#description' => t('If TRUE, AI will format the replies in basic HTML.'),
  ];

  // Adding original devel_generate fields
  $options = [];
  $types = node_type_get_types();
  $suffix = '';
  foreach ($types as $type) {
    if (module_exists('comment')) {
      $default = $type->settings['comment_default'];
      $map = [t('Hidden'), t('Closed'), t('Open')];
      $suffix = ' <small>('. t('Comments: ') . $map[$default]. ']</small>';
    }
    $options[$type->type] = t($type->name) . $suffix;
  }

  if (empty($options)) {
    backdrop_set_message(t('You do not have any content types that can be generated. <a href="@create-type">Go create a new content type</a> first.', ['@create-type' => url('admin/structure/types/add')]), 'error', FALSE);
    return $form;
  }

  $form['node_types'] = [
    '#type' => 'checkboxes',
    '#title' => t('Content types'),
    '#options' => $options,
    '#default_value' => array_keys($options),
  ];
  if (module_exists('checkall')) $form['node_types']['#checkall'] = TRUE;

  $form['kill_content'] = [
    '#type' => 'checkbox',
    '#title' => t('<strong>Delete all content</strong> in these content types before generating new content.'),
    '#default_value' => FALSE,
  ];

  $form['kill_content_confirm'] = [
    '#type' => 'textfield',
    '#title' => t('Deletion confirmation'),
    '#description' => t('If deleting existing content, type DELETE to confirm.'),
    '#default_value' => '',
    '#maxlength' => 6,
  ];
  $form['num_nodes'] = [
    '#type' => 'number',
    '#title' => t('How many nodes would you like to generate?'),
    '#description' => t('Generated nodes are saved unpublished for review.'),
    '#default_value' => 15,
    '#min' => 1,
    '#max' => AI_DEVEL_MAX_NODES_PER_TYPE,
  ];

  $options = [1 => t('Now')];
  foreach ([3600, 86400, 604800, 2592000, 31536000] as $interval) {
    $options[$interval] = format_interval($interval, 1) . ' ' . t('ago');
  }
  $form['time_range'] = [
    '#type' => 'select',
    '#title' => t('How far back in time should the nodes be dated?'),
    '#description' => t('Node creation dates will be distributed randomly from the current time, back to the selected time.'),
    '#options' => $options,
    '#default_value' => 31536000,
  ];

  $form['max_comments'] = [
    '#type' => module_exists('comment') ? 'number' : 'value',
    '#title' => t('Maximum number of comments per node.'),
    '#description' => t('Only content types that have comments enabled will receive comments. Note that some nodes will randomly receive zero comments. Some will receive the max.'),
    '#default_value' => 0,
    '#min' => 0,
    '#max' => AI_DEVEL_MAX_COMMENTS_PER_NODE,
    '#access' => module_exists('comment'),
  ];

  $form['title_length'] = [
    '#type' => 'number',
    '#title' => t('Maximum number of words in titles'),
    '#default_value' => 4,
    '#min' => 1,
    '#max' => 100,
    '#description' => t('Set the maximum number of words for generated titles.'),
  ];

  $form['add_alias'] = [
    '#type' => 'checkbox',
    '#disabled' => !module_exists('path'),
    '#description' => t('Content types will use the default patterns when generated. Checking this box will add a custom alias to all content types that do not have a pattern specified.'),
    '#title' => t('Ensure all content has a URL alias.'),
    '#default_value' => FALSE,
  ];

  unset($options);
  $options[LANGUAGE_NONE] = t('Language neutral');
  if (module_exists('locale')) {
    $languages = language_list(TRUE);
    foreach ($languages as $language) {
      $options[$language->langcode] = $language->name;
    }
  }
  $form['add_language'] = [
    '#type' => 'checkboxes',
    '#title' => t('Set language on nodes'),
    '#multiple' => TRUE,
    '#access' => module_exists('locale'),
    '#description' => t('Requires locale.module'),
    '#options' => $options,
    '#default_value' => [LANGUAGE_NONE],
  ];

  $form['submit'] = [
    '#type' => 'submit',
    '#value' => t('Generate'),
  ];
  $form['#redirect'] = FALSE;
  $form['#validate'][] = 'ai_devel_generate_content_form_validate';

  return $form;
}

/**
 * Validate form values before any destructive or billable operation.
 */
function ai_devel_generate_content_form_validate($form, &$form_state) {
  $options = ai_devel_normalize_options([
    'node_types' => array_filter($form_state['values']['node_types']),
    'num_nodes' => $form_state['values']['num_nodes'],
    'system' => $form_state['values']['ai_system'],
    'model' => $form_state['values']['ai_model'],
    'temperature' => $form_state['values']['ai_temperature'],
    'max_tokens' => $form_state['values']['ai_max_tokens'],
    'max_comments' => $form_state['values']['max_comments'],
    'time_range' => $form_state['values']['time_range'],
    'languages' => array_filter($form_state['values']['add_language']),
    'title_length' => $form_state['values']['title_length'],
  ], $error);
  if (!$options) {
    form_set_error('', $error);
  }
  if (!empty($form_state['values']['kill_content']) && strtoupper(trim($form_state['values']['kill_content_confirm'])) !== 'DELETE') {
    form_set_error('kill_content_confirm', t('Type DELETE to confirm removing existing content.'));
  }
}

/**
 * Form submission handler.
 */
function ai_devel_generate_content_form_submit($form, &$form_state) {
  if (!empty($form_state['values']['kill_content']) && strtoupper(trim($form_state['values']['kill_content_confirm'])) !== 'DELETE') {
    form_set_error('kill_content_confirm', t('Type DELETE to confirm removing existing content.'));
    return;
  }
  $options = [
    'node_types' => array_filter($form_state['values']['node_types']),
    'num_nodes' => $form_state['values']['num_nodes'],
    'system' => $form_state['values']['ai_system'],
    'model' => $form_state['values']['ai_model'],
    'temperature' => $form_state['values']['ai_temperature'],
    'max_tokens' => $form_state['values']['ai_max_tokens'],
    'add_alias' => $form_state['values']['add_alias'],
    'max_comments' => $form_state['values']['max_comments'],
    'time_range' => $form_state['values']['time_range'],
    'languages' => array_filter($form_state['values']['add_language']),
    'title_length' => $form_state['values']['title_length'],
    'html' => !empty($form_state['values']['ai_html']),
  ];

  // Handle content deletion if selected.
  if ($form_state['values']['kill_content'] && !empty($options['node_types'])) {
    $nids = db_query("SELECT nid FROM {node} WHERE type IN (:types)", [':types' => $options['node_types']])->fetchCol();
    if ($nids) {
      node_delete_multiple($nids);
      backdrop_set_message(t('Deleted @count nodes.', ['@count' => count($nids)]));
    }
  }
  // Generate content.
  $total_created = ai_devel_generate_content($options);

  backdrop_set_message(t('Created @count nodes.', ['@count' => $total_created]));
}


/**
 * Generates content using AI.
 */
function ai_devel_generate_content($options) {
  $options = ai_devel_normalize_options($options, $error);
  if (!$options) {
    watchdog('ai_devel', 'Generation rejected: @message', ['@message' => $error], WATCHDOG_WARNING);
    return 0;
  }
  $node_types = $options['node_types'];
  $system = $options['system'];
  $model = $options['model'];
  $temperature = $options['temperature'];
  $max_tokens = $options['max_tokens'];
  $add_alias = $options['add_alias'];
  $num_nodes = $options['num_nodes'];
  $max_comments = $options['max_comments'];
  $time_range = $options['time_range'];
  $languages = $options['languages'];
  $title_length = $options['title_length'];
  $html = $options['html'];

  $total_created = 0;

  foreach ($node_types as $type) {
    for ($i = 0; $i < $num_nodes; $i++) {
      try {
        // Include title length in the prompt for AI.
        $system_message = $system . " Generate unique content for type '$type'. The title should have approximately $title_length words and should not include the word 'title'.";
        $unique_prompt = "Generate unique and relevant content for a '{$type}' node. The title should be $title_length words and must not include the word 'title'.
            Ensure the content is engaging and contains several paragraphs. Incorporate specific details or examples to make it stand out.
            Make this one distinct from any others by focusing on a specific perspective, historical detail, or novel idea.";

        // Use the centralized helper
        $response = ai_chat(
          $model,
          [
            ['role' => 'system', 'content' => $system_message],
            ['role' => 'user', 'content' => $unique_prompt],
          ],
          $temperature,
          $max_tokens
        );

        list($title, $body) = ai_devel_extract_title_and_body($response);
        if (!$html) {
          $title = trim(strip_tags($title));
          $body_format = 'plain_text';
        }
        else {
          $body_format = 'full_html';
        }


        // Set language for the node.
        $langcode = LANGUAGE_NONE;
        if (!empty($languages)) {
          $langcode = array_rand($languages);
        }

        // Create node.
        $node = new Node([
          'type' => $type,
          'title' => $title,
          'body' => [
            $langcode => [
              [
                'value' => $body,
                'format' => $body_format,
              ],
            ],
          ],
          'uid' => !empty($GLOBALS['user']->uid) ? $GLOBALS['user']->uid : 1,
          'status' => 0,
          'created' => REQUEST_TIME - mt_rand(0, $time_range),
        ]);

        $node->save();

        // Add URL alias if required.
        if ($add_alias) {
          $path_alias = [
            'source' => '/node/' . $node->nid,
            'alias' => '/generated-' . strtolower($type) . '-' . $node->nid,
          ];
          path_save($path_alias); // Pass array directly without reference.
        }


        // Add comments if required.
        if ($max_comments > 0 && $node->comment == COMMENT_NODE_OPEN) {
          for ($c = 0; $c < $max_comments; $c++) {
            $comment = new Comment([
              'nid' => $node->nid,
              'uid' => 1,
              'subject' => t('Generated Comment'),
              'comment_body' => [
                $langcode => [
                  [
                    'value' => 'This is a generated comment.',
                    'format' => 'plain_text',
                  ],
                ],
              ],
              'status' => 1,
              'created' => REQUEST_TIME - mt_rand(0, 3600),
            ]);
            $comment->save();
          }
        }

        $total_created++;
      }
      catch (\Throwable $e) {
        watchdog('ai_devel', 'Error: @message', ['@message' => $e->getMessage()], WATCHDOG_ERROR);
      }
    }
  }

  return $total_created;
}

/**
 * Clean the body text by removing unnecessary artifacts.
 */
function ai_devel_extract_title_and_body($response) {
  $response = ai_devel_response_text($response);
  // Split the response into lines.
  $lines = explode("\n", $response);

  // Assume the first non-empty line is the title.
  $title = '';
  foreach ($lines as $line) {
    $line = trim($line);
    if (!empty($line)) {
      $title = $line;
      break;
    }
  }

  // Remove artifacts like "Title:" or "The title is".
  $title = preg_replace('/\btitle\b/i', '', $title);
  $title = preg_replace('/[:\-]+$/', '', $title); // Remove trailing punctuation.

  // Rejoin the remaining lines as the body.
  $body = implode("\n", array_slice($lines, 1));

  return [trim($title), trim($body)];
}

/**
 * Resolve an enabled provider-qualified chat model.
 */
function ai_devel_resolve_model($requested = '') {
  $grouped = ai_get_all_chat_models();
  $models = function_exists('ai_flatten_models') ? ai_flatten_models($grouped) : [];
  if (empty($models)) {
    return '';
  }
  if ($requested && isset($models[$requested])) {
    return $requested;
  }
  if ($requested) {
    list($provider, $bare) = ai_parse_model_id($requested);
    foreach (array_keys($models) as $model_id) {
      list($model_provider, $model_name) = ai_parse_model_id($model_id);
      if ($model_name === $bare && (!$provider || $provider === $model_provider)) {
        return $model_id;
      }
    }
  }
  return ai_default_model($grouped, config_get('ai.settings', 'default_text_model'), ['gpt-4o-mini', 'gpt-3.5-turbo']) ?: '';
}

/**
 * Normalize and validate options shared by the form and Bee command.
 */
function ai_devel_normalize_options(array $options, &$error = '') {
  $types = node_type_get_types();
  $node_types = array_values(array_filter(array_map('trim', (array) ($options['node_types'] ?? []))));
  $node_types = array_values(array_intersect($node_types, array_keys($types)));
  if (empty($node_types)) {
    $error = t('Select at least one valid content type.');
    return FALSE;
  }

  $model = ai_devel_resolve_model($options['model'] ?? '');
  if (!$model) {
    $error = t('Select an enabled chat model.');
    return FALSE;
  }
  $num_nodes = (int) ($options['num_nodes'] ?? 1);
  $max_comments = (int) ($options['max_comments'] ?? 0);
  $max_tokens = (int) ($options['max_tokens'] ?? 512);
  $temperature = (float) ($options['temperature'] ?? 0.7);
  $system = trim((string) ($options['system'] ?? ''));
  if ($num_nodes < 1 || $num_nodes > AI_DEVEL_MAX_NODES_PER_TYPE || $max_comments < 0 || $max_comments > AI_DEVEL_MAX_COMMENTS_PER_NODE || $max_tokens < 1 || $max_tokens > AI_DEVEL_MAX_TOKENS || $temperature < 0 || $temperature > 2 || $system === '' || strlen($system) > AI_DEVEL_MAX_SYSTEM_LENGTH) {
    $error = t('Generation settings are outside the allowed limits.');
    return FALSE;
  }
  if (count($node_types) * $num_nodes > AI_DEVEL_MAX_TOTAL_NODES) {
    $error = t('The requested generation batch exceeds the maximum of @max nodes.', ['@max' => AI_DEVEL_MAX_TOTAL_NODES]);
    return FALSE;
  }

  return [
    'node_types' => $node_types,
    'system' => $system,
    'model' => $model,
    'temperature' => $temperature,
    'max_tokens' => $max_tokens,
    'add_alias' => !empty($options['add_alias']),
    'num_nodes' => $num_nodes,
    'max_comments' => $max_comments,
    'time_range' => max(0, (int) ($options['time_range'] ?? 0)),
    'languages' => array_filter((array) ($options['languages'] ?? [])),
    'title_length' => max(1, min(100, (int) ($options['title_length'] ?? 4))),
    'html' => !empty($options['html']),
  ];
}

/**
 * Extract text from common provider response shapes.
 */
function ai_devel_response_text($response) {
  if (is_string($response) || is_numeric($response)) {
    return (string) $response;
  }
  if (!is_array($response)) {
    return '';
  }
  foreach (['output_text', 'text', 'content'] as $key) {
    if (isset($response[$key]) && (is_string($response[$key]) || is_numeric($response[$key]))) {
      return (string) $response[$key];
    }
  }
  if (isset($response['choices'][0])) {
    return ai_devel_response_text($response['choices'][0]);
  }
  if (isset($response['message']['content'])) {
    return ai_devel_response_text($response['message']['content']);
  }
  return '';
}
