<?php

/**
 * @file
 * Tests for AI Assistant API.
 */

class AIAssistantTestCase extends BackdropWebTestCase {

  public function setUp() {
    parent::setUp(['ai', 'ai_tools', 'ai_agent', 'ai_agent_test', 'ai_assistant']);

    $providers = config('ai.settings');
    $providers->set('providers', [
      'agent_test' => [
        'enabled' => 1,
      ],
    ]);
    $providers->save();

    ai_agent_save_agents([
      'assistant_test_agent' => [
        'label' => 'Assistant Test Agent',
        'description' => 'Deterministic agent for assistant API coverage.',
        'system_prompt' => 'You are an assistant test agent.',
        'secured_system_prompt' => 'Return exact final answer only.',
        'model' => 'agent_test/gpt-4o-mini',
        'temperature' => 0.0,
        'max_tokens' => 128,
        'max_loops' => 3,
        'tools' => ['test_echo_message'],
      ],
      'assistant_test_agent_two' => [
        'label' => 'Assistant Test Agent Two',
        'description' => 'Second deterministic agent for assistant API coverage.',
        'system_prompt' => 'You are a second assistant test agent.',
        'secured_system_prompt' => 'Return exact final answer only.',
        'model' => 'agent_test/gpt-4o-mini',
        'temperature' => 0.0,
        'max_tokens' => 128,
        'max_loops' => 3,
        'tools' => ['test_echo_message'],
      ],
      'assistant_approval_agent' => [
        'label' => 'Assistant Approval Agent',
        'description' => 'Deterministic agent for assistant approval coverage.',
        'system_prompt' => 'You are an approval test agent.',
        'secured_system_prompt' => 'Return exact final answer only.',
        'model' => 'agent_test/gpt-4o-mini',
        'temperature' => 0.0,
        'max_tokens' => 128,
        'max_loops' => 3,
        'tools' => ['test_write_message'],
        'tool_settings' => [
          'test_write_message' => [
            'forced_params' => [
              'channel' => '#content-team',
            ],
            'hidden_params' => [
              'channel',
            ],
          ],
        ],
      ],
      'content_type_agent' => [
        'label' => 'Content Type Agent',
        'description' => 'Deterministic content type agent for assistant routing coverage.',
        'system_prompt' => 'You are a content type specialist.',
        'secured_system_prompt' => 'Return exact final answer only.',
        'model' => 'agent_test/gpt-4o-mini',
        'temperature' => 0.0,
        'max_tokens' => 128,
        'max_loops' => 4,
        'tools' => ['list_content_types', 'get_content_type_info', 'create_content_type', 'edit_content_type'],
      ],
      'field_agent' => [
        'label' => 'Field Agent',
        'description' => 'Deterministic field agent for assistant routing coverage.',
        'system_prompt' => 'You are a field specialist.',
        'secured_system_prompt' => 'Return exact final answer only.',
        'model' => 'agent_test/gpt-4o-mini',
        'temperature' => 0.0,
        'max_tokens' => 128,
        'max_loops' => 4,
        'tools' => ['list_content_types', 'list_field_types', 'create_field_storage', 'create_field_instance'],
      ],
      'taxonomy_agent' => [
        'label' => 'Taxonomy Agent',
        'description' => 'Deterministic taxonomy agent for assistant routing coverage.',
        'system_prompt' => 'You are a taxonomy specialist.',
        'secured_system_prompt' => 'Return exact final answer only.',
        'model' => 'agent_test/gpt-4o-mini',
        'temperature' => 0.0,
        'max_tokens' => 128,
        'max_loops' => 4,
        'tools' => ['get_vocabularies'],
      ],
    ]);

    $type = (object) [
      'type' => 'this_is_cool',
      'name' => 'This is Cool!',
      'description' => 'A content type for sharing cool things.',
      'help' => 'Use this content type to share interesting and cool content.',
      'title_label' => 'Title',
      'base' => 'node_content',
      'custom' => 1,
      'is_new' => TRUE,
      'modified' => 1,
      'locked' => 0,
    ];
    node_type_save($type);
    node_add_body_field($type);
    node_type_cache_reset();
    field_info_cache_clear();
    entity_info_cache_clear();

    ai_assistant_save_assistants([
      'assistant_test' => [
        'label' => 'Assistant Test',
        'route_mode' => 'single_agent',
        'agent_id' => 'assistant_test_agent',
        'thread_storage' => 'session',
        'thread_ttl' => 0,
        'allowed_roles' => [],
        'status_events' => FALSE,
      ],
      'assistant_direct' => [
        'label' => 'Assistant Direct',
        'route_mode' => 'direct',
        'model' => 'agent_test/gpt-4o-mini',
        'thread_storage' => 'session',
        'thread_ttl' => 0,
        'allowed_roles' => [],
        'status_events' => FALSE,
      ],
      'assistant_multi' => [
        'label' => 'Assistant Multi',
        'route_mode' => 'multi_agent',
        'agent_ids' => ['assistant_test_agent', 'assistant_test_agent_two'],
        'thread_storage' => 'session',
        'thread_ttl' => 0,
        'allowed_roles' => [],
        'status_events' => FALSE,
      ],
      'assistant_approval' => [
        'label' => 'Assistant Approval',
        'route_mode' => 'single_agent',
        'agent_id' => 'assistant_approval_agent',
        'thread_storage' => 'session',
        'thread_ttl' => 0,
        'allowed_roles' => [],
        'status_events' => FALSE,
      ],
      'assistant_site_builder_multi' => [
        'label' => 'Assistant Site Builder Multi',
        'route_mode' => 'multi_agent',
        'agent_ids' => ['taxonomy_agent', 'content_type_agent', 'field_agent'],
        'thread_storage' => 'session',
        'thread_ttl' => 0,
        'allowed_roles' => [],
        'status_events' => FALSE,
      ],
      'assistant_content_type_edit' => [
        'label' => 'Assistant Content Type Edit',
        'route_mode' => 'multi_agent',
        'agent_ids' => ['content_type_agent'],
        'thread_storage' => 'session',
        'thread_ttl' => 0,
        'allowed_roles' => [],
        'status_events' => FALSE,
